---
/**
 * The site's layout.
 *
 * It does NOT reuse jmrp.io's navigation: that one links to root routes
 * (`/about`, `/blog`) that would 404 on this domain. Cross-site links are
 * absolute (`https://jmrp.io/...`).
 *
 * The visual language IS jmrp.io's, inherited from src/styles/tokens.css:
 * Space Grotesk for display, IBM Plex Sans for body, IBM Plex Mono for labels
 * and data, and the palette with its automatic light/dark theme.
 */
import "../styles/global.css";

import { Font } from "astro:assets";

import ServerMark from "../components/ServerMark.astro";
import { getServerCard } from "../data/server-cards";
import { servers } from "../data/servers";
import { LANGS } from "../i18n/config";
import { type Lang, ui } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import { buildDate } from "../lib/build-date";
import { safeIcon } from "../lib/card-icons";
import { humanDate } from "../lib/format";
import { buildSiteGraph, safeJsonLd } from "../lib/jsonld";
import {
  type Alternate,
  alternates,
  OG_IMAGE_SIZE,
  OG_LOCALES,
  ogImageAlt,
  ogImageUrl,
  type PageId,
  pageUrl,
  serverPageUrl,
  SITE_NAME,
} from "../lib/seo";

/**
 * `canonicalOverride` and `alternatesOverride` are required together: setting
 * one without the other would canonicalize a page to one URL while announcing
 * a different hreflang cluster for it. A union of "both" and "neither" makes
 * the invalid "just one" combination unrepresentable, instead of relying on a
 * doc comment a caller can silently violate.
 */
type CanonicalOverride =
  | { canonicalOverride: string; alternatesOverride: Alternate[] }
  | { canonicalOverride?: undefined; alternatesOverride?: undefined };

type Props = {
  title: string;
  description: string;
  /**
   * Keep this page out of search results.
   *
   * For pages that exist to be used by machinery rather than read: the OAuth
   * callback, which is a popup that closes itself. Without it, a page whose
   * only content is "signing you in…" would compete in the index with the
   * pages that matter.
   */
  noindex?: boolean;
  /** Which page this is, for the canonical URL and the hreflang cluster. */
  page?: PageId;
  /**
   * Server id for a per-server detail page (`/servers/<id>/`).
   *
   * `buildSiteGraph()` derives its `WebPage` `@id` from `pageUrl(lang, page)`
   * by default — one fixed URL per `PageId`. Every server's detail page
   * shares the same `page` value (`"servers"`, the index's), so without this
   * prop each one would assert the SAME `@id` (the `/servers/` index's) with
   * a DIFFERENT name/description — precisely the entity split `jsonld.ts`'s
   * own comments (see its `#source-code` node) exist to avoid elsewhere.
   * Passing `serverId` makes `buildSiteGraph` derive `url`/`@id` from
   * `serverPageUrl(lang, serverId)` instead, and — since this page IS where
   * that entity lives — emit its full `WebAPI`/`SoftwareApplication` and
   * `SoftwareSourceCode` nodes rather than the bare references every other
   * page uses. See `jsonld.ts`'s `PageMeta.serverId` doc for the rest.
   */
  serverId?: string;
  /**
   * Action-domain page under a server's card — forwarded verbatim to
   * `buildSiteGraph`. See `jsonld.ts`'s `PageMeta.actionsDomain` doc:
   * unlike `serverId`, it does NOT make this page the home of the server's
   * nodes; it only derives the page's own URL/breadcrumb/mainEntity.
   */
  actionsDomain?: { serverId: string; domain: string };
  /**
   * This page is an error body (the 404), not a real address.
   *
   * It suppresses every head element that claims an identity: canonical,
   * hreflang, Open Graph, Twitter and the JSON-LD graph — and it asks for
   * `noindex`.
   *
   * Why it matters: all of those are derived from `lang`, so the 404 was
   * emitting the HOME PAGE's identity. Its canonical pointed at `/`, and its
   * graph redefined `https://mcp.jmrp.io/#webpage` with `name: "Page not
   * found"` — the very entity-splitting hazard this codebase fights elsewhere
   * (see the `#source-code` comment in jsonld.ts): two documents describing one
   * `@id` with contradictory data, and a consumer merging them could end up
   * calling the home page "Page not found".
   */
  errorPage?: boolean;
} & CanonicalOverride;

const {
  title,
  description,
  page = "home",
  canonicalOverride,
  alternatesOverride,
  serverId,
  actionsDomain,
  errorPage = false,
  noindex = false,
} = Astro.props;
// The language comes from the URL, never from a prop: that is what lets the
// mirrored route files under `src/pages/es/` be identical to their English
// counterparts, and therefore impossible to drift apart.
const lang = getLangFromUrl(Astro.url);
// Moved up from further down the file (right before the old `t = ui[lang]`
// line) so `alternate` below can use it — nothing depended on the old order,
// it was just write-as-you-go.
const otherLang: Lang = lang === "en" ? "es" : "en";

// The same date as dateModified and the sitemap's lastmod: one single truth.
// Shared, memoized build timestamp — the same value the JSON-LD and
// <UpdatedLine> use. Calling `contentDate() ?? new Date()` here again
// re-read the clock on a dirty tree, so the footer could disagree with
// the date printed inside <main> by a few milliseconds.
const updated = buildDate();
const updatedHuman = humanDate(updated, lang);
// hreflang cluster for THIS page: `alternatesOverride` for a per-server
// detail page (see the prop doc above), `alternates(page)` for everything
// else. The <head> loop further down reads this SAME value, so the two can
// never drift apart.
const hreflangCluster = alternatesOverride ?? alternates(page);
// The visible language switch stays a site-relative path. It still derives
// from `hreflangCluster` (built from `pageUrl()`/`serverPageUrl()`, never a
// literal) so it can never drift from the canonical, but an absolute URL
// here would jump a dev or preview server straight to production.
const alternate = new URL(
  hreflangCluster.find((entry) => entry.hreflang === otherLang)?.href ??
    pageUrl(otherLang, page),
).pathname;
// Canonical, og:url and twitter:url are the SAME value on purpose: three
// separate declarations of where this page lives are three chances to
// contradict each other. `canonicalOverride` for a per-server detail page (see
// the prop doc above); `pageUrl()` for everything else.
const canonical = canonicalOverride ?? pageUrl(lang, page);
// Footer link to `/policies/`, site-relative for the same reason `alternate`
// is above. It is in the shared footer, not just on the home page, so every
// page — this one included — stays able to reach it.
const policiesHref = new URL(pageUrl(lang, "policies")).pathname;
// Footer link to `/license/`, for the same reason: the terms of reuse have to
// be reachable from every page, and jmrp.io keeps its license in the footer
// too rather than in the main navigation.
const licenseHref = new URL(pageUrl(lang, "license")).pathname;
const homeHref = new URL(pageUrl(lang, "home")).pathname;
// First-level path only, like jmrp.io: `~` on the home page, `~/inspector`
// elsewhere. `/servers/<id>/` pages ARE a real deeper slug now, but `page` is
// `"servers"` for those too (see ServerPage.astro), so the breadcrumb still
// reads `~/servers` on them — deliberately coarse, not a bug.
const breadcrumb = page === "home" ? "~" : `~/${page}`;
const ogImage = ogImageUrl(lang);
const imageAlt = ogImageAlt(lang);
const otherLocales = Object.entries(OG_LOCALES)
  .filter(([code]) => code !== lang)
  .map(([, locale]) => locale);
// The graph is serialized here, in the frontmatter, so `set:html` receives an
// already-escaped string. `buildSiteGraph` downloads jmrp.io's identity
// document from GitHub, with the committed snapshot as a fallback (see
// identity.ts).
// An error body describes no entity, so it builds no graph. Emitting one made
// the 404 redefine the home page's `@id` with a different name.
// `serverId` is passed straight through — see the prop doc above for why a
// per-server detail page cannot just be handed a different `page` value
// instead.
// A `noindex` page is not part of the site's entity graph either. The OAuth
// callback is the case: it borrows `page="inspector"` for its chrome, and if
// it emitted a graph it would assert the inspector's own `@id` from a second
// URL — the entity split every comment in `jsonld.ts` exists to prevent.
const jsonLd =
  errorPage || noindex
    ? undefined
    : safeJsonLd(
        await buildSiteGraph({
          lang,
          title,
          description,
          page,
          serverId,
          actionsDomain,
        }),
      );
const t = ui[lang];

// One nav item per page, in the CURRENT language, for both the desktop nav
// and the mobile drawer (they render from the same array, no JS involved).
// `NAV_LABELS` is typed over every `PageId`, so a new page cannot be added
// without a label; whether it appears in the menu is `NAV_ORDER`'s call
// below — `license` has a label and is deliberately not listed there. Every
// href is `pageUrl()` reduced to its pathname, the same site-relative pattern
// `alternate` and `policiesHref` already use above: an absolute URL here
// would send a dev/preview build straight to production.
const NAV_LABELS: Record<PageId, string> = {
  home: t.navHome,
  inspector: t.navInspector,
  internals: t.navInternals,
  license: t.navLicense,
  policies: t.navPolicies,
  servers: t.navServers,
};
/**
 * The menu's order, stated explicitly rather than `Object.keys(PAGE_PATHS)`'s.
 *
 * It matters more than it looks: on mobile the menu IS a vertical list, so this
 * order is the site's declared hierarchy. It runs what is here → try it → how
 * it works → the small print, and not alphabetically, which is what inheriting
 * the object's key order produced.
 *
 * `license` is left out on purpose: the terms of reuse belong in the footer,
 * next to Policies, where jmrp.io keeps its own — not in a five-item menu.
 */
const NAV_ORDER: PageId[] = [
  "home",
  "servers",
  "inspector",
  "internals",
  "policies",
];
const navItems = NAV_ORDER.map((id) => ({
  id,
  href: new URL(pageUrl(lang, id)).pathname,
  label: NAV_LABELS[id],
  current: id === page,
}));

/**
 * The servers, hanging off "Servers" in the menu.
 *
 * The icon comes from the card each server publishes — the same one its own
 * page uses — and travels as a `data:` URI inside it, so it adds no request. A
 * server without an icon simply does not draw one: the list does not depend on
 * it existing.
 */
const serverSubItems = servers.map((server) => ({
  href: new URL(serverPageUrl(lang, server.id)).pathname,
  name: server.name,
  icon: safeIcon(getServerCard(server.id)?.serverInfo?.icons)?.src,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    {
      /* Applies the forced theme override BEFORE first paint, so a visitor who
        picked "light" never sees a flash of the dark-first default while the
        rest of the document loads. `is:inline` is required, not stylistic:
        without it Vite pulls the block into a bundled module chunk, and the
        post-build's nonce injection (see the JSON-LD comment below) only
        patches `<script>` tags that are still literally inline in the HTML.
        `window.toggleTheme()` is the single source of truth the theme button
        script (end of <body>) calls into — kept this small on purpose, since
        this site has exactly one theme button and does not need the
        multi-instance class-based wiring jmrp.io's version carries for its
        header+drawer pair. No `astro:after-swap` handling either: this site
        has no ClientRouter, so every navigation is a fresh document load and
        this script simply runs again from scratch. */
    }
    <script is:inline>
      (function () {
        var KEY = "theme";
        function resolveTheme() {
          try {
            var saved = localStorage.getItem(KEY);
            if (saved === "light" || saved === "dark") return saved;
          } catch (e) {
            /* Storage disabled or unavailable: fall through to the OS preference. */
          }
          return window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
        }
        document.documentElement.dataset.theme = resolveTheme();
        window.toggleTheme = function () {
          var next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          try {
            localStorage.setItem(KEY, next);
          } catch (e) {
            /* No persistence available: the choice still applies this load. */
          }
          document.documentElement.dataset.theme = next;
          window.dispatchEvent(
            new CustomEvent("theme-changed", { detail: { theme: next } }),
          );
        };
      })();
    </script>

    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    {
      !errorPage && (
        <link
          rel="canonical"
          href={canonical}
        />
      )
    }
    {
      /* HTML link types `privacy-policy` and `terms-of-service`: how a user
        agent, a crawler or a directory finds the policy without guessing its
        path — the reason /policies/ did not need renaming to /privacy/. Both
        point at the same page because it carries privacy (data, logs) AND
        terms (no SLA, legal position). Neither is body-ok, so they live in
        <head>. `license` is the same idea for the terms of reuse, as
        jmrp.io's BaseHead emits it; all three site-relative like `canonical`
        is not, for the same reason as `alternate` above. Outside the
        `errorPage` guard: a 404 pointing at the policy is correct. */
    }
    <link
      rel="privacy-policy"
      href={policiesHref}
    />
    <link
      rel="terms-of-service"
      href={policiesHref}
    />
    <link
      rel="license"
      href={licenseHref}
    />

    {
      /* `max-snippet:-1` lifts the cap on how much text Google may quote, and
        it is the directive the whole play of this site rests on: its answers
        are marked up as FAQPage and speakable precisely so they get quoted in
        full. AI bots (GPTBot, ClaudeBot, PerplexityBot) do NOT read this —
        robots.txt is what governs them — but AI Overviews and Gemini
        grounding are served from Googlebot's index, which does honour it.
        Same value as jmrp.io's 126 pages: one policy for domain and
        subdomain. */
    }
    <meta
      name="robots"
      content={errorPage || noindex
        ? "noindex, follow"
        : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}
    />

    {
      /* The hreflang annotations are emitted IN FULL on both pages, each one
        including itself. Google requires every version to list every version —
        itself included — and discards the whole cluster when the self-reference
        is missing: EN and ES would then compete with each other instead of
        being grouped. They come from `alternates()` and not from a ternary so
        that adding a new language cannot leave the list short again. */
    }
    {
      !errorPage &&
        hreflangCluster.map((alt) => (
          <link
            rel="alternate"
            hreflang={alt.hreflang}
            href={alt.href}
          />
        ))
    }

    {
      /* The endpoint index in JSON, declared as an alternate representation of
        the document. It was only linked from the body, so an agent reading the
        `<head>` — which is what they do — never saw it. */
    }
    <link
      rel="alternate"
      type="application/json"
      href="/servers.json"
      title="MCP server index"
    />

    {
      /* Same reason as the `<link>` above, for `/llms.txt`: the design already
        assumed the home page pointed at both, but this one had never actually
        been added. */
    }
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="llms.txt index"
    />

    <meta
      name="color-scheme"
      content="light dark"
    />

    {
      /* An SVG icon, not .ico: the vhost answers 204 to /favicon.ico (it comes
        from the `empty_apple_icons.conf` include and its siblings) and that 204
        cannot be changed from here. An explicitly declared SVG is served. */
    }
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png"
      sizes="180x180"
    />

    {
      /* The social card. Without this block, a link shared on Bluesky,
        Mastodon, Slack or WhatsApp comes out as a bare URL: no title, no
        description, no image. `og:image` is ABSOLUTE because none of those
        clients resolves relative paths. */
    }
    {
      /* Not on the error body: `og:url` and `twitter:url` are the canonical,
         so a shared 404 link would have previewed as the home page. */
      !errorPage && (
        <>
          <meta
            property="og:type"
            content="website"
          />
          <meta
            property="og:url"
            content={canonical}
          />
          <meta
            property="og:title"
            content={title}
          />
          <meta
            property="og:description"
            content={description}
          />
          <meta
            property="og:site_name"
            content={SITE_NAME}
          />
          <meta
            property="og:locale"
            content={OG_LOCALES[lang]}
          />
          {otherLocales.map((locale) => (
            <meta
              property="og:locale:alternate"
              content={locale}
            />
          ))}
          <meta
            property="og:image"
            content={ogImage}
          />
          <meta
            property="og:image:type"
            content="image/png"
          />
          <meta
            property="og:image:width"
            content={String(OG_IMAGE_SIZE.width)}
          />
          <meta
            property="og:image:height"
            content={String(OG_IMAGE_SIZE.height)}
          />
          <meta
            property="og:image:alt"
            content={imageAlt}
          />

          {/* No twitter:site / twitter:creator here, and none is coming back:
              the author does not use the account (closed decision,
              2026-08-24). The rest of the namespace stays because it is not X
              that reads it — the block comment above names who does, and Slack
              and Discord use twitter:card to pick the large-image layout.
              site/creator are attribution-only: nothing renders worse without
              them. */}
          <meta
            name="twitter:card"
            content="summary_large_image"
          />
          <meta
            name="twitter:url"
            content={canonical}
          />
          <meta
            name="twitter:title"
            content={title}
          />
          <meta
            name="twitter:description"
            content={description}
          />
          <meta
            name="twitter:image"
            content={ogImage}
          />
          <meta
            name="twitter:image:alt"
            content={imageAlt}
          />
        </>
      )
    }

    {
      /* Structured data. `is:inline` is mandatory: without it Astro treats the
        block as a script of its own and moves it into a bundle module, which
        would make the JSON-LD disappear from the HTML.
        There is nothing to change in the CSP: `script-src` does not apply to an
        `ld+json` data block, and even so the post-build gives it the
        `nonce="NGINX_CSP_NONCE"` placeholder like any `script:not([src])`. */
    }
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={jsonLd}
        />
      )
    }

    {
      /* Without these <Font> tags Astro does NOT emit the --font-* variables,
        and since tokens.css defines --font-body as `var(--font-ibm-plex-sans),
        ...`, a non-existent var() invalidates the whole declaration: the
        browser ignores the entire fallback chain and drops to Times New Roman.
        Configuring `fonts:` in astro.config is not enough on its own. */
    }
    <Font
      cssVariable="--font-ibm-plex-sans"
      preload={[{ weight: "400", style: "normal" }]}
    />
    <Font
      cssVariable="--font-space-grotesk"
      preload={[{ weight: "700", style: "normal" }]}
    />
    <Font
      cssVariable="--font-ibm-plex-mono"
      preload={[{ weight: "500", style: "normal" }]}
    />
  </head>
  <body>
    {
      /* jmrp.io's ambient hairline grid (utilities.css, imported here already
        but never rendered until now), full-page: `position:absolute; inset:0`
        inside body's `position:relative`, sitting behind everything via
        `z-index:-1` in body's own stacking context (`isolation:isolate`,
        base.css). Same markup and placement as jmrp.io's BaseLayout.astro —
        first child of <body>, aria-hidden since it is purely decorative. */
    }
    <div
      class="lab-grid lab-grid--page"
      aria-hidden="true"
    >
    </div>

    <a
      class="skip"
      href="#main"
      >{t.skip}</a
    >

    <header class="site-header">
      {
        /* Checkbox-hack drawer toggle: the ONLY thing that opens/closes the
          mobile drawer is this checkbox's `:checked` state via `html:has()`
          in the `style` block below. Both the burger (`.menu-toggle`) and
          the scrim (`.menu-backdrop`) are plain `<label for="nav-open">`
          elements, so the drawer works with JavaScript fully disabled — the
          inline script at the end of <body> only layers on Escape-to-close,
          moving focus, and `inert` on the background. */
      }
      <input
        type="checkbox"
        id="nav-open"
        class="nav-open-cb sr-only"
        aria-controls="nav-drawer"
        aria-expanded="false"
      />

      <div class="header-bar">
        {
          /* Terminal-prompt mark, same anatomy as jmrp.io's Logo.astro:
            breadcrumb path + teal chevron + command + blinking cursor. It
            links to THIS site's home in the current language — it used to
            point at https://jmrp.io, which sent visitors off the site from
            every page. The visible wordmark is the accessible name, so no
            aria-label (it would not contain the visible breadcrumb text). */
        }
        <a
          class="brand"
          href={homeHref}
          rel="home"
        >
          <span class="brand-path">{breadcrumb}</span>
          <span class="brand-prompt">&#10095;</span>
          <span class="brand-name">mcp</span>
          <span
            class="brand-cursor"
            aria-hidden="true"
          ></span>
        </a>

        <nav
          class="site-nav"
          aria-label={t.mainNavLabel}
        >
          <ul class="nav-links">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current ? "page" : undefined}
                  >
                    {/* jmrp.io's breadcrumb cue on the active section: a
                        decorative "/" ahead of the label, hidden from AT
                        since aria-current already announces the state. */}
                    {item.current && (
                      <span
                        class="nav-prefix"
                        aria-hidden="true"
                      >
                        /
                      </span>
                    )}
                    {item.label}
                  </a>
                  {/* The servers hang off "Servers" without taking away its
                      link: the `<a>` above still leads to the index, and this
                      list only appears on hover or on keyboard entry
                      (`:focus-within`, which is what makes it reachable
                      without a mouse). Zero JavaScript. */}
                  {item.id === "servers" && serverSubItems.length > 0 && (
                    <ul class="nav-sub">
                      {serverSubItems.map((sub) => (
                        <li>
                          <a href={sub.href}>
                            {sub.icon && (
                              <ServerMark
                                src={sub.icon}
                                class="nav-sub-icon"
                              />
                            )}
                            {sub.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="header-controls">
          {
            /* Two-segment `EN | ES` pill, jmrp.io's LanguageSwitcher.astro
              design (`.lang-pill`/`.lang-seg`): the current locale is a
              non-interactive active segment, the other is a link. Rendered
              in FIXED `LANGS` order like the original — each label keeps
              its side and only the highlight moves; painting active-first
              made the TEXTS swap places on switch instead. Unlike
              jmrp.io's version, `alternate` is NOT a naive locale-prefix
              swap — it already comes from `pageUrl(otherLang, page)`, so
              from `/es/internals/` this goes to `/internals/`, never to the
              home page.

              No `hreflang` on the link on purpose: that annotation belongs
              to the `<link rel="alternate">` cluster in <head> (built from
              `alternates()`), which is already correct and complete. A
              second, body-level `hreflang=` would also leak onto the 404
              body — the one page that must emit no identity signals at all,
              since its `<head>` block is suppressed by `errorPage`. */
          }
          <div
            class="lang-switch"
            role="group"
            aria-label={t.langSwitchLabel}
          >
            {
              LANGS.map((code) =>
                code === lang ? (
                  <span
                    class="lang-seg lang-seg--active"
                    aria-current="true"
                  >
                    {code.toUpperCase()}
                  </span>
                ) : (
                  <a
                    class="lang-seg"
                    href={alternate}
                    lang={otherLang}
                    aria-label={`${t.switchTo} ${t.other}`}
                  >
                    {code.toUpperCase()}
                  </a>
                ),
              )
            }
          </div>

          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            data-theme-toggle
            aria-label={t.themeToggle}
            data-label-light={t.themeToLight}
            data-label-dark={t.themeToDark}
          >
            <span
              class="i-mdi:white-balance-sunny icon-sun"
              aria-hidden="true"
            ></span>
            <span
              class="i-mdi:moon-waning-crescent icon-moon"
              aria-hidden="true"
            ></span>
          </button>

          <a
            class="gh-link"
            href="https://jmrp.io"
            aria-label={t.authorSite}
          >
            <span
              class="i-mdi:account-circle-outline"
              aria-hidden="true"
            ></span>
          </a>

          <label
            for="nav-open"
            id="menu-toggle"
            class="menu-toggle"
          >
            <span class="sr-only">{t.menuOpen}</span>
            <span
              class="i-mdi:menu icon-menu-open"
              aria-hidden="true"
            ></span>
            <span
              class="i-mdi:close icon-menu-close"
              aria-hidden="true"
            ></span>
          </label>
        </div>
      </div>

      <label
        for="nav-open"
        class="menu-backdrop"
        aria-hidden="true"
      >
        <span class="sr-only">{t.menuClose}</span>
      </label>

      <div
        id="nav-drawer"
        class="nav-drawer"
        role="dialog"
        aria-modal="true"
        aria-label={t.menuDialogLabel}
        tabindex="-1"
      >
        <div class="drawer-head">
          {
            /* A `<label>` cannot take keyboard focus on its own, so it gets
              `tabindex` and a `button` role, and the script below makes Enter
              and Space activate it. Without a reachable close control inside
              an `aria-modal` dialog, a screen reader user on a phone — where
              there is no Escape key — has no announced way out. Clicking it
              still works with JavaScript disabled: it is a label, and the
              scrim behind it is another one. */
          }
          <label
            for="nav-open"
            class="drawer-close"
            role="button"
            tabindex="0"
          >
            <span class="sr-only">{t.menuClose}</span>
            <span
              class="i-mdi:close"
              aria-hidden="true"
            ></span>
          </label>
        </div>

        <div class="drawer-body">
          {
            /* The two servers lead, and they are not a sub-list any more.
              They were nested under "Servers", indented and set smaller —
              which put the only two things on this site with a visual
              identity of their own at the bottom of the hierarchy, drawn at
              16px. They are what people come here for, so they get the one
              piece of real estate in the panel: logo at a size where it
              identifies, name under it, a surface to tap.

              The pages below still list "Servers" in its nav order, so this
              is a shortcut rather than a reordering — nothing is only
              reachable from here. */
          }
          {
            serverSubItems.length > 0 && (
              <div class="drawer-servers">
                <p class="drawer-kicker">{NAV_LABELS.servers}</p>
                <div class="server-tiles">
                  {serverSubItems.map((sub) => (
                    <a
                      class="server-tile"
                      href={sub.href}
                      aria-current={
                        sub.href === Astro.url.pathname ? "page" : undefined
                      }
                    >
                      {sub.icon && (
                        <ServerMark
                          src={sub.icon}
                          class="server-tile-mark"
                        />
                      )}
                      <span class="server-tile-name">{sub.name}</span>
                    </a>
                  ))}
                </div>
              </div>
            )
          }

          <ul class="drawer-links">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.current ? "page" : undefined}
                  >
                    <span class="drawer-link-word">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        {
          /* The language pill also lives in the drawer panel, like jmrp.io's
            `.drawer__foot` (NavDrawer.astro) — requested explicitly: the
            header-bar pill stays visible on mobile too (same call jmrp.io
            makes for its own header + drawer pair), so this is a deliberate
            duplicate, not a replacement. Only the language pill is
            duplicated here, not the theme toggle: that one only asked for
            the language switcher, and the theme button already works fine
            from the bar behind the drawer. */
        }
        <div class="drawer-foot">
          <a
            class="drawer-away"
            href="https://jmrp.io"
          >
            {t.authorSite}
            <span
              class="i-mdi:arrow-top-right"
              aria-hidden="true"
            ></span>
          </a>
          <div
            class="lang-switch"
            role="group"
            aria-label={t.langSwitchLabel}
          >
            {
              LANGS.map((code) =>
                code === lang ? (
                  <span
                    class="lang-seg lang-seg--active"
                    aria-current="true"
                  >
                    {code.toUpperCase()}
                  </span>
                ) : (
                  <a
                    class="lang-seg"
                    href={alternate}
                    lang={otherLang}
                    aria-label={`${t.switchTo} ${t.other}`}
                  >
                    {code.toUpperCase()}
                  </a>
                ),
              )
            }
          </div>

          {
            /* The theme toggle, duplicated here like the language pill and for
              the same reason: opening the drawer puts the bar's buttons behind
              the panel, so on mobile there was no way to change theme with the
              menu open. The bar's own stays where it is; this is a second
              control for the same state, not a replacement. */
          }
          <button
            type="button"
            class="theme-toggle"
            data-theme-toggle
            aria-label={t.themeToggle}
            data-label-light={t.themeToLight}
            data-label-dark={t.themeToDark}
          >
            <span
              class="i-mdi:white-balance-sunny icon-sun"
              aria-hidden="true"
            ></span>
            <span
              class="i-mdi:moon-waning-crescent icon-moon"
              aria-hidden="true"
            ></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    {
      /* Identity and freshness, VISIBLE. They were complete in the JSON-LD and
        absent to a person: the audit called it "authority given away", and AI
        answers that quote visible text had nobody to attribute it to. The
        mailto also resolves security.txt existing without being linked from
        anywhere — the same reason `/policies/` goes here and not only on the
        home page: every page has to be able to reach it. */
    }
    <footer class="site-footer">
      <p class="footer-id">
        {t.footerBy}
        <a
          href="https://jmrp.io/about/"
          rel="author"
          >José Manuel Requena Plens</a
        >
        ·
        {t.footerUpdated}
        <time datetime={updated}>{updatedHuman}</time>
      </p>
      <p class="footer-links">
        <a href="https://jmrp.io">jmrp.io</a>
        <a href="mailto:mail@jmrp.io">mail@jmrp.io</a>
        <a
          href={policiesHref}
          rel="privacy-policy terms-of-service"
          >{t.footerPolicies}</a
        >
        <a
          href={licenseHref}
          rel="license"
          >{t.footerLicense}</a
        >
        <a href="/.well-known/security.txt">security.txt</a>
      </p>
    </footer>

    {
      /* Progressive enhancement only — see the two comments in the <header>
        above. `is:inline` for the same nonce reason as the theme-detection
        script in <head>: without it Vite would bundle this into an external
        module and the post-build's nonce patch would not apply to it. */
    }
    <script is:inline>
      (function () {
        // Theme button: reflect the live theme in aria-label and dispatch
        // the toggle. Every element carrying the hook, not one by id: since the
        // drawer got its own copy there are TWO, and with `getElementById` the
        // second one went mute — no label announcing the state and no reaction
        // to a click.
        var themeBtns = document.querySelectorAll("[data-theme-toggle]");
        if (themeBtns.length) {
          var updateThemeLabel = function () {
            var isDark = document.documentElement.dataset.theme !== "light";
            themeBtns.forEach(function (btn) {
              var label = btn.getAttribute(
                isDark ? "data-label-light" : "data-label-dark",
              );
              if (label) btn.setAttribute("aria-label", label);
            });
          };
          updateThemeLabel();
          themeBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
              if (typeof window.toggleTheme === "function") {
                window.toggleTheme();
              }
            });
          });
          window.addEventListener("theme-changed", updateThemeLabel);
        }

        // Mobile drawer a11y: the #nav-open checkbox already opens and
        // closes the drawer with zero JS (see the `style` block's
        // `html:has(#nav-open:checked)` rules). Everything here only adds
        // what CSS cannot do on its own: Escape-to-close, moving focus in
        // and out, and taking the background out of the tab order while
        // the drawer is open.
        var checkbox = document.getElementById("nav-open");
        var drawer = document.getElementById("nav-drawer");
        var main = document.getElementById("main");
        var footer = document.querySelector(".site-footer");
        // `.header-bar` holds the brand link, language pill, theme button
        // and the burger itself — all still tabbable and outside the
        // `aria-modal="true"` dialog. Without this, a keyboard user could
        // tab from inside the open drawer straight into those controls,
        // behind the scrim. `.menu-backdrop` (the scrim) and `#nav-drawer`
        // itself are siblings of `.header-bar`, not inside it, so they stay
        // interactive — that is how the scrim, the drawer's own close
        // control, and Escape keep working while the bar is inert.
        var headerBar = document.querySelector(".header-bar");
        if (!checkbox || !drawer) return;

        var setBackgroundInert = function (on) {
          if (main) main.inert = on;
          if (footer) footer.inert = on;
          if (headerBar) headerBar.inert = on;
        };

        checkbox.addEventListener("change", function () {
          checkbox.setAttribute(
            "aria-expanded",
            checkbox.checked ? "true" : "false",
          );
          setBackgroundInert(checkbox.checked);
          // Deferred two animation frames: activating a <label> also runs
          // the browser's OWN default action of focusing its associated
          // control (the checkbox), and on the very first interaction of
          // the page that default action is still in flight when a single
          // queued callback (a plain "change" listener, a setTimeout(0), or
          // one requestAnimationFrame) runs — so calling drawer.focus()
          // there gets silently overridden back to the checkbox a moment
          // later. Verified by hand with Playwright: 0 or 1 deferred frames
          // reproduce it on a fresh page load (a SECOND open/close cycle on
          // the same page does not, because by then a frame has already
          // rendered) — 2 frames closes the gap either way. This does not
          // affect the CSS itself: the drawer is already visually open by
          // the time this runs, `:has()` applied its style the instant the
          // checkbox's state changed.
          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              if (checkbox.checked) {
                drawer.focus({ preventScroll: true });
              } else {
                checkbox.focus({ preventScroll: true });
              }
            });
          });
        });

        // Enter/Space on the close label. A <label> with role="button" is
        // announced as a button, so it has to behave like one; the browser
        // only gives it the click behaviour, not the keyboard one.
        var closeLabel = drawer.querySelector(".drawer-close");
        if (closeLabel) {
          closeLabel.addEventListener("keydown", function (event) {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              checkbox.checked = false;
              checkbox.dispatchEvent(new Event("change"));
            }
          });
        }

        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape" && checkbox.checked) {
            checkbox.checked = false;
            // Firing "change" manually: setting `.checked` from script does
            // NOT dispatch the event on its own, and the listener above is
            // what runs the focus/inert cleanup.
            checkbox.dispatchEvent(new Event("change"));
          }
        });
      })();
    </script>
  </body>
</html>

<style>
  /* Top and bottom strips in mono, like jmrp.io's navigation.

     Sticky with the blur on ::before, NOT on .site-header directly: a
     `backdrop-filter` set on the header itself would make it the containing
     block for the drawer's `position: fixed`, breaking its off-screen
     `transform` and pulling it into the document's scroll width. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    border-bottom: 1px solid var(--color-hair);
  }

  .site-header::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    content: "";
    background: var(--color-bg-header);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .header-bar,
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4, 1rem);
    align-items: center;
    justify-content: space-between;

    /* width: 100% is mandatory: body is a column flex and `margin-inline: auto`
       on a flex child CANCELS the cross-axis stretch, shrinking the strip to
       its content's width instead of reaching --max-width-container. */
    width: 100%;
    max-width: var(--max-width-container);
    padding: 1rem var(--pad, 1.5rem);
    margin-inline: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* Fixed height like jmrp.io's header (--header-height/-mobile), instead of
     the shared rule's vertical padding: with the 44px icon controls below
     centered by `align-items: center`, this leaves ~10px of breathing room
     above/below on desktop (7px on the ≤40rem row) with no overflow. */
  .header-bar {
    height: var(--header-height);
    padding-block: 0;
  }

  @media (width <= 40rem) {
    .header-bar {
      height: var(--header-height-mobile);
    }
  }

  /* Ported from jmrp.io's Logo.astro. The old rule declared neither family
     nor size, so the mark inherited them and rendered at the wrong scale. */
  .brand {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    line-height: 1;
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .brand-path {
    color: var(--color-text-muted);
  }

  /* The collapsed bar drops the breadcrumb: a long segment (`~/internals`)
     would push the right-hand cluster off a 360px viewport. */
  @media (width <= 40rem) {
    .brand-path {
      display: none;
    }
  }

  .brand-prompt {
    margin-left: 0.5em;
    color: var(--teal);
  }

  .brand-name {
    margin-left: 0.5em;
    color: var(--color-text-heading);
  }

  .brand-cursor {
    align-self: flex-end;
    width: 0.6em;
    height: 0.12em;
    margin-bottom: 0.16em;
    margin-left: 0.12em;
    background: var(--color-accent);
    border-radius: 1px;
    animation: brand-blink 1.15s steps(1) infinite;
  }

  @keyframes brand-blink {
    0%,
    46% {
      opacity: 100%;
    }

    54%,
    100% {
      opacity: 0%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-cursor {
      animation: none;
    }
  }

  .brand:hover .brand-name {
    color: var(--color-accent);
  }

  /* ===== Desktop page nav — hidden below 40rem, replaced by the drawer === */

  /* ===== Servers submenu =====================================================
     Hangs off "Servers" without taking away its link: the parent element still
     leads to the index and this only opens on hover or on keyboard entry.
     `:focus-within` is what makes it reachable without a mouse — without it,
     tabbing through the menu would skip the servers entirely.

     Zero JavaScript, like the rest of the navigation. */
  .nav-links > li {
    position: relative;
  }

  .nav-sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: var(--z-header, 100);
    display: none;
    min-width: 12rem;
    padding: 0.35rem;
    margin: 0;
    list-style: none;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    box-shadow: var(--sh-pop);
  }

  .nav-links > li:hover > .nav-sub,
  .nav-links > li:focus-within > .nav-sub {
    display: block;
  }

  .nav-sub a {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .nav-sub-icon {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .nav-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 12px;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--color-text-heading);
    background-color: var(--color-surface-2);
  }

  .nav-links a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Active section: accent text, a "/" prefix, and a 2px amber underline —
     same treatment as jmrp.io's Header.astro. */
  .nav-links a[aria-current="page"] {
    color: var(--color-accent);
  }

  .nav-prefix {
    margin-right: 0.3em;
    color: var(--color-accent);
  }

  .nav-links a[aria-current="page"]::after {
    position: absolute;
    right: 12px;
    bottom: 2px;
    left: 12px;
    height: 2px;
    content: "";
    background: var(--color-accent);
    border-radius: 2px;
  }

  /* ===== Controls cluster: language, theme, GitHub, burger =============== */
  .header-controls {
    display: flex;
    gap: var(--space-sm);
    align-items: center;
  }

  /* Two-segment `EN | ES` pill — same design as jmrp.io's LanguageSwitcher
     component (`.lang-pill`/`.lang-seg`), ported verbatim. The pill itself
     is the chip chrome (surface + border); each segment is a flat inset
     button, with the active one picking up the accent-dim fill. */
  .lang-switch {
    display: inline-flex;
    align-items: center;
    padding: 2px;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    font-weight: var(--fw-medium);
    letter-spacing: 0.04em;
    background-color: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .lang-seg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    min-height: 40px;
    padding: 0.25rem 0.5rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: calc(var(--radius-md) - 3px);
    transition:
      color var(--dur-1) var(--ease-out),
      background-color var(--dur-1) var(--ease-out);
  }

  a.lang-seg:hover,
  a.lang-seg:focus-visible {
    color: var(--color-text-heading);
    background-color: var(--color-bg-subtle);
  }

  a.lang-seg:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* The active segment is a non-interactive <span>: accent text on an
     accent-dim fill, same as jmrp.io's `.lang-seg--active`. */
  .lang-seg--active {
    color: var(--color-accent);
    background-color: var(--accent-dim);
  }

  /* 44px is the project's minimum tap target for icon-only controls (see
     ThemeToggle/gh-link/menu-toggle below, and .drawer-close/.drawer-links a
     further down). */
  .theme-toggle,
  .gh-link,
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-size: var(--text-xl);
    color: var(--color-text);
    cursor: pointer;
    background: none;
    border: none;
    border-radius: var(--radius-sm);
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  /* GitHub link and burger get jmrp.io's `.gh-link`/`.drawer__close` hover:
     a filled chip (heading color + surface background) instead of a bare
     color swap. */
  .gh-link:hover,
  .gh-link:focus-visible,
  .menu-toggle:hover {
    color: var(--color-text-heading);
    background: var(--color-surface-2);
  }

  .theme-toggle:focus-visible,
  .gh-link:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* The burger toggle is a <label>, which cannot itself receive focus — the
     real focusable control is the sr-only checkbox it targets. Without this,
     a keyboard user tabbing to #nav-open gets no visible focus indicator at
     all (the default outline would land on a 1px clipped element). Same
     pattern as jmrp.io's `.nav-open-cb:focus-visible + nav .menu-toggle`,
     adapted to this site's `.header-bar` wrapper instead of a bare `<nav>`. */
  .nav-open-cb:focus-visible + .header-bar .menu-toggle {
    box-shadow: var(--focus-ring);
  }

  /* Sun/moon swap by data-theme. Dark is the default (no attribute), so the
     sun shows first — clicking it switches TO light. */
  .icon-moon {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-sun {
    display: none;
  }

  :global(html[data-theme="light"]) .icon-moon {
    display: block;
  }

  /* Burger: hidden here, shown only inside the ≤40rem query below. Icon swap
     (bars/close) follows the checkbox via :has() — zero JS. */
  .menu-toggle {
    display: none;
  }

  .icon-menu-close {
    display: none;
  }

  :global(html:has(#nav-open:checked)) .icon-menu-open {
    display: none;
  }

  :global(html:has(#nav-open:checked)) .icon-menu-close {
    display: block;
  }

  /* ===== Mobile drawer + scrim ============================================
     Open/close is the CSS checkbox hack: #nav-open is a hidden checkbox, the
     burger and the scrim are <label for="nav-open">, and every rule below
     that keys off `html:has(#nav-open:checked)` only takes effect inside the
     ≤40rem query — so the drawer cannot render "open" above that width even
     if the checkbox were somehow left checked (e.g. resizing the window
     past the breakpoint while it was open on a phone). `.nav-open-cb` is
     also hidden outright above 40rem, on top of that, matching jmrp.io's own
     defense against the same edge case. All of this works with JavaScript
     fully disabled; see the inline script at the end of <body> for the small
     amount of progressive enhancement layered on top (Escape, focus
     movement, `inert` on the background) and the report for what jmrp.io
     additionally does that this site deliberately leaves out (the Tab
     focus-trap, and the label→button swap for the close control). */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-backdrop);
    display: block;
    visibility: hidden;
    background: var(--scrim);
    opacity: 0%;
    transition:
      opacity var(--dur-3) var(--ease-out),
      visibility var(--dur-3) var(--ease-out);
  }

  /* Frosted panel: translucent surface + blur + a soft cast shadow toward
     the content, like jmrp.io's NavDrawer.astro (`--nd-shadow`) instead of a
     flat opaque fill. */
  .nav-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: var(--z-drawer);
    display: flex;
    visibility: hidden;
    flex-direction: column;
    width: var(--drawer-w);

    /* OPAQUE. It used to be 88% with a blur behind, and the page's text read
       through the panel: an overlaid menu you can see through does not read as
       a layer, it reads as dirt. jmrp.io's drawer — which is where this pattern
       comes from — is opaque. The blur stays for the border and the shadow,
       which do help lift it off. */
    background: var(--color-bg-secondary);
    border-inline-start: 1px solid var(--color-border);
    box-shadow: -30px 0 60px -30px rgb(0 0 0 / 55%);
