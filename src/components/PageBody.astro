---
/**
 * Cuerpo de la página, compartido por las dos versiones de idioma.
 *
 * Vive aquí y no duplicado en cada `index.astro` porque la única diferencia
 * entre EN y ES son las cadenas: duplicar el markup garantizaba que las dos
 * versiones se desincronizaran a la primera (ya pasó una vez con la línea de
 * cabeceras obligatorias, que faltaba en español).
 */
import { servers } from "../data/servers";
import { ui } from "../i18n/ui";
import { contentDate } from "../lib/build-date";
import { humanDate } from "../lib/format";
import Inspector from "./Inspector";
import ServerCard from "./ServerCard.astro";

interface Props {
  lang: "en" | "es";
}

const { lang } = Astro.props;
const t = ui[lang];
// Same date as the footer, dateModified and sitemap lastmod, through the
// shared helper. It is repeated here INSIDE <main> on purpose: readability
// prunes <footer>, so to an extractor the page came out undated.
const updated = contentDate() ?? new Date().toISOString();
---

<section class="hero">
  <p class="pill"><span class="dot" aria-hidden="true"></span>{servers.length} {t.pill}</p>
  <h1>{t.title}</h1>
  <p class="lede">{t.lede}</p>
  {/* La definición de MCP con la marca: el único bloque autocontenido para
      quien no sabe qué es esto, y el ancla de entidad que los titulares
      genéricos no dan. Ver `whatIsMcp` en ui.ts. */}
  <p class="what-is">{t.whatIsMcp}</p>
</section>

<section aria-labelledby="servers-h">
  {/* h2 y no p: eran rótulos decorativos y la página colgaba 734 palabras de
      dos únicos H2 (los nombres de las fichas). Como h2 dan outline real sin
      cambiar el aspecto — .eyebrow ya fija tamaño, peso y márgenes. */}
  <h2 class="eyebrow" id="servers-h">
    {t.serversEyebrow}
  </h2>
  <p class="section-intro">{t.serversIntro}</p>
  <div class="grid">
    {servers.map((s) => <ServerCard server={s} lang={lang} />)}
  </div>
  {/* A real <table>, not a styled grid, and built from `servers` rather than
      hand-written: adding a third MCP must not mean editing markup.
      It exists because the page had zero tables and this is the question that
      actually brings people to a hosted endpoint — "which of these two do I
      want?". AI Overviews lifts tables straight out of the page, and a
      two-item comparison is exactly the shape it takes. */}
  <table class="compare">
    <caption>{t.compareHead}</caption>
    <thead>
      <tr>
        <th scope="col">{t.compareAttribute}</th>
        {servers.map((s) => <th scope="col">{s.name}</th>)}
      </tr>
    </thead>
    <tbody>
      <tr>
        <th scope="row">{t.compareCredential}</th>
        {
          servers.map((s) => (
            <td>
              {s.requiredHeaders.length > 0
                ? s.requiredHeaders.map((h) => h.name).join(", ")
                : t.compareNoCredential}
            </td>
          ))
        }
      </tr>
      <tr>
        <th scope="row">{t.compareCovers}</th>
        {
          servers.map((s) => (
            <td>{s.id === "libgen" ? t.compareCoversLibgen : t.compareCoversGitlab}</td>
          ))
        }
      </tr>
      <tr>
        <th scope="row">{t.compareTools}</th>
        {servers.map((s) => <td>{s.tools.length}</td>)}
      </tr>
      <tr>
        <th scope="row">{t.compareEndpoint}</th>
        {
          servers.map((s) => (
            <td><code>{s.endpoint}</code></td>
          ))
        }
      </tr>
      <tr>
        <th scope="row">{t.compareTransport}</th>
        {servers.map(() => <td>{t.compareTransportValue}</td>)}
      </tr>
    </tbody>
  </table>

  <p class="machine">
    <a href="/servers.json"><code>/servers.json</code></a>
    <span>— {t.machineIndex}</span>
  </p>
</section>

<section aria-labelledby="inspector-h">
  <h2 class="eyebrow" id="inspector-h">
    {t.inspectorEyebrow}
  </h2>
  <p class="section-intro">{t.inspectorIntro}</p>
  <Inspector client:load servers={servers} lang={lang} />
  <p class="notice-pointer">
    {t.noticePointer}
  </p>
</section>

<section aria-labelledby="privacy-h">
  {/* Corta y sin plegar a propósito: un sitio que acepta credenciales debe
      decir qué registra sin pedir un clic. Cada afirmación es verificable:
      la CSP la aplica el navegador, la retención de logs es la de logrotate
      y las métricas se construyeron para descartar los argumentos. */}
  <h2 class="eyebrow" id="privacy-h">
    {t.privacyEyebrow}
  </h2>
  {t.privacyBody.map((paragraph) => <p class="privacy-text">{paragraph}</p>)}
  {/* Visible freshness INSIDE <main>. The footer carries the same date, but
      readability prunes <footer> and extraction pipelines saw an undated page
      (`byline: null`). Here it survives. */}
  <p class="updated-line">
    {t.updatedIn}{" "}
    <time datetime={updated}>{humanDate(updated, lang)}</time>
  </p>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 5.5rem) 3rem;
  }

  /* Píldora de estado con punto, igual que la de jmrp.io. Aquí dice algo
     verificable —cuántos servidores hay y qué transporte hablan— en vez de
     ser un adorno. */
  .pill {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0 0 1.5rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-success);
  }

  h1 {
    max-width: 18ch;
    margin: 0 0 1.25rem;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lede {
    max-width: 58ch;
    margin: 0;
    color: var(--color-text);
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  .what-is {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  /* Eyebrow with `//`: jmrp.io's section marker.
     The `//` is painted from CSS and does NOT exist in the DOM. It used to be
     a <span aria-hidden>, which handled screen readers but not extractors:
     `aria-hidden` has no effect on `textContent`, which is what readability
     and friends read, so headings came out as "//Servers", "//Inspector" and
     "//Privacy & data". With ::before the ornament leaves the extracted text
     and looks exactly the same. */
  .eyebrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    color: var(--color-accent);
    content: "//";
  }

  section {
    padding-block-end: 3.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }

  .machine {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .machine a {
    color: var(--color-accent);
    font-family: var(--font-mono);
    text-decoration: none;
  }

  .machine a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* El inspector es donde se pega el token, pero la política de ese token
     pertenece a gitlab y vive en su ficha. Este puntero une las dos cosas sin
     duplicar el texto ni mezclar los avisos de los dos servidores. */
  .privacy-text {
    max-width: 62ch;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  .notice-pointer {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  .section-intro {
    max-width: 62ch;
    margin: 0 0 1.5rem;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .updated-line {
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* Wide content scrolls inside its own container: the page body must never
     scroll horizontally on a phone. */
  .compare {
    display: block;
    max-width: 100%;
    margin: 1.75rem 0 0;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .compare caption {
    margin-bottom: 0.75rem;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    text-align: start;
  }

  .compare th,
  .compare td {
    padding: 0.5rem 0.9rem;
    border-bottom: 1px solid var(--color-hair);
    text-align: start;
    vertical-align: top;
  }

  .compare thead th {
    color: var(--color-text-heading);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .compare tbody th {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .compare td {
    color: var(--color-text);
    /* The reach cells are full sentences: they need to wrap even though the
       table as a whole is nowrap for the endpoint column. */
    white-space: normal;
  }

  .compare code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    overflow-wrap: anywhere;
  }
</style>
