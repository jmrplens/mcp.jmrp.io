---
/**
 * Visible freshness line, rendered INSIDE `<main>`.
 *
 * Extracted out of the page that first carried it (the home page's privacy
 * section) because every page of the site ends up needing the same three
 * lines: the same date, computed by `buildDate()` and formatted through
 * `humanDate()`, next to the same `updatedIn` string. A page that goes out
 * without this line goes out undated to extractors — `readability`, the
 * library behind most RAG pipelines, prunes `<footer>`, where the identical
 * date already lives — and that gap (`byline: null`) is a bug this site
 * already paid for once. One component is what stops a future page (the
 * inspector, internals) from reintroducing it by omission.
 */
import type { Lang } from "../i18n/config.ts";
import { ui } from "../i18n/ui";
import { buildDate } from "../lib/build-date";
import { humanDate } from "../lib/format";
import { pageDatesOf } from "../lib/sitemap-lastmod";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
// THIS page's date, the same value the graph publishes as `dateModified` and
// the sitemap as `lastmod`, from the one shared resolver.
//
// It used to read `buildDate()`, and the comment here claimed that was the
// same date as `dateModified` — true when both were site-wide, and false from
// the moment the dates became per-page. The line said "this page was last
// updated on <the day the site was last deployed>", under a label that says
// "this page". On a site whose argument is that its claims are checkable, a
// visible date meaning something other than what it says is the wrong one to
// leave approximate.
//
// `buildDate()` remains the fallback, which is what a dirty tree resolves to
// anyway: there the resolver deliberately answers nothing rather than invent
// a per-page date from a tree that matches no commit.
const pageDate = pageDatesOf(Astro.url.pathname).dateModified;
const updated = pageDate ?? buildDate();
---

<p class="updated-line">
  {t.updatedIn}{" "}
  <time datetime={updated}>{humanDate(updated, lang)}</time>
</p>

<style>
  .updated-line {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
