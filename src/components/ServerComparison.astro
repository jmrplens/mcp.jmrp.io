---
/**
 * The two servers side by side, on the home page.
 *
 * See `ServerComparison.md.ts` for why it exists and where the rows come
 * from: this component only lays out `comparisonRows()`. Styles mirror the
 * catalog table on the server page (`ServerPage.astro`), so the two tables on
 * the site read as one thing.
 */
import type { Lang } from "../i18n/config";
import { ui } from "../i18n/ui";
import { comparisonRows } from "./ServerComparison.md.ts";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const rows = comparisonRows(lang);
---

<div class="table-scroll">
  <table class="compare-table">
    <caption class="sr-only">{t.compareCaption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.compareServer}</th>
        <th scope="col">{t.compareCredential}</th>
        <th scope="col">{t.compareTools}</th>
        <th scope="col">{t.comparePrompts}</th>
        <th scope="col">{t.compareResources}</th>
        <th scope="col">{t.compareTemplates}</th>
        <th scope="col">{t.compareVersion}</th>
        <th scope="col">{t.comparePrice}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">
              <a href={row.href}>
                <code>{row.name}</code>
              </a>
            </th>
            {/* The credential cell carries the header name as code, the
                markdown twin the same in backticks; strip those here. */}
            <td class="text">
              {row.credential.includes("`") ? (
                <code>{row.credential.replaceAll("`", "")}</code>
              ) : (
                row.credential
              )}
            </td>
            <td>{row.tools}</td>
            <td>{row.prompts}</td>
            <td>{row.resources}</td>
            <td>{row.templates}</td>
            <td>{row.version}</td>
            <td>{row.price}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  /* Eight columns outgrow a phone; the table scrolls inside its own box so
     the page body never scrolls horizontally (same rule as the catalog table
     on the server page). */
  .table-scroll {
    margin: 0 0 1.25rem;
    overflow-x: auto;
  }

  .compare-table {
    width: 100%;
    font-size: var(--text-sm);
    border-collapse: collapse;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.45rem 0.7rem;
    white-space: nowrap;
    border-bottom: 1px solid var(--color-hair);
  }

  .compare-table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--fw-normal);
    color: var(--color-text-muted);
    text-align: right;
  }

  .compare-table thead th:first-child,
  .compare-table thead th:nth-child(2),
  .compare-table tbody th,
  .compare-table td.text {
    text-align: left;
  }

  .compare-table tbody th {
    font-weight: var(--fw-normal);
  }

  .compare-table code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .compare-table tbody th code {
    color: var(--color-accent);
  }

  /* Numeric cells right-aligned and tabular so the columns compare at a
     glance. */
  .compare-table td {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
