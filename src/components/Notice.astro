---
/**
 * A server notice's body. It lives inside a `<details>` whose `<summary>`
 * carries the title as an `<h4>` (dropped a level from `<h3>` when the server's
 * name in ServerCard.astro went from `<h2>` to `<h3>`), so only paragraphs and
 * bullets go here.
 *
 * It is a `<div>`, not an `<aside>`, and that matters more than it looks:
 * readability-style extractors — the pipeline feeding RAG and agents — treat
 * `<aside>` as complementary content and PRUNE it. With `<aside>`, 67% of the
 * page's text (limits, token policy, legal disclaimer) disappeared from the
 * extraction; measured, not assumed. And it was semantically wrong too: these
 * notices are not tangential, they are the card's central content.
 */
import type { McpNotice } from "../data/servers";
import type { Lang } from "../i18n/ui";

interface Props {
  notice: McpNotice;
  lang: Lang;
  /** An id so the inspector can reference it. */
  id?: string;
}

const { notice, lang, id } = Astro.props;
---

<div
  class="notice"
  id={id}
  data-testid={`notice-${notice.kind}`}
>
  {notice.body.map((p) => <p>{p[lang]}</p>)}
  {
    notice.bullets && notice.bullets.length > 0 && (
      <ul>
        {notice.bullets.map((b) => (
          <li>{b[lang]}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .notice {
    padding: 0.25rem 0 0;
  }

  /* This is the central content of the card (see the file comment above),
     not a caption, so it gets the site's normal body-text scale — 16px,
     the same `--text-md` jmrp.io uses for its own non-hero paragraphs
     (e.g. `.subtitle` in BlogIndex.astro) — instead of the smaller 14px it
     had before. */
  p {
    margin: 0 0 0.6rem;
    font-size: var(--text-md);
    color: var(--color-text);
    text-wrap: pretty;
  }

  p:last-of-type {
    margin-bottom: 0;
  }

  ul {
    padding-inline-start: 1.1rem;
    margin: 0.6rem 0 0;
    font-size: var(--text-md);
    color: var(--color-text);
  }

  li {
    margin-block-end: 0.3rem;
    text-wrap: pretty;
  }
</style>
