---
/**
 * El cuerpo de un aviso de servidor. Vive dentro de un `<details>` cuyo
 * `<summary>` lleva el título como `<h3>`, así que aquí solo van párrafos
 * y viñetas.
 *
 * Es un `<div>`, no un `<aside>`, y eso importa más de lo que parece: los
 * extractores tipo readability —el pipeline que alimenta RAG y agentes—
 * tratan `<aside>` como contenido complementario y lo PODAN. Con `<aside>`,
 * el 67% del texto de la página (límites, política del token, descargo
 * legal) desaparecía de la extracción; medido, no supuesto. Y semánticamente
 * también era incorrecto: estos avisos no son tangenciales, son el contenido
 * central de la ficha.
 */
import type { McpNotice } from "../data/servers";
import type { Lang } from "../i18n/ui";

interface Props {
  notice: McpNotice;
  lang: Lang;
  /** Id para poder referenciarlo desde el inspector. */
  id?: string;
}

const { notice, lang, id } = Astro.props;
---

<div class="notice" id={id} data-testid={`notice-${notice.kind}`}>
  {notice.body.map((p) => <p>{p[lang]}</p>)}
  {
    notice.bullets && notice.bullets.length > 0 && (
      <ul>
        {notice.bullets.map((b) => (
          <li>{b[lang]}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .notice {
    padding: 0.25rem 0 0;
  }

  p {
    margin: 0 0 0.6rem;
    color: var(--color-text);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  p:last-of-type {
    margin-bottom: 0;
  }

  ul {
    margin: 0.6rem 0 0;
    padding-inline-start: 1.1rem;
    color: var(--color-text);
    font-size: 0.875rem;
  }

  li {
    margin-block-end: 0.3rem;
    text-wrap: pretty;
  }
</style>
