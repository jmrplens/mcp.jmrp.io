---
/**
 * Un aviso que pertenece a UN servidor.
 *
 * Antes había un solo bloque suelto al final de la página con la política del
 * token, que solo aplica a gitlab. Con dos servidores ya obligaba al visitante
 * a averiguar cuál le afectaba, y con un tercero habría sido peor. Ahora cada
 * aviso vive dentro de la ficha de su servidor.
 *
 * `kind` decide el color del borde, no el contenido: seguridad en acento,
 * legal en neutro y límites en neutro atenuado.
 */
import type { McpNotice } from "../data/servers";
import type { Lang } from "../i18n/ui";

interface Props {
  notice: McpNotice;
  lang: Lang;
  /** Id para poder referenciarlo desde el inspector. */
  id?: string;
  /**
   * Servidor al que pertenece. Se añade al título porque dos servidores
   * pueden tener un aviso con el mismo nombre —"Límites y disponibilidad" lo
   * tienen los dos— y entonces quien navega por landmarks los oye idénticos.
   * De paso el título se auto-contiene, que es lo que hace citable un pasaje.
   */
  server?: string;
}

const { notice, lang, id, server } = Astro.props;
// El <aside> es un landmark: sin nombre accesible, un lector de pantalla
// anuncia "complementary" a secas y con dos avisos no se distinguen.
const headingId = `${id ?? notice.kind}-title`;
---

<aside
  class={`notice notice-${notice.kind}`}
  id={id}
  aria-labelledby={headingId}
  data-testid={`notice-${notice.kind}`}
>
  <h3 id={headingId}>
    {notice.title[lang]}{server ? <> — <code>{server}</code></> : null}
  </h3>
  {notice.body.map((p) => <p>{p[lang]}</p>)}
  {
    notice.bullets && notice.bullets.length > 0 && (
      <ul>
        {notice.bullets.map((b) => (
          <li>{b[lang]}</li>
        ))}
      </ul>
    )
  }
</aside>

<style>
  .notice {
    margin-block-start: 1rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-hair);
    border-inline-start: 3px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-subtle);
  }

  /* Solo el de seguridad lleva acento: es el único donde el visitante toma una
     decisión con consecuencias (pegar una credencial). */
  .notice-security {
    border-inline-start-color: var(--color-accent);
  }

  h3 code {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  h3 {
    margin: 0 0 0.6rem;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  p {
    margin: 0 0 0.6rem;
    color: var(--color-text);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  p:last-of-type {
    margin-bottom: 0;
  }

  ul {
    margin: 0.6rem 0 0;
    padding-inline-start: 1.1rem;
    color: var(--color-text);
    font-size: 0.875rem;
  }

  li {
    margin-block-end: 0.3rem;
    text-wrap: pretty;
  }
</style>
