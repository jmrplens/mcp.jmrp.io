---
/**
 * The logo each server declares on its card, legible in both themes.
 *
 * The problem it solves: those SVGs are drawn with `currentColor`, and inside
 * an `<img>` that inherits nothing — the image is an isolated document, so
 * `currentColor` falls back to its default, BLACK. In dark mode the logo was
 * invisible against the background, both in the servers submenu and in each
 * card's `<h1>`.
 *
 * The fix is to invert it when the theme is dark. It is correct precisely
 * because they are monochrome by construction: inverting black gives white and
 * there is no other colour to ruin.
 *
 * REJECTED, and worth writing down: using it as a `mask-image` with the page's
 * colour, which is what UnoCSS does with its icons. It does not survive the
 * post-build — the data-URI extractor rewrites the path ADDING quotes, which
 * inside the attribute end up escaped as `\22` and sit literally inside the
 * URL: a silent 404 and an element masked to nothing. It looks like "the icon
 * disappeared", without a single console error.
 */
interface Props {
  /** The icon's `src`, exactly as it comes from the card. */
  src: string;
  /** An extra class from the caller, for sizing. */
  class?: string;
}
const { src, class: extra } = Astro.props;
---

<img
  src={src}
  alt=""
  aria-hidden="true"
  class={["server-mark", extra].filter(Boolean).join(" ")}
  width="16"
  height="16"
/>

<style>
  .server-mark {
    display: inline-block;
    flex: none;
    width: 1em;
    height: 1em;

    /* The site is dark by default, so it inverts by default. The two rules
       below undo that in light mode, following the same pattern as
       `tokens.css`: the media query for the OS theme and the attribute for an
       explicit choice. */
    filter: invert(1);
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .server-mark {
      filter: none;
    }
  }

  :root[data-theme="light"] .server-mark {
    filter: none;
  }
</style>
