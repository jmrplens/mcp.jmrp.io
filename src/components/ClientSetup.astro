---
/**
 * A server's connection snippets for the usual MCP clients.
 *
 * It lives folded on the card (see ServerCard): it is the answer to "how do I
 * add this to my client?", which was the only question on the page whose
 * answer lived off the domain. The snippets come from
 * `src/lib/client-config.ts`, not from hand-written markup: a new MCP arrives
 * with its own.
 */
import type { McpServer } from "../data/servers";
import type { Lang } from "../i18n/ui";
import { ui } from "../i18n/ui";
import {
  claudeCodeCommand,
  claudeCodeOauthCommand,
  cursorJson,
  cursorOauthJson,
  vscodeJson,
  vscodeOauthJson,
} from "../lib/client-config";

interface Props {
  server: McpServer;
  lang: Lang;
}

const { server, lang } = Astro.props;
const t = ui[lang];

// Each block names its file because that is where the classic mistake is:
// Cursor reads `mcpServers`, VS Code reads `servers`.
//
// Two groups, and the order is not cosmetic: first the OAuth flow, which is
// what this deployment actually does and what saves anyone from handling a
// token; then the hand-pasted token, which is still the only way out for
// anything that cannot open a browser. A server without `oauth` (or without
// credentials, like libgen) shows only the second group, with no headings
// announcing a choice that does not exist.
const oauthBlocks = server.oauth
  ? [
      { label: "Claude Code", code: claudeCodeOauthCommand(server) },
      { label: "Cursor — ~/.cursor/mcp.json", code: cursorOauthJson(server) },
      { label: "VS Code — .vscode/mcp.json", code: vscodeOauthJson(server) },
    ].filter((block): block is { label: string; code: string } =>
      Boolean(block.code),
    )
  : [];

const tokenBlocks = [
  { label: "Claude Code", code: claudeCodeCommand(server) },
  { label: "Cursor — ~/.cursor/mcp.json", code: cursorJson(server) },
  { label: "VS Code — .vscode/mcp.json", code: vscodeJson(server, lang) },
];

const hasSecret = server.requiredHeaders.some((header) => header.secret);
---

<div class="client-setup">
  {
    oauthBlocks.length > 0 && (
      <>
        <h3 class="setup-head">{t.clientOauthHead}</h3>
        <p class="hint hint--lead">{t.clientOauthHint}</p>
        {oauthBlocks.map((block) => (
          <details class="snippet disclosure">
            <summary>{block.label}</summary>
            <div class="snippet-body">
              <button
                type="button"
                class="snippet-copy"
                data-copy
                data-copied={t.clientCopied}
              >
                {t.clientCopy}
              </button>
              {/* The tags stay on ONE line and Prettier is told to leave
                them there: everything between `<pre>` and `<code>` is
                CONTENT. The HTML parser drops a single newline right after
                `<pre>`, but not the indentation behind it, so the formatted
                version rendered every snippet with a sixteen-space first
                line and a blank last one. */}
              {/* prettier-ignore */}
              <pre><code>{block.code}</code></pre>
            </div>
          </details>
        ))}
        <h3 class="setup-head">{t.clientTokenHead}</h3>
        <p class="hint hint--lead">{t.clientTokenHint}</p>
      </>
    )
  }
  {
    tokenBlocks.map((block) => (
      <details class="snippet disclosure">
        <summary>{block.label}</summary>
        <div class="snippet-body">
          <button
            type="button"
            class="snippet-copy"
            data-copy
            data-copied={t.clientCopied}
          >
            {t.clientCopy}
          </button>
          {/* One line and unformatted, for the reason above. */}
          {/* prettier-ignore */}
          <pre><code>{block.code}</code></pre>
        </div>
      </details>
    ))
  }
  {hasSecret && <p class="hint">{t.clientEnvHint}</p>}
</div>

{
  /* Copy to clipboard. Delegated on `document` rather than a listener per
    button: the page renders six, and with delegation the cost is one.

    The page ALREADY ships JavaScript (the theme bootstrap, its toggle and
    Astro's island loader), so this starts no new exception — it follows the
    same pattern as the toggle, and the post-build gives it the CSP nonce.

    If the browser does not expose `navigator.clipboard` (an insecure context,
    or permission denied) the button neither disappears nor lies: it simply has
    no effect, and the text is still selectable by hand, which is how it was
    copied before this button existed. */
}
<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest("[data-copy]");
    if (!(button instanceof HTMLButtonElement)) return;
    const code = button.parentElement?.querySelector("code")?.textContent;
    if (!code || !navigator.clipboard) return;
    navigator.clipboard.writeText(code).then(() => {
      const previous = button.textContent;
      button.textContent = button.dataset.copied ?? previous;
      setTimeout(() => {
        button.textContent = previous;
      }, 1500);
    });
  });
</script>

<style>
  .client-setup {
    padding-top: 0.25rem;
  }

  .setup-head {
    margin: 1.1rem 0 0.35rem;
    font-size: 0.86rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text);
  }

  .setup-head:first-child {
    margin-top: 0;
  }

  .hint--lead {
    margin-top: 0;
    margin-bottom: 0.7rem;
  }

  /* Every snippet is folded and names its file: with two paths (OAuth and
     token) across three clients that is SIX blocks, and unfolded they turned
     the page's opening section into a wall of JSON. Folded, the section reads
     as prose with six labels and each reader opens their own. */
  .snippet {
    margin: 0 0 0.45rem;

    /* An OPAQUE surface, like jmrp.io's cards: with only a border, the
       background grid runs through the box and in light mode it stops reading
       as a surface. `--color-bg-subtle` will not do either — it is 5%
       translucent, so the grid shows through just the same. */
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
  }

  /* Colour, chevron and hover come from `.disclosure` (utilities.css). Only
     what is specific to this block lives here: the touch box and the monospace
     voice, because the label is a file name. */
  .snippet summary {
    padding: 0.45rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .snippet[open] summary {
    border-bottom: 1px solid var(--color-hair);
  }

  .snippet-body {
    position: relative;
  }

  /* Above the code, in its corner. `opacity` and not `display` so it stays
     reachable by keyboard: it appears on focus just the same. */
  .snippet-copy {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    padding: 0.15rem 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    cursor: pointer;
    background: var(--color-bg);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-sm);
    opacity: 0%;
    transition: opacity 0.12s ease;
  }

  .snippet-body:hover .snippet-copy,
  .snippet-copy:focus-visible {
    opacity: 100%;
  }

  /* Without a fine pointer (mobile, touch) there is no hover to reveal the
     button, so there it lives permanently visible. */
  @media (hover: none) {
    .snippet-copy {
      opacity: 100%;
    }
  }

  /* The block overflows horizontally WITHIN itself: the card lives in a grid
     with minmax(…, 1fr), and a <pre> with no overflow of its own widens the
     whole thing on mobile.

     But overflowing was all it did, and inside a 360px card that hid the end
     of every line: the commands are backslash-continued now, and the longest
     line left is still wider than the block. `pre-wrap` lets what does not
     fit fall to the next line instead of off the edge, and `anywhere` lets a
     single unbreakable token — a 64-character client id, a URL — break too.
     Nothing is lost by it: a soft wrap is not a character, so what the copy
     button puts on the clipboard is still the exact command, and its real
     line breaks are the backslashes. `overflow-x` stays as the floor for
     anything that still cannot wrap. */
  pre {
    padding: 0.6rem 0.75rem;
    margin: 0;
    overflow-x: auto;
    overflow-wrap: anywhere;
    white-space: pre-wrap;

    /* The PAGE background over the card's surface: that is what sets the code
       block apart from it without resorting to a translucency that would let
       the grid through. */
    background: var(--color-bg);
    border: 1px solid var(--color-hair);
    border-radius: 6px;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
  }

  .hint {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
</style>
