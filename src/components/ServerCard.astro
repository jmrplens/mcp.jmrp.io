---
/**
 * An MCP server's card. It feeds off `src/data/servers.ts`, which is the
 * single source of truth: registering a new MCP must not touch markup.
 */
import { getServerCard } from "../data/server-cards";
import type { McpServer } from "../data/servers";
import { ui } from "../i18n/ui";
import { safeIcon } from "../lib/card-icons";
import { pageUrl, serverPageUrl } from "../lib/seo";
import NoticeFolds from "./NoticeFolds.astro";

interface Props {
  server: McpServer;
  lang: "en" | "es";
}

const { server, lang } = Astro.props;
const t = ui[lang];
const needsAuth = server.requiredHeaders.length > 0;
// Site-relative, like every other cross-page link on this site: an absolute
// URL here would jump a dev or preview server straight to production.
const affinityHref = `${new URL(pageUrl(lang, "internals")).pathname}#affinity-h`;
// Counts come from the FULL SEP-1649 card, not `server.tools`/`server.prompts`
// above: those are the curated, hand-translated subset this card already
// shows inline, and gitlab's card alone has 37 prompts that never made it
// into that curated list (see `/servers/<id>/`'s own header comment). `card`
// can be absent for a server with no committed snapshot yet — the link below
// only renders when it exists, since `/servers/<id>/` itself would 404
// otherwise.
const card = getServerCard(server.id);
const serverPageHref = new URL(serverPageUrl(lang, server.id)).pathname;

// Optional, same as on `/servers/<id>/` (see that page's ServerPage.astro):
// most servers have no committed card yet, and even libgen's did not carry
// an icon before 1.6.4. The teaser repeats the SAME icon its own detail page
// shows so the two read as the same server at a glance, at near-zero cost —
// one tiny inlined `<img>` per card, not a new request (`data:` URI).
const serverIcon = card ? safeIcon(card.serverInfo.icons) : undefined;
---

{
  /* The `id` is the ONLY per-server linkable destination the site has: without
    it there is no way to point at "gitlab's MCP" from outside, and the
    `#gitlab` people would write by hand led nowhere. It comes from
    `server.id`, the same stable identifier `/servers.json` and the inspector
    use. */
}
<article
  class="card"
  id={server.id}
>
  <header class="card-head">
    <h3>
      {
        serverIcon && (
          <img
            src={serverIcon.src}
            alt=""
            aria-hidden="true"
            class="card-icon"
          />
        )
      }
      {server.name}
    </h3>
    <span class={needsAuth ? "badge badge-auth" : "badge"}>
      {needsAuth ? t.credentialsRequired : t.noCredentials}
    </span>
  </header>

  <p class="card-desc">{server.description[lang]}</p>

  {
    /* The `{" "}` here and in the two blocks below are separators for
      EXTRACTORS, not decoration. Without them `textContent` — what readability
      and RAG pipelines read — ran words together:
      "POSThttps://mcp.jmrp.io/libgen", "searchget_detailsreaddownload",
      "RepositoryDocumentation". An assistant quoting the tool list emitted a
      garbage token.
      They are invisible: all three containers are flex, and per the flexbox
      spec an anonymous item containing only white space is not rendered. */
  }
  <p class="endpoint">
    <span class="verb">POST</span>{" "}
    <code>{server.endpoint}</code>
  </p>

  {
    /* Live status, injected at the ORIGIN by /etc/nginx/lua/mcp_ssr_status.lua:
      nginx swaps this token for the running version and how many of the three
      instances answered, polled from their /health and cached 5 minutes.

      It is done server-side and not with client JavaScript precisely because
      the audience includes Googlebot, GPTBot and RAG pipelines, none of which
      run scripts. Same technique as jmrp.io's /homelab page.

      If the token reaches a browser unsubstituted, nginx is not applying the
      filter — in local `astro preview` that is expected, since the Lua hooks
      only exist in the production vhost. */
  }
  <p
    class="live-status"
    data-ssr={`mcp-${server.id}`}
  >
    <span
      class="live-dot"
      aria-hidden="true"
    ></span>
    {server.id === "libgen" ? "MCPSSR_LIBGEN_STATUS" : "MCPSSR_GITLAB_STATUS"}
  </p>

  {
    needsAuth && (
      <dl class="headers">
        {server.requiredHeaders.map((h) => (
          <>
            <dt>{h.name}</dt>
            <dd>{h.description[lang]}</dd>
          </>
        ))}
        {server.optionalHeaders.map((h) => (
          <>
            <dt class="optional">
              {h.name} <span>· {t.optionalHeaders}</span>
            </dt>
            <dd>{h.description[lang]}</dd>
          </>
        ))}
      </dl>
    )
  }

  {
    /* Replaces the old tools/prompts `<details>` folds: that content moved to
       its own page, `/servers/<id>/`, with a Server Card nearly complete
       (every tool, prompt, resource and resource template, each linking
       straight into the inspector) instead of a curated, sometimes-partial
       subset hidden behind a click with no URL of its own — see
       `.superpowers/sdd/servers-section-spec.md`. This card keeps only a
       pointer and the headline counts. */
    card && (
      <p class="server-card-link">
        <a href={serverPageHref}>{t.viewServerCard}</a>{" "}
        <span class="server-card-counts">
          ({card.tools.length} {t.toolsHead}
          {card.prompts.length > 0 &&
            `, ${card.prompts.length} ${t.promptsHead}`}
          )
        </span>
      </p>
    )
  }

  {
    /* The per-client configuration USED TO LIVE HERE, folded. It moved to the
      server's page (`ServerPage.astro`, the "Connect" section) once it grew two
      paths — OAuth and token — and tripled in size: inside a home-page card it
      hid the longest thing on the page behind a click, and with a third MCP in
      sight the home page stopped scaling. The card already carries a button to
      the detail page, which is where that question is answered in full. */
  }

  <NoticeFolds
    server={server}
    lang={lang}
  />

  <p class="links">
    <a href={server.repo}>
      <span
        class="link-icon i-simple-icons:github"
        aria-hidden="true"
      ></span>
      {t.repository}
    </a>{" "}
    <a href={server.docsSite ?? server.docs}>
      <span
        class="link-icon i-mdi:book-open-variant"
        aria-hidden="true"
      ></span>
      {t.documentation}
    </a>
  </p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 10px;
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }

  /* Was an `<h2>` sitting right under the section's own `<h2 class="eyebrow">`
     (HomePage.astro's "servers-h") — two h2s in a row, with the card title
     never nested under the section heading it belongs to. Demoted to `<h3>`
     (the fold labels below move from h3 to h4 to stay one level under this),
     which also makes it the site's one real, visible sub-heading — matching
     jmrp.io's own h2(eyebrow)-then-h3(real title) pattern for its featured
     project cards (`.proj-card__title`, HomePage.astro there): `--text-xl`
     (20px, not 24px) and `--fw-medium` (500, not 700) — jmrp's card titles
     are not bold, only the eyebrow-vs-title SIZE contrast carries the
     hierarchy. */
  h3 {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
    letter-spacing: -0.01em;
  }

  /* Same treatment as `/servers/<id>/`'s own icons (see ServerPage.astro's
     `.server-icon` comment for the full rationale): these ship as
     `currentColor` SVGs, but `currentColor` inside an `<img>`-loaded SVG
     does not follow this page's cascade, so it renders as a fixed color
     (black) regardless of theme. Dark is this site's default, so the
     override lives on the light case, not the dark one. */
  .card-icon {
    flex: none;
    width: 1em;
    height: 1em;
    filter: invert(1);
  }

  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme="dark"])) .card-icon {
      filter: none;
    }
  }

  :global(html[data-theme="light"]) .card-icon {
    filter: none;
  }

  /* The first thing anyone needs to know about a public endpoint is whether it
     will ask them for credentials. Hence at the top, not buried in the body. */
  .badge {
    padding: 0.2rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    border: 1px solid var(--color-hair);
    border-radius: 999px;
  }

  .badge-auth {
    color: var(--color-accent);
    background: var(--accent-dim);
    border-color: var(--accent-line);
  }

  .card-desc {
    margin: 0;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .endpoint {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }

  /* The method goes before the endpoint because a GET is rejected on these
     servers: showing the URL without the verb invites trying it in a browser. */
  .verb {
    padding: 0.15rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
    border-radius: 4px;
  }

  .live-status {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin: -0.35rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .live-dot {
    width: 0.4rem;
    height: 0.4rem;
    background: var(--color-success);
    border-radius: 50%;
  }

  .fold-intro {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Pointer to `/servers/<id>/`, replacing the old tools/prompts folds. Same
     hairline-topped rhythm as those folds had, so removing them does not
     leave an odd gap in the card's vertical spacing. */
  .server-card-link {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
    padding-top: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    border-top: 1px solid var(--color-hair);
  }

  /* Filled, not a link. This card is dense — endpoint, chips, counts, headers,
     a collapsed client config — and the one action that matters most (go read
     what this server actually does) was a text link with the same weight as
     everything around it. A solid block is the one thing on the card that
     cannot be mistaken for prose. */
  .server-card-link a {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    padding: 0.45rem 0.9rem;
    font-weight: var(--fw-semibold);
    color: var(--color-on-primary);
    text-decoration: none;
    background: var(--color-primary);
    border-radius: var(--radius-md);
  }

  .server-card-link a:hover {
    background: var(--color-primary-hover);
  }

  /* The ring, not an underline: on a filled control an underline reads as a
     link that lost its button. */
  .server-card-link a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* The arrow belongs to the button and says "this goes somewhere", so it is
     decorative: a screen reader already has the label. */
  .server-card-link a::after {
    font-weight: var(--fw-normal);
    content: "→";
  }

  .server-card-counts {
    color: var(--color-text-muted);
  }

  .endpoint code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-text-heading);
    overflow-wrap: anywhere;
  }

  .headers {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 0.85rem;
    padding-top: 0.9rem;
    margin: 0;
    font-size: 0.85rem;
    border-top: 1px solid var(--color-hair);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-heading);
  }

  dt.optional {
    color: var(--color-text-muted);
  }

  dt.optional span {
    font-size: 0.7rem;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    padding-top: 0.9rem;

    /* margin-top:auto pins the links to the bottom: the grid's cards share a
       height, and without this the shortest one left dead space. */
    margin: auto 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    border-top: 1px solid var(--color-hair);
  }

  .links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (width <= 40rem) {
    .headers {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    dd {
      margin-bottom: 0.5rem;
    }
  }
</style>
