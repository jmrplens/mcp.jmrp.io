---
/**
 * Ficha de un servidor MCP. Se alimenta de `src/data/servers.ts`, que es la
 * única fuente de verdad: dar de alta un MCP nuevo no debe tocar markup.
 */
import { getServerCard } from "../data/server-cards";
import type { McpServer } from "../data/servers";
import { ui } from "../i18n/ui";
import { pageUrl, serverPageUrl } from "../lib/seo";
import ClientSetup from "./ClientSetup.astro";
import Notice from "./Notice.astro";

interface Props {
  server: McpServer;
  lang: "en" | "es";
}

const { server, lang } = Astro.props;
const t = ui[lang];
const needsAuth = server.requiredHeaders.length > 0;
// Site-relative, like every other cross-page link on this site: an absolute
// URL here would jump a dev or preview server straight to production.
const affinityHref = `${new URL(pageUrl(lang, "internals")).pathname}#affinity-h`;
// Counts come from the FULL SEP-1649 card, not `server.tools`/`server.prompts`
// above: those are the curated, hand-translated subset this card already
// shows inline, and gitlab's card alone has 37 prompts that never made it
// into that curated list (see `/servers/<id>/`'s own header comment). `card`
// can be absent for a server with no committed snapshot yet — the link below
// only renders when it exists, since `/servers/<id>/` itself would 404
// otherwise.
const card = getServerCard(server.id);
const serverPageHref = new URL(serverPageUrl(lang, server.id)).pathname;
---

{/* El `id` es el ÚNICO destino enlazable por servidor que tiene el sitio: sin
    él no se puede apuntar a «el MCP de gitlab» desde fuera, y el `#gitlab` que
    la gente escribiría a mano no llevaba a ninguna parte. Sale de
    `server.id`, el mismo identificador estable que usan `/servers.json` y el
    inspector. */}
<article class="card" id={server.id}>
  <header class="card-head">
    <h3>{server.name}</h3>
    <span class={needsAuth ? "badge badge-auth" : "badge"}>
      {needsAuth ? t.credentialsRequired : t.noCredentials}
    </span>
  </header>

  <p class="card-desc">{server.description[lang]}</p>

  {/* The `{" "}` here and in the two blocks below are separators for
      EXTRACTORS, not decoration. Without them `textContent` — what readability
      and RAG pipelines read — ran words together:
      "POSThttps://mcp.jmrp.io/libgen", "searchget_detailsreaddownload",
      "RepositoryDocumentation". An assistant quoting the tool list emitted a
      garbage token.
      They are invisible: all three containers are flex, and per the flexbox
      spec an anonymous item containing only white space is not rendered. */}
  <p class="endpoint">
    <span class="verb">POST</span>{" "}
    <code>{server.endpoint}</code>
  </p>

  {/* Live status, injected at the ORIGIN by /etc/nginx/lua/mcp_ssr_status.lua:
      nginx swaps this token for the running version and how many of the three
      instances answered, polled from their /health and cached 5 minutes.

      It is done server-side and not with client JavaScript precisely because
      the audience includes Googlebot, GPTBot and RAG pipelines, none of which
      run scripts. Same technique as jmrp.io's /homelab page.

      If the token reaches a browser unsubstituted, nginx is not applying the
      filter — in local `astro preview` that is expected, since the Lua hooks
      only exist in the production vhost. */}
  <p class="live-status" data-ssr={`mcp-${server.id}`}>
    <span class="live-dot" aria-hidden="true"></span>
    {server.id === "libgen" ? "MCPSSR_LIBGEN_STATUS" : "MCPSSR_GITLAB_STATUS"}
  </p>

  {
    needsAuth && (
      <dl class="headers">
        {server.requiredHeaders.map((h) => (
          <>
            <dt>{h.name}</dt>
            <dd>{h.description[lang]}</dd>
          </>
        ))}
        {server.optionalHeaders.map((h) => (
          <>
            <dt class="optional">
              {h.name} <span>· {t.optionalHeaders}</span>
            </dt>
            <dd>{h.description[lang]}</dd>
          </>
        ))}
      </dl>
    )
  }

  {
    /* Replaces the old tools/prompts `<details>` folds: that content moved to
       its own page, `/servers/<id>/`, with a Server Card nearly complete
       (every tool, prompt, resource and resource template, each linking
       straight into the inspector) instead of a curated, sometimes-partial
       subset hidden behind a click with no URL of its own — see
       `.superpowers/sdd/servers-section-spec.md`. This card keeps only a
       pointer and the headline counts. */
    card && (
      <p class="server-card-link">
        <a href={serverPageHref}>{t.viewServerCard}</a>{" "}
        <span class="server-card-counts">
          ({card.tools.length} {t.toolsHead}
          {card.prompts.length > 0 && `, ${card.prompts.length} ${t.promptsHead}`})
        </span>
      </p>
    )
  }

  {/* La configuración por cliente, plegada como las tools: la pregunta que
      trae a la gente a un endpoint alojado, contestada en el dominio y no en
      el sitio de documentación de cada servidor. El título es un <h4> en
      forma de pregunta, como los avisos: es un ancla de extracción más. */}
  <details class="fold fold-client">
    <summary>
      <h4 class="fold-label">{t.clientHead.replace("{server}", () => server.name)}</h4>
    </summary>
    <ClientSetup server={server} lang={lang} />
  </details>

  {
    /* El aviso de seguridad llega ABIERTO: es donde el visitante decide si
       pega una credencial, y plegado quedaba visible la tranquilización
       ("nunca se almacena") con todas las cautelas escondidas tras el clic —
       el reparto exactamente al revés del correcto. Los demás sí se pliegan:
       el problema de scroll que motivó los plegables era real, solo estaba
       resuelto sobre el aviso equivocado.

       El título va en un <h4> DENTRO del summary (válido en HTML): sin él la
       página tenía 734 palabras colgando de dos H2, y los recuperadores
       trocean por encabezados — cada aviso pasa a ser un pasaje con ancla
       propia. */
    server.notices.map((notice) => (
      /* The id lives on the <details>, not on the notice body inside it, so
         that it wraps the QUESTION and its ANSWER. Two things depend on that:
         an `#gitlab-security` link now lands on the question rather than
         mid-answer, and `speakable` in the JSON-LD points at these same ids —
         with the id on the inner div, a read-aloud got the answer with no
         question attached. */
      /* Every notice starts collapsed, security ones included. They used to
         open by default so the caution sat next to the reassurance; the
         author asked for it closed. The content is unchanged and the anchor
         still lands on the question, so a link to `#gitlab-security` opens
         it. */
      <details
        class={`fold fold-${notice.kind}`}
        id={`${server.id}-${notice.kind}`}
      >
        <summary>
          <h4 class="fold-label">{notice.title[lang]}</h4>
        </summary>
        <Notice notice={notice} lang={lang} />
        {
          /* Only gitlab's security notice qualifies: it is the one that
             raises the token question, and `/internals/#affinity-h` is
             where the hashing it describes is shown in full, code included.
             libgen's affinity key is the IP address — no token, nothing to
             point at here. */
          server.id === "gitlab" && notice.kind === "security" && (
            <p class="notice-link">
              <a href={affinityHref}>{t.affinityLink}</a>
            </p>
          )
        }
      </details>
    ))
  }

  <p class="links">
    <a href={server.repo}>{t.repository}</a>{" "}
    <a href={server.docsSite ?? server.docs}>{t.documentation}</a>
  </p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg-secondary);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    justify-content: space-between;
  }

  /* Was an `<h2>` sitting right under the section's own `<h2 class="eyebrow">`
     (HomePage.astro's "servers-h") — two h2s in a row, with the card title
     never nested under the section heading it belongs to. Demoted to `<h3>`
     (the fold labels below move from h3 to h4 to stay one level under this),
     which also makes it the site's one real, visible sub-heading — matching
     jmrp.io's own h2(eyebrow)-then-h3(real title) pattern for its featured
     project cards (`.proj-card__title`, HomePage.astro there): `--text-xl`
     (20px, not 24px) and `--fw-medium` (500, not 700) — jmrp's card titles
     are not bold, only the eyebrow-vs-title SIZE contrast carries the
     hierarchy. */
  h3 {
    margin: 0;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
  }

  /* Lo primero que alguien necesita saber de un endpoint público es si le va
     a pedir credenciales. Por eso va arriba y no enterrado en el cuerpo. */
  .badge {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-hair);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .badge-auth {
    border-color: var(--accent-line);
    background: var(--accent-dim);
    color: var(--color-accent);
  }

  .card-desc {
    margin: 0;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .endpoint {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    margin: 0;
  }

  /* El método va delante del endpoint porque GET devuelve 405 en estos
     servidores: enseñar la URL sin el verbo invita a probarla en el navegador. */
  .verb {
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: var(--color-bg-subtle);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .live-status {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin: -0.35rem 0 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .live-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-success);
  }

  .fold-intro {
    margin: 0 0 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-wrap: pretty;
  }

  /* Pointer to `/servers/<id>/`, replacing the old tools/prompts folds. Same
     hairline-topped rhythm as those folds had, so removing them does not
     leave an odd gap in the card's vertical spacing. */
  .server-card-link {
    padding-top: 0.9rem;
    margin: 0;
    border-top: 1px solid var(--color-hair);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .server-card-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .server-card-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .server-card-counts {
    color: var(--color-text-muted);
  }

  .endpoint code {
    color: var(--color-text-heading);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .headers {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.35rem 0.85rem;
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-hair);
    font-size: 0.85rem;
  }

  dt {
    color: var(--color-text-heading);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  dt.optional {
    color: var(--color-text-muted);
  }

  dt.optional span {
    font-size: 0.7rem;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* Plegables nativos: cero JavaScript, accesibles por teclado de fábrica y
     —lo que importa aquí— el contenido sigue en el HTML, así que los
     rastreadores y los LLM lo leen igual aunque esté cerrado.

     Cada ficha medía ~1.400 px en móvil y el inspector quedaba a 4 pantallas;
     con cinco servidores habría estado a ocho. Lo que NO se pliega es lo
     citable: descripción, endpoint, cabeceras y los nombres de las tools. */
  .fold {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-hair);
  }

  .fold summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: baseline;
    cursor: pointer;
    /* Área táctil: sin esto el resumen se queda en ~19 px de alto. */
    padding-block: 0.35rem;
    list-style: none;
  }

  .fold summary::-webkit-details-marker {
    display: none;
  }

  /* Triángulo propio: el nativo no se puede colorear y desaparece en algunos
     navegadores al quitar list-style. */
  .fold summary::before {
    content: "›";
    display: inline-block;
    color: var(--color-accent);
    font-family: var(--font-mono);
    transition: transform 0.15s ease;
  }

  .fold[open] summary::before {
    transform: rotate(90deg);
  }

  .fold summary:hover .fold-label,
  .fold summary:focus-visible .fold-label {
    color: var(--color-accent);
  }

  .fold summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Vale para el <span> antiguo y para el <h4> actual (antes <h3>, movido un
     nivel abajo cuando el nombre del servidor pasó de <h2> a <h3> — ver la
     regla `h3` arriba): el heading llega con márgenes y tamaño de título de
     base.css y aquí se le da aspecto de etiqueta. Sigue siendo un encabezado
     para el outline y los extractores. */
  .fold-label {
    /* flex:1 con basis 0: el summary tiene flex-wrap, y el salto de línea se
       decide por la BASE del ítem (su max-content), no por el shrink — así
       que un título largo saltaba entero a la línea siguiente y dejaba el
       chevrón huérfano. Con basis 0 nunca salta: crece junto al chevrón y
       envuelve por dentro. */
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    /* Was 0.7rem, which left the question smaller than the answer under it —
       the heading of a passage cannot be the quietest thing in it. Matched to
       the notice body it opens (--text-md), not one step below. */
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .fold summary::before {
      transition: none;
    }
  }

  .fold dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem 0.85rem;
    margin: 0;
    font-size: 0.85rem;
  }

  .fold dt code {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  /* Trailing link inside the security notice, pointing at `/internals/`. */
  .notice-link {
    margin: 0.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .notice-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .notice-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    /* margin-top:auto pega los enlaces al fondo: las tarjetas de la rejilla
       tienen la misma altura y sin esto la más corta dejaba un hueco muerto. */
    margin: auto 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-hair);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .links a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (width <= 40rem) {
    .headers {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    dd {
      margin-bottom: 0.5rem;
    }
  }
</style>
