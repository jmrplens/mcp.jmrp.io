---
/**
 * Policies page — privacy, logging, availability, egress and the legal
 * position, all in one place.
 *
 * Split out of the home page for the same reason the inspector was (see
 * `InspectorPage.astro`): the home page's job is to say what these servers do
 * and let a visitor act on it cheaply, and a growing block of policy prose
 * was dead weight on the page search engines and assistants quote most. Only
 * "Privacy & data" used to live there; the rest of what is here (logging,
 * availability, egress, the legal position) had never been written down
 * anywhere on the site.
 */
import { ui } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl } from "../../lib/seo";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
// Site-relative, like every other cross-page link on this site: an absolute
// URL here would jump a dev or preview server straight to production.
const homeHref = new URL(pageUrl(lang, "home")).pathname;
// The credential notice lives on the gitlab card, on the home page — same
// anchor `InspectorPage.astro` links to for the same notice. Both pages
// raising the token question have to land on the one place that answers it,
// or the two answers drift.
const gitlabNoticeHref = `${homeHref}#gitlab-security`;
// The mechanism behind the egress section lives on /internals; this page
// keeps the consequence and points at the section that owns the rest.
const egressHref = `${new URL(pageUrl(lang, "internals")).pathname}#egress-h`;
// /license/ links back to `#legal-h`; this is the other direction.
const licenseHref = new URL(pageUrl(lang, "license")).pathname;
---

<div class="policies">
  <p class="back-link">
    <a href={homeHref}>{t.backToHome}</a>
  </p>

  {
    /* Kicker + h1 + intro + hairline, matching jmrp.io's PrivacyPage.astro
      `.privacy-header` — see the `.subpage-header` comment in base.css for
      why this page had none of it before. */
  }
  <header class="subpage-header">
    <p class="section-title">{t.policiesEyebrow}</p>
    <h1 class="subpage-title">{t.policiesTitle}</h1>
    <p class="subpage-intro">{t.policiesIntro}</p>
  </header>

  <section
    class="policies-section"
    aria-labelledby="privacy-h"
  >
    <h2
      class="subsection-title"
      id="privacy-h"
    >
      {t.privacyEyebrow}
    </h2>
    {t.privacyBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
    {
      /* The pointer the last `privacyBody` paragraph stops short of. It is NOT
        part of that array on purpose: the array is printed as plain text, so
        an `<a>` cannot live inside one of its strings — the reason the copy
        is split across two keys (see `policies.credentialNotice`). Same
        shape as `InspectorPage.astro`'s `noticePointer`, deliberately: two
        pages asking the same question have to land on the same answer. */
    }
    <p class="prose-text">
      {t.credentialNotice}{" "}
      <a href={gitlabNoticeHref}>{t.credentialNoticeLink}</a>
    </p>
  </section>

  <section
    class="policies-section"
    aria-labelledby="logs-h"
  >
    <h2
      class="subsection-title"
      id="logs-h"
    >
      {t.logsEyebrow}
    </h2>
    {t.logsBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
  </section>

  <section
    class="policies-section"
    aria-labelledby="sla-h"
  >
    <h2
      class="subsection-title"
      id="sla-h"
    >
      {t.slaEyebrow}
    </h2>
    {t.slaBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
  </section>

  <section
    class="policies-section"
    aria-labelledby="egress-h"
  >
    <h2
      class="subsection-title"
      id="egress-h"
    >
      {t.egressEyebrow}
    </h2>
    {t.egressBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
    {
      /* Same two-key shape as `credentialNotice` above: the prose used to end
        "are described under Internals" with nothing to click. */
    }
    <p class="prose-text">
      {t.egressPointer}{" "}
      <a href={egressHref}>{t.egressPointerLink}</a>
    </p>
  </section>

  <section
    class="policies-section"
    aria-labelledby="legal-h"
  >
    <h2
      class="subsection-title"
      id="legal-h"
    >
      {t.legalEyebrow}
    </h2>
    {t.legalBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
    {
      /* Where to write: the footer address, named here as the channel for
        takedown requests and questions, because `slaBody` says "no support
        channel" and a reader could take the footer's mailto for that. Then
        the cross-link to /license/, which links back to this section. */
    }
    <p class="prose-text">
      {t.legalContact}{" "}
      <a href="mailto:mail@jmrp.io">{t.legalContactLink}</a>
    </p>
    <p class="prose-text">
      {t.legalLicenseNote}{" "}
      <a href={licenseHref}>{t.legalLicenseLink}</a>
    </p>
  </section>

  {
    /* Visible freshness INSIDE <main>. See `UpdatedLine.astro` for why this
      cannot just live in the footer. */
  }
  <UpdatedLine lang={lang} />
</div>

<style>
  /* Heading size and the kicker+h1+intro shell now live in base.css's
     `.subpage-title`/`.subpage-header`/`.subpage-intro` — Inspector and
     Internals need the exact same shapes, so they stopped being per-page
     rules to copy. */

  /* Vertical rhythm for the page as a whole: jmrp.io's PrivacyPage.astro
     wraps its entire body in `.privacy { padding-top/-bottom: var(--space-xl) }`
     — `<main>` itself carries no vertical padding there, each page supplies
     its own. This page had none: content started flush against the header's
     bottom border. */
  .policies {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  /* Copied from InspectorPage.astro's / HomePage.astro's shared rules: Astro
     scopes \3c style> per component, so a class used on more than one page needs
     its own copy here. */
  .back-link {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* `.prose-text` itself lives in base.css, but the link INSIDE one does not:
     InternalsPage.astro carries this same pair scoped to itself, and the
     scoping is per component — without a copy here the one link in this
     page's prose falls back to the UA's default blue, which is the one color
     on the page nobody chose. */
  .prose-text a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .prose-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same spacing jmrp.io's `.privacy-section` uses: a LEADING margin on each
     section (not trailing padding on the section before it), so it compounds
     with `.subpage-header`'s own bottom margin/border instead of doubling up
     awkwardly with it. */
  .policies-section {
    max-width: var(--max-width-prose);
    margin-top: var(--space-lg-xl);
  }
</style>
