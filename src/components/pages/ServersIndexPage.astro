---
/**
 * `/servers/` — the index of every MCP server's detail page.
 *
 * Replaces the tools/prompts `<details>` folds that used to hang off each
 * home-page card (see `ServerCard.astro`): those hid real content behind a
 * click with no URL of its own. This page indexes the MCP servers, similar
 * to a post list, and each row links to that server's own page — see
 * `.superpowers/sdd/servers-section-spec.md`.
 */
import type { ServerCardDocument, ServerCardSummary } from "../../data/server-cards";
import { getServerCard, getServerCardDocument } from "../../data/server-cards";
import type { McpServer } from "../../data/servers";
import { servers } from "../../data/servers";
import { ui } from "../../i18n/ui";
import { serversPage } from "../../i18n/ui/servers-page";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl, serverPageUrl } from "../../lib/seo";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const sp = serversPage[lang];
const homeHref = new URL(pageUrl(lang, "home")).pathname;

interface ServerRow {
  server: McpServer;
  card: ServerCardSummary;
  doc: ServerCardDocument;
}

// Only servers that have published a Server Card get a row: `servers.ts`
// could in principle list one that has not shipped SEP-1649 support yet
// (see `McpServer.nativeCard`), and this page has nothing of its own to show
// for it. `flatMap` returning `[]`/`[row]` narrows `card`/`doc` to defined
// without a separate type-predicate filter.
const rows: ServerRow[] = servers.flatMap((server) => {
  const card = getServerCard(server.id);
  const doc = getServerCardDocument(server.id);
  return card && doc ? [{ server, card, doc }] : [];
});
---

<div class="servers-index">
  <p class="back-link">
    <a href={homeHref}>{t.backToHome}</a>
  </p>

  <header class="subpage-header">
    <p class="section-title">{sp.eyebrowIndex}</p>
    <h1 class="subpage-title">{sp.titleIndex}</h1>
    <p class="subpage-intro">{sp.ledeIndex}</p>
  </header>

  <ul class="server-list">
    {
      rows.map(({ server, card, doc }) => {
        const href = new URL(serverPageUrl(lang, server.id)).pathname;
        const templatesCount = doc.resourceTemplates.length;
        return (
          <li>
            <article class="server-row">
              <h2 class="server-row-title">
                <a href={href}>{server.name}</a>
              </h2>
              <p class="server-row-desc">{server.description[lang]}</p>
              <dl class="server-row-stats">
                <div>
                  <dt>{t.toolsHead}</dt>
                  <dd>{card.tools.length}</dd>
                </div>
                {card.prompts.length > 0 && (
                  <div>
                    <dt>{t.promptsHead}</dt>
                    <dd>{card.prompts.length}</dd>
                  </div>
                )}
                {card.resources.length > 0 && (
                  <div>
                    <dt>{sp.resourcesHead}</dt>
                    <dd>{card.resources.length}</dd>
                  </div>
                )}
                {templatesCount > 0 && (
                  <div>
                    <dt>{sp.templatesHead}</dt>
                    <dd>{templatesCount}</dd>
                  </div>
                )}
              </dl>
              <p class="server-row-cta">
                <a href={href}>{sp.indexEntryCta}</a>
              </p>
            </article>
          </li>
        );
      })
    }
  </ul>

  <UpdatedLine lang={lang} />
</div>

<style>
  .servers-index {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .back-link {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .server-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .server-row {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-bg-secondary);
  }

  .server-row-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--fw-medium);
  }

  .server-row-title a {
    color: var(--color-text-heading);
    text-decoration: none;
  }

  .server-row-title a:hover {
    color: var(--color-accent);
  }

  .server-row-desc {
    margin: 0.6rem 0 0;
    color: var(--color-text);
    font-size: var(--text-sm);
    text-wrap: pretty;
  }

  .server-row-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-hair);
  }

  .server-row-stats div {
    display: flex;
    flex-direction: column;
  }

  .server-row-stats dt {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .server-row-stats dd {
    margin: 0;
    color: var(--color-text-heading);
    font-family: var(--font-mono);
    font-size: var(--text-md);
  }

  /* `margin-top: auto` sticks the link to the bottom of the (equal-height)
     grid card, same trick as ServerCard.astro's `.links`. */
  .server-row-cta {
    margin: auto 0 0;
    padding-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .server-row-cta a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .server-row-cta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
