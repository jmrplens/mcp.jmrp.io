---
/**
 * Home page — the canonical entry point.
 *
 * Keeps what makes the site citable: the MCP definition with the brand in the
 * first extractable sentence, the comparison table, and both server cards WITH
 * their notices (the FAQPage and speakable nodes hang off these). The
 * inspector and the policies page live on their own pages now.
 *
 * Used to delegate to `PageBody.astro`, kept as a separate file because the
 * mirrored `src/pages/es/` route needed the SAME markup with different
 * strings. That reason no longer applies: the language now comes from the
 * URL (`getLangFromUrl`), not a prop, so the split bought nothing but an extra
 * file to open — this component was one `<PageBody lang={lang} />` line.
 * Content absorbed here in its own commit, separate from Task 6's actual
 * content change, so that diff reads as what it is.
 */
import { servers } from "../../data/servers";
import { ui } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl } from "../../lib/seo";
import ServerCard from "../ServerCard.astro";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
// Site-relative, like the language switch in Base.astro: an absolute URL
// here would jump a dev or preview server straight to production.
const inspectorHref = new URL(pageUrl(lang, "inspector")).pathname;
const internalsHref = new URL(pageUrl(lang, "internals")).pathname;
---

<section class="hero">
  <p class="pill">
    <span
      class="dot"
      aria-hidden="true"
    ></span>{servers.length}
    {t.pill}
  </p>
  <h1 class="hero-title">{t.title}</h1>
  <p class="lede">{t.lede}</p>
  {
    /* The MCP definition with the brand in it: the only self-contained block
      for someone who does not know what this is, and the entity anchor that
      generic headlines do not provide. See `whatIsMcp` in ui.ts.

      The citation goes INSIDE this same paragraph, not in a block of its own:
      the claim ("an open standard") and its source have to travel in the same
      extractable chunk, or a retriever walks off with the definition and none
      of the backing. No `rel="nofollow"`, on purpose — it is the site's only
      external citation not written by the author himself, and marking it
      untrusted would contradict the reason it is here; none of this page's
      other outbound links carries a `rel` either. See `specLink` in ui.ts for
      why the href is the UNDATED `/specification`. */
  }
  <p class="what-is">
    {t.whatIsMcp}{" "}
    <a href="https://modelcontextprotocol.io/specification">{t.specLink}</a>.
  </p>
  {
    /* The old lede promised trying the servers "right here"; now that the
      inspector lives on its own page, that promise is a real link instead
      (Ruling R6 — see the comment on `home.tryInBrowser`). */
  }
  <p class="try-inspector">
    <a href={inspectorHref}>{t.tryInBrowser}</a>
  </p>
</section>

{
  /* The `/internals/` invitation, between the hero and the servers. It sat
    after the two server cards until the comparison table was removed and the
    measurement was taken again: even then it landed 2.46 screens down on a
    390px phone, which is past where most visitors stop. The question it
    answers — what happens to my request, and to my token — is one a reader
    has BEFORE pasting a credential into anything, so it now precedes the
    cards rather than following them. */
}
<aside class="internals-callout">
  <p class="internals-callout-eyebrow">{t.internalsEyebrow}</p>
  <p class="internals-callout-title">{t.internalsTitle}</p>
  <p class="internals-callout-lead">{t.internalsLead}</p>
  <p class="internals-callout-link">
    <a href={internalsHref}>{t.internalsLink}</a>
  </p>
</aside>

<section aria-labelledby="servers-h">
  {
    /* h2 and not p: they were decorative labels and the page hung 734 words
      off just two H2s (the cards' names). As h2 they give a real outline
      without changing the look — .eyebrow already sets size, weight and
      margins. */
  }
  <h2
    class="eyebrow"
    id="servers-h"
  >
    {t.serversEyebrow}
  </h2>
  <p class="section-intro">{t.serversIntro}</p>
  <div class="grid">
    {
      servers.map((s) => (
        <ServerCard
          server={s}
          lang={lang}
        />
      ))
    }
  </div>

  <p class="machine">
    <a href="/servers.json"><code>/servers.json</code></a>
    <span>— {t.machineIndex}</span>
  </p>
  {
    /* Same pointer pattern as `/servers.json` above, for the llmstxt.org
      index — see the `<link>` of the same name in Base.astro's <head>. */
  }
  <p class="machine">
    <a href="/llms.txt"><code>/llms.txt</code></a>
    <span>— {t.machineLlms}</span>
  </p>
</section>

{
  /* Visible freshness INSIDE <main>. It used to close the "Privacy & data"
    section that lived here; that section moved to its own page
    (`PoliciesPage.astro`), but the home page still needs its own dated line —
    see `UpdatedLine.astro` for why an undated page is a real problem, not a
    cosmetic one. */
}
<UpdatedLine lang={lang} />

<style>
  .hero {
    padding-block: clamp(3rem, 9vw, 5.5rem) 3rem;
  }

  /* A status pill with a dot, like jmrp.io's. Here it says something
     verifiable — how many servers there are and which transport they speak —
     instead of being an ornament.
     Measured against jmrp.io's `.hero__status` (HomePage.astro there): 13px
     (`--text-xs`, not a bare 0.75rem/12px — that size sits between two
     tokens and matches neither) and `--color-text` (full strength), not the
     muted color this had before. */
  .pill {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.35rem 0.8rem;
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-success);
    border-radius: 50%;
  }

  /* Size lives in base.css's `.hero-title` now (shared with the other
     pages' `.subpage-title`); nothing page-specific left to override here. */

  /* Same role as jmrp.io's `.hero__subtitle` (HomePage.astro there): the one
     line right under the h1. Same scale — 20px / 1.4 — so it reads with the
     same weight. */
  .lede {
    max-width: 58ch;
    margin: 0;
    font-size: var(--text-xl);
    line-height: 1.4;
    color: var(--color-text);
    text-wrap: pretty;
  }

  /* Same role as jmrp.io's `.hero__bio` first paragraph: real body copy, not
     a caption, so it gets `--color-text` (not muted) at the 16px/1.65 body
     scale — this sentence is the citability anchor (see `whatIsMcp` in
     ui.ts), not a footnote. */
  .what-is {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    font-size: var(--text-md);
    line-height: 1.65;
    color: var(--color-text);
    text-wrap: pretty;
  }

  /* The spec citation sitting inside that paragraph. Same treatment as
     `.machine a` below — accent, underlined only on hover — except it is body
     copy and not a mono pointer, so it keeps the paragraph's own font. */
  .what-is a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .what-is a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Eyebrow with `//`: jmrp.io's section marker.
     The `//` is painted from CSS and does NOT exist in the DOM. It used to be
     a <span aria-hidden>, which handled screen readers but not extractors:
     `aria-hidden` has no effect on `textContent`, which is what readability
     and friends read, so headings came out as "//Servers" and "//Privacy &
     data". With ::before the ornament leaves the extracted text and looks
     exactly the same.
     Numbers matched against jmrp.io's own `.section-title` (utilities.css,
     shared by both repos byte-for-byte): `--text-label` (12.5px, not the
     bare 0.75rem/12px this had), `--fw-medium` (500, not 600 — jmrp's
     eyebrows are not bold), 0.16em tracking (not 0.12em), and full
     `--color-accent` on the whole label — jmrp doesn't mute the text and
     accent only the "//"; the whole line is accent-colored. */
  .eyebrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }

  .eyebrow::before {
    color: var(--color-accent);
    content: "//";
  }

  section {
    padding-block-end: 3.5rem;
  }

  /* `.section-intro` now lives in base.css — Inspector had the exact same
     rule under its own copy. */

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }

  /* ===== Internals callout =====================================================
     Bordered block rather than another `.machine`-style one-liner: it is an
     invitation to a whole page, not a pointer to a file, and the two must
     not read as the same weight. The accent bar on the inline-start edge is
     the only decoration — it marks the block as an aside without needing a
     background fill, which at this position would compete with the server
     cards above it. */
  .internals-callout {
    padding: 1rem 1.1rem;
    margin: 2rem 0 1.5rem;
    border: 1px solid var(--color-border);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
  }

  .internals-callout-eyebrow {
    margin: 0 0 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .internals-callout-title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-text-heading);
  }

  .internals-callout-lead {
    max-width: 60ch;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .internals-callout-link {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .machine {
    margin: 1.25rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .machine a {
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-decoration: none;
  }

  .machine a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same look as `.machine`: a small mono pointer out of the hero, this one
     to the inspector's own page instead of a machine-readable file. */
  .try-inspector {
    margin: 0.9rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .try-inspector a {
    font-family: var(--font-mono);
    color: var(--color-accent);
    text-decoration: none;
  }

  .try-inspector a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
