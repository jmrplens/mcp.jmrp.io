---
/**
 * Inspector page — the interactive island that talks to the MCP servers from
 * the visitor's browser.
 *
 * Split out of the home page so the home page ships zero JavaScript: the URL
 * search engines crawl and assistants cite must not depend on a client-side
 * island being hydrated. See `home.tryInBrowser` for the link that sends
 * visitors here from the hero, and `common.lede` (Ruling R6) for why the
 * home page's promise stayed true without embedding this page in it.
 */
import { servers } from "../../data/servers";
import { ui } from "../../i18n/ui";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl, serverPageUrl } from "../../lib/seo";
import Inspector from "../Inspector";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
// Site-relative, like the language switch in Base.astro: an absolute URL
// here would jump a dev or preview server straight to production.
const homeHref = new URL(pageUrl(lang, "home")).pathname;
// The token notice lives on the gitlab card, on the home page.
const gitlabNoticeHref = `${homeHref}#gitlab-security`;

// Looked up by id, not as "the one with no required headers": the copy in
// both languages NAMES libgen. Tying the block to the id means that if libgen
// ever leaves `servers.ts` the block leaves with it, instead of silently
// retargeting at an endpoint that answers 401 to the very command a visitor
// without JavaScript was told to run.
const noscriptServer = servers.find((server) => server.id === "libgen");
// Site-relative for the same reason as `homeHref` above.
const noscriptServerHref = noscriptServer
  ? new URL(serverPageUrl(lang, noscriptServer.id)).pathname
  : "";
// `-X POST` is deliberately absent: `-d` already makes this a POST, and adding
// it is what breaks the command the day anything redirects the endpoint (curl
// replays POST on a 301 only when -X forced it). The single quotes around the
// body are load-bearing too — the JSON is full of double quotes, so shell
// double quotes here would hand `$`/`!` to the shell instead of to curl.
// What Astro puts in the HTML is NOT the raw byte: text expressions escape
// `'` to `&#39;` and `"` to `&quot;` (check the built page — both are in
// there). That costs nothing, and it is exactly why the quoting survives:
// those are standard character references, so every HTML parser decodes them
// before anyone reads or copies the block, and what comes out of the
// clipboard is what a shell would accept.
const noscriptCurl = noscriptServer
  ? String.raw`curl -sS ${noscriptServer.endpoint} \
  -H 'Content-Type: application/json' \
  -H 'Accept: application/json, text/event-stream' \
  -d '{"jsonrpc":"2.0","id":1,"method":"tools/list"}'`
  : "";
---

<div class="inspector">
  <p class="back-link">
    <a href={homeHref}>{t.backToHome}</a>
  </p>

  {
    /* Kicker + h1 + intro + hairline, matching jmrp.io's PrivacyPage.astro
      `.privacy-header` — see the `.subpage-header` comment in base.css. */
  }
  <header class="subpage-header">
    <p class="section-title">{t.inspectorEyebrow}</p>
    <h1
      id="inspector-h"
      class="subpage-title"
    >
      {t.inspectorTitle}
    </h1>
    <p class="subpage-intro">{t.inspectorIntro}</p>
  </header>

  <section
    class="inspector-section"
    aria-labelledby="inspector-h"
  >
    <Inspector
      client:load
      servers={servers}
      lang={lang}
    />

    {
      /* The only thing a crawler that runs no JavaScript can read on this page:
        the island above arrives as an empty shell. It sits inside the section
        it stands in for. Note for whoever styles it — Astro puts
        `data-astro-cid-*` on the CHILDREN of <noscript> but not on <noscript>
        itself, so a scoped `noscript { … }` rule matches nothing at all.
        Style the classes instead. */
    }
    {
      noscriptServer && (
        <noscript>
          <div class="ns-fallback">
            <h2 class="ns-title">{t.noscript.title}</h2>
            <p class="ns-body">{t.noscript.lead}</p>
            <figure class="ns-figure">
              <figcaption class="ns-caption">
                {t.noscript.requestLabel}
              </figcaption>
              {/* One line and unformatted: whitespace between `<pre>`
                and `<code>` is content, and it rendered as an indented
                first line. See ClientSetup.astro for the full note. */}
              {/* prettier-ignore */}
              <pre class="ns-pre"><code>{noscriptCurl}</code></pre>
            </figure>
            <p class="ns-body">{t.noscript.response}</p>
            <p class="ns-body">
              {t.noscript.more}{" "}
              <a href={noscriptServerHref}>{t.noscript.moreLink}</a>.
            </p>
          </div>
        </noscript>
      )
    }

    <p class="notice-pointer">
      {t.noticePointer}{" "}
      <a href={gitlabNoticeHref}>{t.noticePointerLink}</a>
    </p>
  </section>

  {
    /* Visible freshness INSIDE <main>. See `UpdatedLine.astro` for why this
      cannot just live in the footer. */
  }
  <UpdatedLine lang={lang} />
</div>

<style>
  /* Heading size and the kicker+h1+intro shell now live in base.css's
     `.subpage-title`/`.subpage-header`/`.subpage-intro` — Policies and
     Internals need the exact same shapes, so they stopped being per-page
     rules to copy. */

  /* Vertical rhythm for the page as a whole — see the same rule on
     PoliciesPage.astro's `.policies` for the full rationale (jmrp.io's
     `.privacy`/`.about`: `<main>` itself carries no vertical padding, each
     page supplies its own). */
  .inspector {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  /* Copied from HomePage.astro's shared rules: Astro scopes \3c style> per
     component, so a class used on both pages needs its own copy here. */
  .back-link {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same leading-margin rhythm as PoliciesPage.astro's `.policies-section`.
     No `max-width` here on purpose, unlike that page's prose sections: the
     Inspector island is a form/response tool, not running text, and wants
     the full column width `<main>` already gives it. */
  .inspector-section {
    margin-top: var(--space-lg-xl);
  }

  /* Reading text, so it takes the shared prose measure. The island above it
     keeps the full column on purpose — it is a form, not running text. */
  .notice-pointer {
    max-width: var(--max-width-prose);
    margin: 1rem 0 0;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  /* The <noscript> fallback. Copied shapes, not shared ones: Astro scopes
     \3c style> per component, so ClientSetup.astro's code-block rules cannot be
     reused here — the same reason `.back-link` above is a copy of the home
     page's. */
  .ns-fallback {
    max-width: var(--max-width-prose);
    margin-top: var(--space-lg-xl);
  }

  .ns-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .ns-body {
    margin: 0 0 1rem;
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .ns-body a {
    color: var(--color-accent);
  }

  .ns-figure {
    margin: 0 0 1rem;
  }

  .ns-caption {
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Same reason as ClientSetup.astro's <pre>: without its own overflow the
     block widens the whole column on a phone instead of scrolling inside
     itself. No tabindex — post-build's `processCodeBlocks` runs on cheerio,
     which cannot see in here, so a focusable <pre> would never get the
     `<section aria-label>` wrapper that pass adds everywhere else. */

  /* Wraps rather than hiding its tail — see the `pre` rule in
     ClientSetup.astro for the full reasoning; this is the same kind of block
     (a copyable command) in the same kind of narrow column. */
  .ns-pre {
    padding: 0.6rem 0.75rem;
    margin: 0;
    overflow-x: auto;
    overflow-wrap: anywhere;
    white-space: pre-wrap;

    /* A surface, not a tint: `--color-bg-subtle` is 5% translucent and this
       block sits on the page background, so the grid ran through it. */
    background: var(--color-bg-secondary);
    border: var(--border-hair);
    border-radius: var(--radius-sm);
  }

  .ns-pre code {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text);
  }
</style>
