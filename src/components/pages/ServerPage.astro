---
/**
 * One server's detail page (`/servers/<id>/`) — its Server Card, laid out for
 * reading and linking rather than as raw JSON: identity, then every tool,
 * prompt, resource and resource template it publishes, each one linking
 * straight into the inspector preconfigured to it. See
 * `.superpowers/sdd/servers-section-spec.md` for the full rationale.
 *
 * `inputSchema`/`outputSchema` are deliberately absent — `server-cards.ts`'s
 * curated `serverCards` already strips them (see that module's header
 * comment); the live inspector is where a client inspects the real schema.
 *
 * Only `id` is a prop, like every other page component on this site — `lang`
 * comes from the URL, not a parameter, so the mirrored `src/pages/es/`
 * route stays byte-identical to its English counterpart.
 */
import type {
  CardPromptArgument,
  PromptSummary,
  ResourceSummary,
  ResourceTemplateSummary,
  ToolAnnotationsSummary,
  ToolSummary,
} from "../../data/server-cards";
import { getServerCard } from "../../data/server-cards";
import { servers } from "../../data/servers";
import {
  getDiscover,
  getGitlabActions,
  type SurfaceServerId,
} from "../../data/surface";
import { ui } from "../../i18n/ui";
import { serversPage } from "../../i18n/ui/servers-page";
import { getLangFromUrl } from "../../i18n/utils";
import { safeIcon } from "../../lib/card-icons";
import { pageUrl, serverPagePath } from "../../lib/seo";
import { anchorSlug } from "../../lib/slug";
import { schemaFields } from "../../lib/tool-schema";
import ActionSearch from "../ActionSearch";
import ClientSetup from "../ClientSetup.astro";
import ServerEntryChips from "../ServerEntryChips.astro";
import ServerMark from "../ServerMark.astro";
import ServerToc from "../ServerToc.astro";
import UpdatedLine from "../UpdatedLine.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = ui[lang];
const sp = serversPage[lang];

// Guaranteed to exist: the route's `getStaticPaths` only generates a path
// per id in `serverCards` (see `src/pages/servers/[server].astro`). Thrown,
// not asserted with `!`, so a future drift between that list and this lookup
// fails loudly at build time instead of silently typing past it.
const card = getServerCard(id);
if (!card) {
  throw new Error(
    `[servers] no server card for id "${id}" — getStaticPaths should have prevented this`,
  );
}
const serverMeta = servers.find((s) => s.id === id);
if (!serverMeta) {
  throw new Error(
    `[servers] "${id}" has a Server Card but no entry in src/data/servers.ts`,
  );
}

const serversHref = new URL(pageUrl(lang, "servers")).pathname;
const inspectorBase = new URL(pageUrl(lang, "inspector")).pathname;
// Targets of the service-context block below — site-relative, like every
// cross-page link here (an absolute URL sends a dev or preview server
// straight to production).
const internalsHref = new URL(pageUrl(lang, "internals")).pathname;
const policiesHref = new URL(pageUrl(lang, "policies")).pathname;
const inspectorOverviewHref = `${inspectorBase}?server=${id}`;

/**
 * Deep link into the inspector, preconfigured to one tool/prompt/resource.
 *
 * @param tab Which inspector tab holds this entry.
 * @param name The tool/prompt name, or — for a resource — its URI. Resource
 *   templates have no matching tab, so callers never pass one for them.
 * @returns Relative URL, same-origin — never absolute (see other pages'
 *   `Href` comments for why).
 */
function inspectorHref(
  tab: "tools" | "prompts" | "resources",
  name: string,
): string {
  return `${inspectorBase}?server=${id}&tab=${tab}&name=${encodeURIComponent(name)}`;
}

/** One entry, with its anchor id and chip label precomputed ONCE — the
 * article's `id` and the matching chip's `href` both read off this same
 * value, so the two can never drift apart. */
interface Entry<T> {
  id: string;
  label: string;
  data: T;
}

function toEntries<T extends { name: string }>(
  prefix: string,
  items: T[],
): Entry<T>[] {
  return items.map((item) => ({
    id: `${prefix}-${anchorSlug(item.name)}`,
    label: item.name,
    data: item,
  }));
}

const toolEntries: Entry<ToolSummary>[] = toEntries("tool", card.tools);
const promptEntries: Entry<PromptSummary>[] = toEntries("prompt", card.prompts);
// Resources key off their URI, not `name`: the SEP-1649 field guaranteed
// unique, and the same value the inspector deep link's `name` param carries
// for this family (see `servers-section-spec.md`'s "Deep-link al inspector").
const resourceEntries: Entry<ResourceSummary>[] = card.resources.map(
  (resource) => ({
    id: `resource-${anchorSlug(resource.uri)}`,
    label: resource.title ?? resource.name,
    data: resource,
  }),
);
const templateEntries: Entry<ResourceTemplateSummary>[] =
  card.resourceTemplates.map((tmpl) => ({
    id: `template-${anchorSlug(tmpl.uriTemplate)}`,
    label: tmpl.name,
    data: tmpl,
  }));

const hasPrompts = promptEntries.length > 0;
const hasResources = resourceEntries.length > 0;
const hasTemplates = templateEntries.length > 0;

// Above this many entries, the family gets a compact chip jump-index on top
// of its full list (gitlab's 37 prompts / 37 resource templates); below it,
// scrolling straight through the list is already fine (gitlab's 8
// resources, everyone's handful of tools) — see the spec's TOC section for
// why a chip grid exists at all.
const CHIP_THRESHOLD = 8;

// ---------------------------------------------------------------------------
// Surface snapshots — what the server itself says at runtime, captured per
// build by `scripts/sync-server-surface.mjs` and read through
// `src/data/surface.ts`. Absence DEGRADES on purpose: the loader returns
// `undefined` and the sections below simply do not render — see that
// module's header comment.
// ---------------------------------------------------------------------------

// `getDiscover` types its parameter against the servers that HAVE committed
// snapshots today; this page renders any server with a card. The cast is
// safe because absence is a supported input: an id without a snapshot file
// yields `undefined`, which is exactly the "section not rendered" path.
const discover = getDiscover(id as SurfaceServerId);
const instructions =
  discover?.instructions && discover.instructions.trim().length > 0
    ? discover.instructions
    : undefined;

// The action manifest is gitlab's alone (`gitlab://tools`); the id gate
// keeps a future server from painting gitlab's catalog on its own page.
const actions = id === "gitlab" ? getGitlabActions() : undefined;

// The snapshot orders domains alphabetically so a count change diffs as one
// line (see the extractor); the page re-orders for reading — biggest domain
// first, name as the tiebreaker.
const catalogRows = actions
  ? [...actions.domains].sort(
      (a, b) => b.count - a.count || a.domain.localeCompare(b.domain),
    )
  : [];
// The heading, the TOC and the table all cite `actionCount` — the same
// figure `/servers.json`, `/servers/<id>/actions.json` and the llms*.txt
// publish. The upstream `entryCount` is larger because the manifest also
// lists its visible tools as entries (`gitlab_find_action`, a navigation
// tool, not an action); those already render in the Tools section above,
// and their per-tool flags live in `meta.visibleTools` if ever needed here.

// The search island fetches the compact, credential-free index the static
// endpoint `/servers/<id>/actions.json` emits (see
// `src/pages/servers/[server]/actions.json.ts` — the route `/servers.json`
// and the llms*.txt announce). Same-origin, so it passes `connect-src
// 'self'`. That route exists exactly when the snapshot loads (its
// `getStaticPaths` filters on it), which is the same `actions` gate the
// island renders behind — derived from the id, never hardcoded.
const actionsIndexHref = `/servers/${id}/actions.json`;
// The localized prefix for the per-domain pages; the domain's name (manifest
// data) is concatenated as-is.
const actionsDomainBase = `${lang === "es" ? "/es/" : "/"}${serverPagePath(id)}actions/`;

// Subscriptions block + per-template "subscribable" chips, from the curated
// card summary (`capabilities`/`subscriptions` are verbatim card data — see
// `server-cards.ts`). Only gitlab publishes `subscriptions` today, but the
// section renders for any card that does.
const subs = card.subscriptions;
const subscribableCount = subs?.subscribable_uri_templates.length ?? 0;

const tocFamilies = [
  // OURS first, then what is read off the binary. `connect-h` opens the list
  // because it is the only section the visitor needs BEFORE they can use
  // anything that follows.
  { id: "connect-h", label: sp.connectHead },
  // No count: it is prose, not a family of entries — see `TocFamily.count`.
  { id: "context-h", label: sp.contextHead },
  // In DOM order: the page renders connect → context → overview. This entry
  // used to be special-cased inside ServerToc as a link to `#top`, which is
  // the page header — so "Overview" landed two sections above the Overview.
  { id: "overview-h", label: sp.overviewHead },
  ...(instructions
    ? [{ id: "instructions-h", label: sp.instructionsHead }]
    : []),
  { id: "tools-h", label: t.toolsHead, count: toolEntries.length },
  ...(actions
    ? [
        {
          id: "catalog-h",
          label: sp.catalogHead,
          count: actions.meta.actionCount,
        },
      ]
    : []),
  ...(hasPrompts
    ? [{ id: "prompts-h", label: t.promptsHead, count: promptEntries.length }]
    : []),
  ...(hasResources
    ? [
        {
          id: "resources-h",
          label: sp.resourcesHead,
          count: resourceEntries.length,
        },
      ]
    : []),
  ...(hasTemplates
    ? [
        {
          id: "templates-h",
          label: sp.templatesHead,
          count: templateEntries.length,
        },
      ]
    : []),
  ...(subs ? [{ id: "subscriptions-h", label: sp.subscriptionsHead }] : []),
];

const authText = card.authentication.required
  ? t.credentialsRequired
  : t.noCredentials;
const authSchemes = card.authentication.schemes;

/**
 * One card description, split into the paragraphs its author actually wrote.
 *
 * SEP-1649 descriptions are plain text, and a server that structures a long
 * one structures it with blank lines: libgen's `search` publishes four
 * paragraphs. Rendered into a single `<p>`, HTML collapses those breaks and
 * the whole thing arrives as one undifferentiated block — which is half of
 * the "wall of text" the 2026-08-24 audit measured on this page.
 *
 * Splits on blank lines and NOTHING else. Not on sentences, not on the
 * "x then y then z" fallback chains inside `download`'s 359-word paragraph:
 * this text is a verbatim pass-through of what the server publishes (see this
 * module's header comment), and choosing where a third party's prose breaks
 * is authoring it, not rendering it. That paragraph is fixed where it is
 * written — in `libgen-mcp` — not here; see `plan/PLAN-REMEDIACION-2026-08-24.md`.
 *
 * @param text The description exactly as the Server Card publishes it.
 * @returns One entry per paragraph, blank ones dropped.
 */
function descriptionParagraphs(text: string): string[] {
  return text
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

/**
 * A paragraph's lines, for rendering single line breaks as explicit `<br />`.
 *
 * The first version kept the raw `\n` inside the `<p>` and relied on
 * `white-space: pre-line` to honour them — correct against the source, and
 * useless against the BUILD: the post-build HTML minifier collapses
 * whitespace inside text nodes, so the served page carried zero line breaks
 * and pre-line had nothing left to preserve. The gitlab `instructions` block
 * (numbered steps separated by single `\n`) rendered as one run-on wall.
 * An explicit `<br />` is markup, not whitespace: the minifier keeps it.
 */
function paragraphLines(paragraph: string): string[] {
  return paragraph.split("\n").map((line) => line.trim());
}

/** True if an argument declares itself required — `arguments[].required` is
 * omitted (not sent as `false`) when optional, see `CardPromptArgument`. */
function isRequired(arg: CardPromptArgument): boolean {
  return arg.required === true;
}

// Everything below is OPTIONAL card data — every one of these can be
// `undefined`, and the markup below degrades to exactly today's page when it
// is. Like the rest of this component it all reads off the curated `card`:
// since the summary grew `resourceTemplates` (with its curated
// `subscribable` flag), nothing on this page needs the full document any
// more.
const serverIcon = safeIcon(card.serverInfo.icons);
// The card's own title, shown as a caption under the `<h1>` — never a second
// heading. Guards against a future card publishing a title identical to the
// plain id, which would just repeat the name.
const cardTitle =
  card.serverInfo.title && card.serverInfo.title !== serverMeta.name
    ? card.serverInfo.title
    : undefined;
const cardDescription = card.serverInfo.description;
const websiteUrl = card.serverInfo.websiteUrl;

/** One chip for one true behavioural hint, plus how it should be painted. */
interface AnnotationChip {
  label: string;
  /** `destructive` is the one hint that must visually stand out — see
   * `.a-chip--destructive` below. Every other hint is purely informative. */
  variant: "info" | "destructive";
}

/**
 * The behavioural chips for one tool, in the order the spec lists them:
 * read-only, destructive, idempotent, external network.
 *
 * Only hints the card sets to `true` get a chip — SEP-1649 leaves every hint
 * optional and non-`true` (absent or `false`) is "nothing declared", not
 * "declared safe": there is nothing worth asserting about a tool either way.
 * A tool whose card carries no `annotations` object at all gets no chips —
 * the author's decision for a server that has not published any yet. Both of
 * today's servers already do: gitlab's `gitlab_execute_action` is exactly
 * the destructive+external-network case this exists for.
 */
function toolAnnotationChips(
  annotations: ToolAnnotationsSummary | undefined,
): AnnotationChip[] {
  if (!annotations) {
    return [];
  }
  const chips: AnnotationChip[] = [];
  if (annotations.readOnlyHint) {
    chips.push({ label: sp.annotationReadOnly, variant: "info" });
  }
  if (annotations.destructiveHint) {
    chips.push({ label: sp.annotationDestructive, variant: "destructive" });
  }
  if (annotations.idempotentHint) {
    chips.push({ label: sp.annotationIdempotent, variant: "info" });
  }
  if (annotations.openWorldHint) {
    chips.push({ label: sp.annotationExternalNetwork, variant: "info" });
  }
  return chips;
}
---

<div class="server-page">
  <p class="back-link">
    <a href={serversHref}>{sp.backToServers}</a>
  </p>

  <header
    class="subpage-header"
    id="top"
  >
    <p class="section-title">{sp.eyebrowServer}</p>
    <h1 class="subpage-title">
      {
        serverIcon && (
          <ServerMark
            src={serverIcon.src}
            class="server-icon"
          />
        )
      }
      {serverMeta.name}
    </h1>
    {cardTitle && <p class="server-card-title">{cardTitle}</p>}
    <p class="subpage-intro">{serverMeta.description[lang]}</p>
  </header>

  <div class="server-layout">
    {
      /* Checkbox-hack toggle for the mobile TOC panel — same mechanism as the
        header's `#nav-open` in Base.astro (hidden checkbox + `:has()` +
        `<label>` scrim/FAB), scoped to this page instead of the whole site.
        Zero JavaScript: opening/closing works from mouse, touch AND
        keyboard (Tab lands on this checkbox since it is not `tabindex="-1"`,
        Space toggles it — the native behaviour every checkbox already has).
        No inline script layers anything on top here, unlike the nav drawer:
        the spec calls for these pages to ship no JS at all. */
    }
    <input
      type="checkbox"
      id="toc-open"
      class="toc-toggle-cb sr-only"
      aria-controls="toc-panel"
      aria-expanded="false"
    />

    <div class="server-content">
      {
        /* OUR content first, the binary's after: the page starts by answering
          "how do I connect this" and only then goes on to describe what the
          server declares about itself. The order used to be the reverse, and
          the answer was not even here — it lived folded inside a card on the
          home page. */
      }
      <section
        class="server-family"
        aria-labelledby="connect-title"
        id="connect-h"
      >
        <h2
          class="subsection-title"
          id="connect-title"
        >
          {sp.connectHead}
        </h2>
        <ClientSetup
          server={serverMeta}
          lang={lang}
        />
      </section>

      <section
        class="server-family"
        aria-labelledby="context-title"
        id="context-h"
      >
        <h2
          class="subsection-title"
          id="context-title"
        >
          {sp.contextHead}
        </h2>
        <p class="prose-text">{sp.contextService}</p>
        {
          /* The one sentence here that differs per server, so it comes from
            `servers.ts` and not from the i18n module. */
        }
        <p class="prose-text">{serverMeta.rateLimit[lang]}</p>
        <p class="prose-text">
          {sp.contextRouting}{" "}
          <a href={internalsHref}>{sp.contextRoutingLink}</a>
        </p>
        <p class="prose-text">
          {sp.contextPolicies}{" "}
          <a href={policiesHref}>{sp.contextPoliciesLink}</a>
        </p>
      </section>

      <section
        class="server-family"
        aria-labelledby="overview-title"
        id="overview-h"
      >
        <h2
          class="subsection-title"
          id="overview-title"
        >
          {sp.overviewHead}
        </h2>
        <dl class="meta-grid">
          <div>
            <dt>{sp.serverInfoLabel}</dt>
            <dd><code>{card.serverInfo.name}</code></dd>
          </div>
          <div>
            <dt>{sp.versionLabel}</dt>
            <dd><code>{card.serverInfo.version}</code></dd>
          </div>
          <div>
            <dt>{sp.endpointLabel}</dt>
            <dd><code>{serverMeta.endpoint}</code></dd>
          </div>
          <div>
            <dt>{sp.authLabel}</dt>
            <dd>
              {authText}
              {authSchemes.length > 0 && ` (${authSchemes.join(", ")})`}
            </dd>
          </div>
        </dl>
        {
          cardDescription && (
            <p class="card-own-description">
              <span class="card-own-description-label">
                {sp.cardDescriptionLabel}:
              </span>{" "}
              {cardDescription}
            </p>
          )
        }
        <p class="server-meta-links">
          <a href={inspectorOverviewHref}>
            <span
              class="link-icon i-mdi:console-line"
              aria-hidden="true"
            ></span>
            {sp.tryInInspector}
          </a>{" "}
          <a href={serverMeta.repo}>
            <span
              class="link-icon i-simple-icons:github"
              aria-hidden="true"
            ></span>
            {t.repository}
          </a>{" "}
          <a href={serverMeta.docsSite ?? serverMeta.docs}>
            <span
              class="link-icon i-mdi:book-open-variant"
              aria-hidden="true"
            ></span>
            {t.documentation}
          </a>
          {
            websiteUrl && (
              <>
                {" "}
                <a href={websiteUrl}>
                  <span
                    class="link-icon i-mdi:web"
                    aria-hidden="true"
                  />
                  {sp.websiteLabel}
                </a>
              </>
            )
          }
        </p>
      </section>

      {
        /* Service context, between the overview and the schemas — the four
          things the home page treats as non-negotiable about these endpoints
          (rate limit, no SLA, how many nodes, the legal position) and that
          this page carried none of. It goes HERE and not at the foot of the
          page because a card runs to 1,300 words of tools and prompts: after
          them, the caveats are read by nobody who did not already go looking.
          See `serversPage.contextHead` for why it links out instead of
          repeating `/policies/`. */
      }

      {
        /* The server's own connect-time instructions (`server/discover`),
          quoted verbatim from the committed surface snapshot — data, not
          chrome, so it is never translated (the Spanish intro flags it as English,
          same convention as `cardDescriptionLabel`). Placed after the
          service context — whose own comment defends its spot right behind
          the overview — and before the 1,300 words of tools, where whoever
          is configuring a client actually needs it. */
      }
      {
        instructions && (
          <section
            class="server-family"
            aria-labelledby="instructions-title"
            id="instructions-h"
          >
            <h2
              class="subsection-title"
              id="instructions-title"
            >
              {sp.instructionsHead}
            </h2>
            <p class="fold-intro">{sp.instructionsIntro}</p>
            <div class="card-own-description server-instructions">
              {descriptionParagraphs(instructions).map((paragraph) => (
                <p>
                  {paragraphLines(paragraph).map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
              ))}
            </div>
          </section>
        )
      }

      <section
        class="server-family"
        aria-labelledby="tools-title"
        id="tools-h"
      >
        <h2
          class="subsection-title"
          id="tools-title"
        >
          {t.toolsHead}
          <span class="count">({toolEntries.length})</span>
        </h2>
        {
          toolEntries.length > CHIP_THRESHOLD && (
            <ServerEntryChips
              entries={toolEntries}
              ariaLabel={`${sp.chipIndexLabel} — ${t.toolsHead}`}
            />
          )
        }
        <div class="entry-list">
          {
            toolEntries.map((entry) => {
              const icon = safeIcon(entry.data.icons);
              const chips = toolAnnotationChips(entry.data.annotations);
              return (
                <article
                  class="entry"
                  id={entry.id}
                >
                  <h3 class="entry-title">
                    {icon && (
                      <img
                        src={icon.src}
                        alt=""
                        aria-hidden="true"
                        class="entry-icon"
                      />
                    )}
                    {entry.data.title}
                  </h3>
                  <p class="entry-name">
                    <code>{entry.data.name}</code>
                  </p>
                  {chips.length > 0 && (
                    <ul
                      class="annotation-chips"
                      aria-label={sp.toolBehaviorLabel}
                    >
                      {chips.map((chip) => (
                        <li class={`chip a-chip--${chip.variant}`}>
                          {chip.label}
                        </li>
                      ))}
                    </ul>
                  )}
                  {descriptionParagraphs(entry.data.description).map(
                    (paragraph) => (
                      <p class="entry-desc">
                        {paragraphLines(paragraph).map((line, i) => (
                          <>
                            {i > 0 && <br />}
                            {line}
                          </>
                        ))}
                      </p>
                    ),
                  )}
                  {/* What to send. The same `schemaFields` the inspector uses
                      on the LIVE `tools/list`, run here over the card's
                      committed copy — one reader, so a field is described the
                      same way whichever page you meet it on. Collapsed, like
                      the return below it: a tool carries two lists where a
                      prompt carries one, and both open at once buried the
                      description they belong to. */}
                  {(() => {
                    const args = schemaFields(entry.data.inputSchema);
                    return args.length > 0 ? (
                      <details class="returns disclosure">
                        <summary>
                          {sp.toolArgsHead}{" "}
                          <span class="count">
                            ({args.length} {sp.toolFieldsToggle})
                          </span>
                        </summary>
                        <dl class="args">
                          {args.map((field) => (
                            <>
                              <dt>
                                <code>{field.name}</code>
                                {field.type && (
                                  <span class="arg-type"> {field.type}</span>
                                )}
                                {field.required && (
                                  <span class="req"> · {sp.requiredArg}</span>
                                )}
                              </dt>
                              <dd>{field.description}</dd>
                            </>
                          ))}
                        </dl>
                      </details>
                    ) : (
                      <p class="entry-desc entry-desc--muted">
                        {sp.toolNoArgs}
                      </p>
                    );
                  })()}
                  {/* What comes back, collapsed: `read` answers with 19 fields,
                      and what you need to CALL a tool is not what you need to
                      READ its answer. Zero JS — a plain <details>. */}
                  {(() => {
                    const out = schemaFields(entry.data.outputSchema);
                    return out.length > 0 ? (
                      <details class="returns disclosure">
                        <summary>
                          {sp.toolReturnsHead}{" "}
                          <span class="count">
                            ({out.length} {sp.toolFieldsToggle})
                          </span>
                        </summary>
                        <dl class="args">
                          {out.map((field) => (
                            <>
                              <dt>
                                <code>{field.name}</code>
                                {field.type && (
                                  <span class="arg-type"> {field.type}</span>
                                )}
                              </dt>
                              <dd>{field.description}</dd>
                            </>
                          ))}
                        </dl>
                      </details>
                    ) : null;
                  })()}
                  <p class="entry-cta">
                    <a href={inspectorHref("tools", entry.data.name)}>
                      {sp.tryInInspector}
                    </a>
                  </p>
                </article>
              );
            })
          }
        </div>
      </section>

      {
        /* gitlab's fine-grained action catalog (`gitlab://tools`), counted
          by domain from the committed snapshot. This section only ever
          consumes AGGREGATES (`meta` counts + per-domain rows) — never the
          upstream instance the manifest was read from, which the extractor's
          anti-leak guard keeps out of the snapshot in the first place. */
      }
      {
        actions && (
          <section
            class="server-family"
            aria-labelledby="catalog-title"
            id="catalog-h"
          >
            <h2
              class="subsection-title"
              id="catalog-title"
            >
              {sp.catalogHead}{" "}
              <span class="count">({actions.meta.actionCount})</span>
            </h2>
            <p class="fold-intro">{sp.catalogIntro}</p>
            {/* Always visible, never folded: every count below is only true
                for the token tier that asked (`cacheScope: "private"`). */}
            <p class="catalog-token-note">{sp.catalogTokenNote}</p>
            <div class="table-scroll">
              <table class="catalog-table">
                <caption class="sr-only">{sp.catalogTableCaption}</caption>
                <thead>
                  <tr>
                    <th scope="col">{sp.catalogColDomain}</th>
                    <th scope="col">{sp.catalogColTotal}</th>
                    <th scope="col">{sp.catalogColDestructive}</th>
                    <th scope="col">{sp.catalogColReadOnly}</th>
                  </tr>
                </thead>
                <tbody>
                  {catalogRows.map((row) => (
                    <tr>
                      <th scope="row">
                        {/* Each domain has its own reference page with the
                            full list (collapsed) and its own filter. */}
                        <a href={`${actionsDomainBase}${row.domain}/`}>
                          <code>{row.domain}</code>
                        </a>
                      </th>
                      <td>{row.count}</td>
                      <td>{row.destructiveCount}</td>
                      <td>{row.readOnlyCount}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <ActionSearch
              client:visible
              lang={lang}
              indexUrl={actionsIndexHref}
              domainPageBase={actionsDomainBase}
            />
          </section>
        )
      }

      {
        hasPrompts && (
          <section
            class="server-family"
            aria-labelledby="prompts-title"
            id="prompts-h"
          >
            <h2
              class="subsection-title"
              id="prompts-title"
            >
              {t.promptsHead}{" "}
              <span class="count">({promptEntries.length})</span>
            </h2>
            <p class="fold-intro">{t.promptsIntro}</p>
            {promptEntries.length > CHIP_THRESHOLD && (
              <ServerEntryChips
                entries={promptEntries}
                ariaLabel={`${sp.chipIndexLabel} — ${t.promptsHead}`}
              />
            )}
            <div class="entry-list">
              {promptEntries.map((entry) => {
                const icon = safeIcon(entry.data.icons);
                return (
                  <article
                    class="entry"
                    id={entry.id}
                  >
                    <h3 class="entry-title">
                      {icon && (
                        <img
                          src={icon.src}
                          alt=""
                          aria-hidden="true"
                          class="entry-icon"
                        />
                      )}
                      {entry.data.title}
                    </h3>
                    <p class="entry-name">
                      <code>{entry.data.name}</code>
                    </p>
                    {descriptionParagraphs(entry.data.description).map(
                      (paragraph) => (
                        <p class="entry-desc">
                          {paragraphLines(paragraph).map((line, i) => (
                            <>
                              {i > 0 && <br />}
                              {line}
                            </>
                          ))}
                        </p>
                      ),
                    )}
                    {entry.data.arguments.length > 0 ? (
                      <dl class="args">
                        {entry.data.arguments.map((arg) => (
                          <>
                            <dt>
                              <code>{arg.name}</code>
                              {isRequired(arg) && (
                                <span class="req"> · {sp.requiredArg}</span>
                              )}
                            </dt>
                            <dd>{arg.description}</dd>
                          </>
                        ))}
                      </dl>
                    ) : (
                      <p class="entry-desc entry-desc--muted">
                        {sp.noArguments}
                      </p>
                    )}
                    <p class="entry-cta">
                      <a href={inspectorHref("prompts", entry.data.name)}>
                        {sp.tryInInspector}
                      </a>
                    </p>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      {
        hasResources && (
          <section
            class="server-family"
            aria-labelledby="resources-title"
            id="resources-h"
          >
            <h2
              class="subsection-title"
              id="resources-title"
            >
              {sp.resourcesHead}{" "}
              <span class="count">({resourceEntries.length})</span>
            </h2>
            <div class="entry-list">
              {resourceEntries.map((entry) => {
                const icon = safeIcon(entry.data.icons);
                return (
                  <article
                    class="entry"
                    id={entry.id}
                  >
                    <h3 class="entry-title">
                      {icon && (
                        <img
                          src={icon.src}
                          alt=""
                          aria-hidden="true"
                          class="entry-icon"
                        />
                      )}
                      {entry.label}
                    </h3>
                    <p class="entry-name">
                      <code>{entry.data.uri}</code>
                    </p>
                    {descriptionParagraphs(entry.data.description).map(
                      (paragraph) => (
                        <p class="entry-desc">
                          {paragraphLines(paragraph).map((line, i) => (
                            <>
                              {i > 0 && <br />}
                              {line}
                            </>
                          ))}
                        </p>
                      ),
                    )}
                    {entry.data.mimeType && (
                      <p class="entry-meta">
                        {sp.mimeTypeLabel}: <code>{entry.data.mimeType}</code>
                      </p>
                    )}
                    <p class="entry-cta">
                      <a href={inspectorHref("resources", entry.data.uri)}>
                        {sp.tryInInspector}
                      </a>
                    </p>
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      {
        hasTemplates && (
          <section
            class="server-family"
            aria-labelledby="templates-title"
            id="templates-h"
          >
            <h2
              class="subsection-title"
              id="templates-title"
            >
              {sp.templatesHead}{" "}
              <span class="count">({templateEntries.length})</span>
            </h2>
            <p class="fold-intro">{sp.templatesIntro}</p>
            {templateEntries.length > CHIP_THRESHOLD && (
              <ServerEntryChips
                entries={templateEntries}
                ariaLabel={`${sp.chipIndexLabel} — ${sp.templatesHead}`}
              />
            )}
            <div class="entry-list">
              {templateEntries.map((entry) => {
                const icon = safeIcon(entry.data.icons);
                return (
                  <article
                    class="entry"
                    id={entry.id}
                  >
                    <h3 class="entry-title">
                      {icon && (
                        <img
                          src={icon.src}
                          alt=""
                          aria-hidden="true"
                          class="entry-icon"
                        />
                      )}
                      {entry.data.title}
                    </h3>
                    <p class="entry-name">
                      <code>{entry.data.uriTemplate}</code>
                    </p>
                    {entry.data.subscribable && (
                      <ul
                        class="annotation-chips"
                        aria-label={sp.toolBehaviorLabel}
                      >
                        <li class="chip a-chip--info">{sp.subscribableChip}</li>
                      </ul>
                    )}
                    {descriptionParagraphs(entry.data.description).map(
                      (paragraph) => (
                        <p class="entry-desc">
                          {paragraphLines(paragraph).map((line, i) => (
                            <>
                              {i > 0 && <br />}
                              {line}
                            </>
                          ))}
                        </p>
                      ),
                    )}
                    {entry.data.mimeType && (
                      <p class="entry-meta">
                        {sp.mimeTypeLabel}: <code>{entry.data.mimeType}</code>
                      </p>
                    )}
                  </article>
                );
              })}
            </div>
          </section>
        )
      }

      {
        /* Whether a client can subscribe instead of polling — the block that
          explains the "subscribable" chips on the templates above, so it
          sits right after them. Availability is read from the card, never
          hardcoded: on THIS deployment `subscriptions/listen` is up and
          `resources/subscribe` is not, but only the data says so. */
      }
      {
        subs && (
          <section
            class="server-family"
            aria-labelledby="subscriptions-title"
            id="subscriptions-h"
          >
            <h2
              class="subsection-title"
              id="subscriptions-title"
            >
              {sp.subscriptionsHead}
            </h2>
            <p class="fold-intro">{sp.subscriptionsIntro}</p>
            <dl class="meta-grid">
              {Object.entries(subs.methods).map(([methodName, method]) => (
                <div>
                  <dt>
                    <code>{methodName}</code>
                  </dt>
                  <dd>
                    {method.available
                      ? sp.subscriptionAvailable
                      : sp.subscriptionUnavailable}
                    {method.available && method.since_protocol && (
                      <>
                        {" · "}
                        {sp.subscriptionSinceProtocol}{" "}
                        <code>{method.since_protocol}</code>
                      </>
                    )}
                    {!method.available && method.requires && (
                      <>
                        {" · "}
                        {sp.subscriptionRequiresLabel}: {method.requires}
                      </>
                    )}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="entry-meta">
              {sp.subscribableTemplatesLabel}: {subscribableCount} /{" "}
              {templateEntries.length}
            </p>
          </section>
        )
      }

      <UpdatedLine lang={lang} />
    </div>

    {
      /* Desktop: sticky rail, always visible above the breakpoint (see the
        media queries below) — plain anchors, no JS. */
    }
    <aside class="toc-rail">
      <ServerToc
        families={tocFamilies}
        ariaLabel={sp.tocLabel}
      />
    </aside>

    {
      /* Mobile: floating button + panel, both driven by `#toc-open` above.
        `<label for="toc-open">` toggles the checkbox on click/tap with zero
        JavaScript — standard label behaviour, not a custom mechanism. */
    }
    <label
      for="toc-open"
      class="toc-fab"
    >
      {sp.tocFabLabel}
    </label>
    <label
      for="toc-open"
      class="toc-scrim"
      aria-hidden="true"
    ></label>
    <div
      id="toc-panel"
      class="toc-panel"
      role="dialog"
      aria-modal="true"
      aria-label={sp.tocLabel}
    >
      <label
        for="toc-open"
        class="toc-panel-close"
      >
        {sp.tocClose}
      </label>
      <ServerToc
        families={tocFamilies}
        ariaLabel={sp.tocPanelLabel}
      />
    </div>
  </div>
</div>

<style>
  .server-page {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-xl);
  }

  .back-link {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* `.prose-text` is base.css's, but the links inside one are not: Astro
     scopes \3c style> per component, so every page carrying prose links needs
     its own copy (Internals and Policies have the same pair). */
  .prose-text a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .prose-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Icon + name inline, scoped to just THIS page's `<h1>` — Astro's per-
     component style scoping means this never touches `.subpage-title`'s
     shared base rule in base.css, which Inspector/Policies/Internals still
     use unmodified (none of them have a server icon to place). */
  .subpage-title {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .server-icon {
    flex: none;
    width: 1em;
    height: 1em;
  }

  .server-card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Every icon on this page ships as a `currentColor` SVG, but `currentColor`
     inside an image loaded via `<img>` resolves against THAT image's own
     isolated rendering context, not this page's `--color-text-heading` — it
     does not follow the surrounding cascade at all. That isolation is
     exactly what makes `<img>` safe here (see `src/lib/card-icons.ts`), and
     its cost is that every one of these icons renders as a fixed color
     (in practice, black) no matter the site's theme.
     A CSS `filter` recolors the rasterized image after the fact instead of
     touching the SVG source, so the `<img>`-only rule stays intact. Dark is
     this site's default (no `data-theme` attribute needed — see
     tokens.css's header comment), so the un-inverted (light-theme) case is
     the override, exactly mirroring tokens.css's own auto+manual dual-block
     mechanism for theme switches. */
  .server-icon,
  .entry-icon {
    filter: invert(1);
  }

  @media (prefers-color-scheme: light) {
    :global(html:not([data-theme="dark"])) .server-icon,
    :global(html:not([data-theme="dark"])) .entry-icon {
      filter: none;
    }
  }

  :global(html[data-theme="light"]) .server-icon,
  :global(html[data-theme="light"]) .entry-icon {
    filter: none;
  }

  /* ===== Two-column layout: content + sticky rail, desktop only ========== */
  .server-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-lg);
  }

  @media (width >= 64rem) {
    .server-layout {
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: start;
    }
  }

  .server-content {
    /* min-width:0 on a grid item: without it, a long unbroken token (a
       resource URI, an endpoint) can force the grid track wider than the
       viewport instead of wrapping inside `<code>` — the 360px scroll bug
       this rule exists to prevent. */
    min-width: 0;
  }

  .server-family {
    margin-top: var(--space-lg-xl);
  }

  .server-family:first-child {
    margin-top: 0;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 1rem;
    margin: 0 0 1rem;
    font-size: var(--text-sm);
  }

  .meta-grid dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .meta-grid dd {
    margin: 0;
    color: var(--color-text-heading);
    overflow-wrap: anywhere;
  }

  .meta-grid code {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .server-meta-links {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .server-meta-links a {
    display: inline-flex;
    gap: 0.3rem;
    align-items: center;
    font-weight: var(--fw-semibold);
    color: var(--color-accent);
    text-decoration: none;
  }

  .server-meta-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* The card's own `serverInfo.description` — quoted, not translated (it is
     English-only SEP-1649 data), set off from `.subpage-intro` above (this
     site's own bilingual copy) so the two are never mistaken for one text. */
  .card-own-description {
    padding: 0.75rem 0.9rem;
    margin: 0 0 1rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: pretty;

    /* A surface, not a tint: `--color-bg-subtle` is 5% translucent and here
       this block sits on the page background, so the grid ran through it.
       Where that token DOES work is over an already-opaque card (the chips,
       the POST verb): there it is a shade, not the surface. */
    background: var(--color-bg-secondary);
    border-radius: var(--radius-md);
  }

  .card-own-description-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .fold-intro {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .entry {
    padding: 1rem 1.1rem;

    /* NO shadow, and that is deliberate. jmrp.io/projects carries none on its
       cards either (zero `box-shadow` on that page): the opaque surface and the
       hairline are what separate them, nothing more. And the only two shadow
       tokens that exist here — `--sh-card` and `--sh-pop` — are 60-70px drops
       meant for one large card on its own; repeated across hundreds of entries
       in a row they would muddy the whole column. Inventing a third token for
       this would be extending the design system without a mandate. */

    /* Anchor target offset: without this, jumping to #tool-x lands the
       entry's top edge flush under the sticky site header. */
    scroll-margin-top: calc(var(--header-height) + 1rem);

    /* An OPAQUE surface, like jmrp.io's cards: with only a border, the
       background grid runs through the box and in light mode it stops reading
       as a surface. `--color-bg-subtle` will not do either — it is 5%
       translucent, so the grid shows through just the same. */
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
  }

  .entry-title {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--fw-medium);
    color: var(--color-text-heading);
  }

  .entry-icon {
    flex: none;
    width: 1.05em;
    height: 1.05em;
  }

  .entry-name {
    margin: 0.2rem 0 0;
  }

  .entry-name code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  /* Behavioural hints (SEP-1649 tool annotations) — real security signal,
     not decoration: knowing `gitlab_execute_action` is destructive matters
     BEFORE connecting a client to it. Only tools carry these (gitlab has 2,
     libgen 4), so even on gitlab's 84-entry card this list never grows past
     a couple of chips per tool. */
  .annotation-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0;
    margin: 0.55rem 0 0;
    list-style: none;
  }

  /* `.chip` (mono pill shape) comes from utilities.css; these two variants
     only add color. `--info` covers read-only/idempotent/external-network —
     purely informative, so it stays as quiet as the rest of the metadata. */
  .a-chip--info {
    color: var(--color-text-muted);
    background: var(--color-bg-subtle);
  }

  /* The one chip that must stand out: it says a tool can change or delete
     something. Meaning rides on the TEXT, which is translated in both, not
     just the color, so this reads the same under a color-vision deficiency —
     the color is emphasis on top of that, not the only signal. */
  .a-chip--destructive {
    font-weight: var(--fw-medium);
    color: var(--color-danger);
    background: var(--danger-dim);
    border-color: var(--color-danger);
  }

  .entry-desc {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .entry-desc--muted {
    font-style: italic;
    color: var(--color-text-muted);
  }

  .entry-meta {
    margin: 0.5rem 0 0;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .entry-meta code {
    font-family: var(--font-mono);
  }

  /* Heading over a tool's argument list. Prompts do not need one — a prompt
     has arguments and nothing else — but a tool now shows two lists, and
     unlabelled they would read as one. */
  .schema-head {
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* The declared type, beside the field name: `string`, `string[]`,
     `"a" | "b"` — whatever `schemaFields` could read. Quieter than the name,
     which is what a reader scans for. */
  .arg-type {
    font-weight: var(--fw-normal);
    color: var(--color-text-muted);
  }

  /* Both schema lists, collapsed. Same list inside, one summary line outside.
     (Class name kept from when only the return used it — both use it now.) */
  .returns {
    margin-top: 0.9rem;
  }

  /* See `.disclosure` in utilities.css: the chevron, the colour and the hover
     come from there. These <details> were born without them, which is why they
     were indistinguishable from a dead label. */
  .returns > summary {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .returns > summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .returns[open] > summary {
    margin-bottom: 0.2rem;
  }

  /* Inside a <details> the list already has the summary above it, so it does
     not need the rule the standalone one uses to separate itself. */
  .returns .args {
    padding-top: 0;
    border-top: none;
  }

  .args {
    display: grid;

    /* Capped, not `auto`. A tool's type can be a long enum union — libgen's
       `source` lists sixteen alternatives — and an `auto` track sizes itself
       to that, which measured 630px of an 843px list and squeezed every
       description into the remaining sliver. Bounded, the union wraps inside
       its own column and the descriptions keep their width. */
    grid-template-columns: minmax(0, 40%) 1fr;
    gap: 0.3rem 0.85rem;
    padding-top: 0.75rem;
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
    border-top: 1px solid var(--color-hair);
  }

  .args dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-heading);
    overflow-wrap: anywhere; /* so a long union breaks inside the capped column */
  }

  .args dt code {
    color: var(--color-accent);
  }

  .args .req {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .args dd {
    margin: 0;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .entry-cta {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .entry-cta a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .entry-cta a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ===== Instructions (server/discover) ================================== */

  /* Shares `.card-own-description`'s quote styling (the subtle background is
     the "this is the server speaking, not this site" marker); these rules
     only add what a MULTI-paragraph quote needs on top of that single-`<p>`
     rule. */
  .server-instructions p {
    margin: 0;

    /* Single line breaks inside a paragraph render as explicit <br /> (see
       `paragraphLines`): the post-build minifier collapses raw newlines in
       text nodes, so relying on pre-line alone silently lost them in the
       served page. pre-line stays as a safety net. */
    white-space: pre-line;
  }

  .server-instructions p + p {
    margin-top: 0.65rem;
  }

  /* ===== Action catalog (gitlab) ========================================= */

  /* The Free-token caveat. Body text, not a chip, and never folded away:
     without it every count in the table claims a universality the manifest
     itself disowns (`cacheScope: "private"`). */
  .catalog-token-note {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

