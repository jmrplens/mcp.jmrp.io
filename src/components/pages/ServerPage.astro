  /* ===== TOC: mobile FAB + panel + scrim, checkbox-hack ==================
     Same technique as Base.astro's nav drawer (hidden checkbox + `:has()` +
     `<label>` scrim), scoped to this page's own `#toc-open` instead of the
     header's `#nav-open`. No inline script here at all — see the comment on
     the checkbox above for why this one stays zero-JS where the nav drawer
     layers a little progressive enhancement on top. */
  .toc-fab,
  .toc-scrim,
  .toc-panel {
    display: none;
  }

  @media (width < 64rem) {
    .toc-fab {
      position: fixed;
      right: var(--space-md);
      bottom: var(--space-md);
      z-index: var(--z-fab);
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.7rem 1.1rem;
      color: var(--color-on-primary);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: var(--fw-medium);
      text-decoration: none;
      cursor: pointer;
      background: var(--color-primary);
      border-radius: var(--radius-pill);
      box-shadow: var(--sh-pop);
    }

    .toc-fab::before {
      content: "≡";
    }

    .toc-scrim {
      position: fixed;
      inset: 0;
      z-index: var(--z-backdrop);
      display: block;
      background: var(--scrim);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--dur-3) var(--ease-out),
        visibility var(--dur-3) var(--ease-out);
    }

    .toc-panel {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: var(--z-drawer);
      display: block;
      max-height: 70vh;
      padding: var(--space-md);
      overflow-y: auto;
      background: var(--color-bg-secondary);
      border-top: 1px solid var(--color-border);
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      box-shadow: var(--sh-pop);
      visibility: hidden;
      transition:
        transform var(--dur-3) var(--ease-out),
        visibility var(--dur-3) var(--ease-out);
      transform: translateY(100%);
    }

    .toc-panel-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 0.4rem 0.8rem;
      margin: 0 0 0.5rem;
      color: var(--color-text-muted);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      cursor: pointer;
      border: 1px solid var(--color-hair);
      border-radius: var(--radius-md);
    }

    /* `.toc-scrim`/`.toc-panel` are TRUE siblings of `#toc-open` (both direct
       children of `.server-layout`, both after it in source order), so a
       plain sibling combinator reaches them — no `:has()` needed, unlike
       Base.astro's nav drawer, where the checkbox and the elements it drives
       are NOT siblings (the drawer needs to reach `<body>`, outside the
       `<header>` the checkbox lives in). Astro scopes both sides of this
       selector to the same component instance automatically. */
    .toc-toggle-cb:checked ~ .toc-scrim {
      visibility: visible;
      opacity: 1;
    }

    .toc-toggle-cb:checked ~ .toc-panel {
      visibility: visible;
      transform: translateY(0);
    }
  }
