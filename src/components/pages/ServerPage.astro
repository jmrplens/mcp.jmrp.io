     header's `#nav-open`. No inline script here at all — see the comment on
     the checkbox above for why this one stays zero-JS where the nav drawer
     layers a little progressive enhancement on top. */
  .toc-fab,
  .toc-scrim,
  .toc-panel {
    display: none;
  }

  @media (width < 64rem) {
    .toc-fab {
      position: fixed;
      right: var(--space-md);
      bottom: var(--space-md);
      z-index: var(--z-fab);
