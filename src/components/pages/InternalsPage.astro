---
/**
 * Internals page — how a request is actually routed, end to end.
 *
 * Written because nothing on the site said any of this: not that there are
 * three instances per server, not that each one exits through a different
 * country, and not what changed on 2026-08-22 when the balancer switched
 * from round-robin to consistent-hash affinity. See `internals.ts` for the
 * full content; this component is layout only.
 *
 * Uses `internals` directly, NOT the merged `ui` object: `src/i18n/ui.ts`'s
 * header comment explains why `internals.ts` is kept out of that merge (its
 * `metaTitle`/`title`/`lede` would silently mask `common`'s keys of the same
 * name under a flat spread).
 */
import type { McpInstance } from "../../data/topology";
import { topology } from "../../data/topology";
import { ui } from "../../i18n/ui";
import { internals } from "../../i18n/ui/internals.ts";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl } from "../../lib/seo";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = internals[lang];
// `backToHome` is shared chrome, so it lives in `common` and reaches this
// page through `ui` — `internals` is deliberately outside that merge.
const shared = ui[lang];
// Site-relative, like every other cross-page link on this site: an absolute
// URL here would jump a dev or preview server straight to production.
const homeHref = new URL(pageUrl(lang, "home")).pathname;
const policiesHref = new URL(pageUrl(lang, "policies")).pathname;

// The nginx directive that actually runs in production, quoted whole so a
// visitor can check the claims in the surrounding prose against real code —
// EXCEPT the salt itself, which is not a value this page can show.
//
// SECURITY: `"…"` stands in for the salt (48 hex characters), which lives
// only in `secrets/affinity-salt.env` on the server and is never checked
// into this repo or built into this site. Do not replace this placeholder
// with a real value, here or anywhere else.
const affinitySnippet = `set $mcp_affinity_salt "…";   ${t.affinityCodeComment}

set_by_lua_block $mcp_affinity {
    local token = ngx.var.http_private_token
    if token and token ~= "" then
        return ngx.md5(ngx.var.mcp_affinity_salt .. token)
    end
    return ngx.var.remote_addr or ""
}`;

// ===== Affinity diagram — layout math (build-time, no runtime JS) ==========
//
// Everything below runs once, on the server, while Astro renders this page's
// HTML. None of it ships to the browser: the diagram that reaches the client
// is plain, static SVG plus CSS animations (see the <style> block). This is
// what "no JavaScript on this page" (Restriction) means in practice — the
// computation happens, just not where a crawler or an assistant would have
// to run it.

// Presentation constants for the diagram: "how many circles fit legibly on
// the row", not an infrastructure fact. They live here, not in
// `topology.ts`, because changing how the diagram draws should never look
// like changing what is actually running.
const MAX_DRAWN_NODES = 4; // beyond this, the rest folds into the "+" ghost node
const NODE_GAP = 26; // center-to-center spacing along a node row

/**
 * Group one server's instances into "what the diagram draws": up to
 * `MAX_DRAWN_NODES` real nodes plus an overflow count, and which one is
 * highlighted as the client's matched node.
 *
 * IMPORTANT — `matchedIndex` is illustrative, not the real affinity
 * algorithm. It is fixed at index 1 for every render; there is no hash
 * computed here, and there could not be one: the real decision (see
 * `affinitySnippet` above) is keyed by `$mcp_affinity_salt`, a secret that
 * never leaves the server and is deliberately never in this repo. Do not
 * read this function as "how nginx picks a node" — it only decides which
 * circle the diagram lights up so the loop has something to rest on.
 */
function clusterOf(instances: McpInstance[]) {
  const drawn = instances.slice(0, MAX_DRAWN_NODES);
  const overflow = instances.length - drawn.length; // 0 → the ghost node shows a bare "+"
  const matchedIndex = Math.min(1, drawn.length - 1);
  return {
    drawn,
    overflow,
    matchedIndex,
    matchedCountry: instances[matchedIndex].egressCountry,
  };
}

/**
 * Center-to-center positions for a row of `count` nodes, centered on
 * (centerX, centerY). Used for both the desktop row (horizontal branch) and
 * the mobile row (still horizontal — see the mobile SVG below): only the
 * `centerX`/`centerY` passed in differ.
 */
function rowPositions(count: number, centerX: number, centerY: number, gap = NODE_GAP) {
  const span = (count - 1) * gap;
  const startX = centerX - span / 2;
  return Array.from({ length: count }, (_, i) => ({ x: startX + i * gap, y: centerY }));
}

const libgenCluster = clusterOf(topology.libgen);
const gitlabCluster = clusterOf(topology.gitlab);

// Desktop coordinates — viewBox 0 0 960 300, trunk at y=150, libgen branch at
// y=90, gitlab branch at y=210 (see the desktop <svg> below). Computed once
// and reused for both the drawn nodes and the ghost node, so the two never
// diverge.
const libgenRowDesktop = rowPositions(libgenCluster.drawn.length, 600, 90);
const gitlabRowDesktop = rowPositions(gitlabCluster.drawn.length, 600, 210);
// Non-null: `rowPositions` always returns at least one entry (a server always
// has at least one instance), so the last element always exists.
const libgenLastDesktop = libgenRowDesktop.at(-1)!;
const gitlabLastDesktop = gitlabRowDesktop.at(-1)!;

// Mobile coordinates — viewBox 0 0 240 900, both lanes centered on x=120;
// only the x of each node varies by cluster, the y per node is fixed by the
// lane layout (see the mobile <svg> below).
const libgenRowMobile = rowPositions(libgenCluster.drawn.length, 120, 0);
const gitlabRowMobile = rowPositions(gitlabCluster.drawn.length, 120, 0);
const libgenLastMobileX = libgenRowMobile.at(-1)!.x;
const gitlabLastMobileX = gitlabRowMobile.at(-1)!.x;
---

<p class="back-link">
  <a href={homeHref}>{shared.backToHome}</a>
</p>

<h1>{t.title}</h1>

<p class="internals-intro">{t.lede}</p>

<section aria-labelledby="path-h">
  <h2 class="eyebrow" id="path-h">{t.pathEyebrow}</h2>
  {t.pathBody.map((paragraph) => <p class="internals-text">{paragraph}</p>)}
</section>

<section aria-labelledby="instances-h">
  <h2 class="eyebrow" id="instances-h">{t.instancesEyebrow}</h2>
  {t.instancesBody.map((paragraph) => <p class="internals-text">{paragraph}</p>)}
</section>

<section aria-labelledby="affinity-h">
  <h2 class="eyebrow" id="affinity-h">{t.affinityEyebrow}</h2>
  <p class="internals-text">{t.affinityIntro}</p>
  <p class="internals-text">{t.affinityLibgen}</p>
  <p class="internals-text">{t.affinityGitlab}</p>
  {t.affinityCodeIntro.map((paragraph) => <p class="internals-text">{paragraph}</p>)}
  <pre><code>{affinitySnippet}</code></pre>
  <p class="internals-text">{t.affinityConsequence}</p>

  {/* Decorative recap of the paragraphs above, nothing more: `aria-hidden`
      on both <svg>s takes the whole figure out of the accessibility tree, so
      the meaning lives entirely in `t.diagramCaption` plus the prose already
      read above it — never only in the animation. See the layout math above
      this component's frontmatter for `libgenCluster`/`gitlabCluster`. */}
  <figure class="mcp-flow-figure">
    <svg
      class="mcp-flow mcp-flow--desktop"
      viewBox="0 0 960 300"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Shared trunk: client, Cloudflare, nginx (the hash decision) -->
      <line x1="60" y1="150" x2="380" y2="150" class="spine spine--neutral" />
      <circle cx="60" cy="150" r="13" class="node node--neutral" />
      <circle cx="210" cy="150" r="13" class="node node--neutral" />
      <circle cx="380" cy="150" r="15" class="node node--hash" />

      <!-- libgen branch (teal), y=90 -->
      <line x1="380" y1="150" x2="600" y2="90" class="spine spine--libgen" />
      <line x1="600" y1="90" x2="760" y2="90" class="spine spine--libgen" />
      <line x1="760" y1="90" x2="880" y2="90" class="spine spine--libgen" />
      {
        libgenCluster.drawn.map((_instance, i) => {
          const { x, y } = libgenRowDesktop[i];
          const matched = i === libgenCluster.matchedIndex;
          return (
            <circle
              cx={x}
              cy={y}
              r={matched ? 9 : 6}
              class={`node node--libgen ${matched ? "node--matched" : "node--sibling"}`}
            />
          );
        })
      }
      <g class="node-ghost node-ghost--libgen">
        <circle cx={libgenLastDesktop.x + NODE_GAP} cy="90" r="7" />
        <text x={libgenLastDesktop.x + NODE_GAP} y="94" text-anchor="middle">
          {libgenCluster.overflow > 0 ? `+${libgenCluster.overflow}` : "+"}
        </text>
      </g>
      <rect x="742" y="78" width="36" height="24" rx="6" class="chip chip--libgen" />
      <text x="760" y="94" text-anchor="middle" class="chip-label chip-label--libgen">
        {libgenCluster.matchedCountry === "ES" ? "ES" : "UK"}
      </text>
      <circle cx="880" cy="90" r="11" class="node node--libgen node--dest" />
      <text x="880" y="118" text-anchor="middle" class="dest-label dest-label--libgen">
        libgen
      </text>

      <!-- gitlab branch (violet), y=210, same shape -->
      <line x1="380" y1="150" x2="600" y2="210" class="spine spine--gitlab" />
      <line x1="600" y1="210" x2="760" y2="210" class="spine spine--gitlab" />
      <line x1="760" y1="210" x2="880" y2="210" class="spine spine--gitlab" />
      {
        gitlabCluster.drawn.map((_instance, i) => {
          const { x, y } = gitlabRowDesktop[i];
          const matched = i === gitlabCluster.matchedIndex;
          return (
            <circle
              cx={x}
              cy={y}
              r={matched ? 9 : 6}
              class={`node node--gitlab ${matched ? "node--matched" : "node--sibling"}`}
            />
          );
        })
      }
      <g class="node-ghost node-ghost--gitlab">
        <circle cx={gitlabLastDesktop.x + NODE_GAP} cy="210" r="7" />
        <text x={gitlabLastDesktop.x + NODE_GAP} y="214" text-anchor="middle">
          {gitlabCluster.overflow > 0 ? `+${gitlabCluster.overflow}` : "+"}
        </text>
      </g>
      <rect x="742" y="198" width="36" height="24" rx="6" class="chip chip--gitlab" />
      <text x="760" y="214" text-anchor="middle" class="chip-label chip-label--gitlab">
        {gitlabCluster.matchedCountry === "ES" ? "ES" : "UK"}
      </text>
      <circle cx="880" cy="210" r="11" class="node node--gitlab node--dest" />
      <text x="880" y="238" text-anchor="middle" class="dest-label dest-label--gitlab">
        gitlab
      </text>

      <!-- The two points that travel in a loop -->
      <circle class="pulse pulse--libgen" cx="0" cy="0" r="5" />
      <circle class="pulse pulse--gitlab" cx="0" cy="0" r="5" />
    </svg>

    <svg
      class="mcp-flow mcp-flow--mobile"
      viewBox="0 0 240 900"
      aria-hidden="true"
      focusable="false"
    >
      <!-- libgen lane -->
      <text x="120" y="16" text-anchor="middle" class="lane-label lane-label--libgen">
        libgen
      </text>
      <line x1="120" y1="30" x2="120" y2="380" class="spine spine--libgen" />
      <circle cx="120" cy="50" r="11" class="node node--neutral" />
      <circle cx="120" cy="120" r="11" class="node node--neutral" />
      <circle cx="120" cy="190" r="13" class="node node--hash" />
      {
        libgenCluster.drawn.map((_instance, i) => {
          const { x } = libgenRowMobile[i];
          const matched = i === libgenCluster.matchedIndex;
          return (
            <circle
              cx={x}
              cy="260"
              r={matched ? 9 : 6}
              class={`node node--libgen ${matched ? "node--matched" : "node--sibling"}`}
            />
          );
        })
      }
      <g class="node-ghost node-ghost--libgen">
        <circle cx={libgenLastMobileX + NODE_GAP} cy="260" r="7" />
        <text x={libgenLastMobileX + NODE_GAP} y="264" text-anchor="middle">
          {libgenCluster.overflow > 0 ? `+${libgenCluster.overflow}` : "+"}
        </text>
      </g>
      <rect x="102" y="318" width="36" height="24" rx="6" class="chip chip--libgen" />
      <text x="120" y="334" text-anchor="middle" class="chip-label chip-label--libgen">
        {libgenCluster.matchedCountry === "ES" ? "ES" : "UK"}
      </text>
      <circle cx="120" cy="390" r="11" class="node node--libgen node--dest" />

      <!-- gitlab lane, offset +460 in y -->
      <text x="120" y="476" text-anchor="middle" class="lane-label lane-label--gitlab">
        gitlab
      </text>
      <line x1="120" y1="490" x2="120" y2="840" class="spine spine--gitlab" />
      <circle cx="120" cy="510" r="11" class="node node--neutral" />
      <circle cx="120" cy="580" r="11" class="node node--neutral" />
      <circle cx="120" cy="650" r="13" class="node node--hash" />
      {
        gitlabCluster.drawn.map((_instance, i) => {
          const { x } = gitlabRowMobile[i];
          const matched = i === gitlabCluster.matchedIndex;
          return (
            <circle
              cx={x}
              cy="720"
              r={matched ? 9 : 6}
              class={`node node--gitlab ${matched ? "node--matched" : "node--sibling"}`}
            />
          );
        })
      }
      <g class="node-ghost node-ghost--gitlab">
        <circle cx={gitlabLastMobileX + NODE_GAP} cy="720" r="7" />
        <text x={gitlabLastMobileX + NODE_GAP} y="724" text-anchor="middle">
          {gitlabCluster.overflow > 0 ? `+${gitlabCluster.overflow}` : "+"}
        </text>
      </g>
      <rect x="102" y="778" width="36" height="24" rx="6" class="chip chip--gitlab" />
      <text x="120" y="794" text-anchor="middle" class="chip-label chip-label--gitlab">
        {gitlabCluster.matchedCountry === "ES" ? "ES" : "UK"}
      </text>
      <circle cx="120" cy="850" r="11" class="node node--gitlab node--dest" />

      <circle class="pulse pulse--libgen-mobile" cx="0" cy="0" r="5" />
      <circle class="pulse pulse--gitlab-mobile" cx="0" cy="0" r="5" />
    </svg>

    <figcaption class="mcp-flow-caption">{t.diagramCaption}</figcaption>
  </figure>
</section>

<section aria-labelledby="egress-h">
  <h2 class="eyebrow" id="egress-h">{t.egressEyebrow}</h2>
  {t.egressBody.map((paragraph) => <p class="internals-text">{paragraph}</p>)}
</section>

<section aria-labelledby="personal-h">
  <h2 class="eyebrow" id="personal-h">{t.personalEyebrow}</h2>
  {t.personalBody.map((paragraph) => <p class="internals-text">{paragraph}</p>)}
  {/* Points at the full statements (no-SLA, legal position) instead of
      repeating them: this page's job is the mechanism, policies' job is the
      commitment — or lack of one. */}
  <p class="internals-text">
    <a href={policiesHref}>{t.policiesLink}</a>
  </p>
</section>

{/* Visible freshness INSIDE <main>. See `UpdatedLine.astro` for why this
    cannot just live in the footer. */}
<UpdatedLine lang={lang} />

<style>

  /* Same rule as HomePage's `h1`: Astro scopes <style> per component, so the
     shared look needs its own copy here. Every page needs an <h1> — without
     one the document has no top-level heading and html-validate rejects the
     jump straight to <h2>. */
  h1 {
    max-width: 22ch;
    margin: 0 0 1.25rem;
    color: var(--color-text-heading);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  /* Copied from PoliciesPage.astro / InspectorPage.astro's shared rules:
     Astro scopes <style> per component, so a class used on more than one
     page needs its own copy here. */
  .back-link {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .internals-intro {
    max-width: 62ch;
    margin: 0 0 2.5rem;
    color: var(--color-text);
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  section {
    padding-block-end: 2.75rem;
  }

  /* Eyebrow with `//`, painted from CSS so it does NOT exist in the DOM —
     `textContent`-based extractors would otherwise read the heading as
     "//The path of a request". See HomePage.astro for the full rationale. */
  .eyebrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 1.25rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    color: var(--color-accent);
    content: "//";
  }

  .internals-text {
    max-width: 62ch;
    margin: 0 0 0.7rem;
    color: var(--color-text);
    font-size: 0.875rem;
    text-wrap: pretty;
  }

  .internals-text a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .internals-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same treatment as ClientSetup.astro's code blocks: overflow lives INSIDE
     the <pre>, not the page, because main sits in a fixed-width column and a
     long nginx line would otherwise widen it on mobile. */
  pre {
    max-width: 62ch;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-hair);
    border-radius: 6px;
    background: var(--color-bg-subtle);
  }

  pre code {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: pre;
  }

  /* ===== Affinity diagram ===================================================
     Session-affinity flow: client → Cloudflare → nginx (hash decision) → one
     of N instances → egress → destination. Two colored loops (teal=libgen,
     violet=gitlab) share the same trunk and fork where the hash actually
     picks a node — see the SVG markup above and `t.diagramCaption` for the
     accessible equivalent of what this draws. */
  .mcp-flow-figure {
    max-width: 62ch;
    margin: 1.75rem 0;
    padding: 1rem;
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .mcp-flow {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Desktop shown by default; swapped for mobile below (width <= 640px). */
  .mcp-flow--mobile {
    display: none;
  }

  /* ===== Strokes and nodes — neutral (shared trunk) ========================= */
  .spine {
    fill: none;
    stroke-width: 1.5;
  }

  .spine--neutral {
    stroke: var(--color-border);
  }

  .node--neutral {
    fill: var(--color-bg-secondary);
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
  }

  .node--hash {
    fill: var(--color-bg-secondary);
    stroke: var(--color-accent);
    stroke-width: 2;
  }

  /* ===== libgen branch (teal) ================================================ */
  .spine--libgen {
    stroke: var(--teal);
    stroke-opacity: 55%;
  }

  .node--libgen.node--matched {
    fill: var(--teal);
    stroke: var(--teal);
  }

  .node--libgen.node--sibling {
    fill: none;
    stroke: color-mix(in srgb, var(--teal) 45%, transparent);
    stroke-width: 1.25;
  }

  .node--libgen.node--dest {
    fill: var(--color-bg-secondary);
    stroke: var(--teal);
    stroke-width: 2;
  }

  .node-ghost--libgen circle {
    fill: none;
    stroke: color-mix(in srgb, var(--teal) 35%, transparent);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
  }

  .node-ghost--libgen text,
  .chip-label--libgen,
  .dest-label--libgen,
  .lane-label--libgen {
    fill: var(--teal-text);
  }

  .chip--libgen {
    fill: var(--teal-dim);
    stroke: color-mix(in srgb, var(--teal) 40%, transparent);
  }

  /* ===== gitlab branch (violet) — same rules, different color =============== */
  .spine--gitlab {
    stroke: var(--violet);
    stroke-opacity: 55%;
  }

  .node--gitlab.node--matched {
    fill: var(--violet);
    stroke: var(--violet);
  }

  .node--gitlab.node--sibling {
    fill: none;
    stroke: color-mix(in srgb, var(--violet) 45%, transparent);
    stroke-width: 1.25;
  }

  .node--gitlab.node--dest {
    fill: var(--color-bg-secondary);
    stroke: var(--violet);
    stroke-width: 2;
  }

  .node-ghost--gitlab circle {
    fill: none;
    stroke: color-mix(in srgb, var(--violet) 35%, transparent);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
  }

  .node-ghost--gitlab text,
  .chip-label--gitlab,
  .dest-label--gitlab,
  .lane-label--gitlab {
    fill: var(--violet);
  }

  .chip--gitlab {
    fill: var(--violet-dim);
    stroke: color-mix(in srgb, var(--violet) 40%, transparent);
  }

  /* ===== Shared text ========================================================= */
  .node-ghost text,
  .chip-label,
  .dest-label,
  .lane-label {
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    dominant-baseline: middle;
  }

  .lane-label {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ===== The traveling point ================================================= */
  .pulse {
    filter: drop-shadow(0 0 3px currentcolor);
  }

  .pulse--libgen,
  .pulse--libgen-mobile {
    fill: var(--teal);
    color: var(--teal);
  }

  .pulse--gitlab,
  .pulse--gitlab-mobile {
    fill: var(--violet);
    color: var(--violet);
  }

  /* Desktop path — EXACT coordinates from the desktop <svg> above (trunk
     y=150, libgen branch y=90, gitlab branch y=210). Starts and ends resting
     on the matched node: 0% and 100% coincide, so the loop never "jumps".
     The 38%→45% stretch travels invisibly (opacity 0 at both ends) to hide
     the teleport from destination back to client. */
  @keyframes flow-libgen-desktop {
    0%,
    8% {
      transform: translate(600px, 90px);
      opacity: 100%;
    }

    20% {
      transform: translate(760px, 90px);
      opacity: 100%;
    }

    30%,
    38% {
      transform: translate(880px, 90px);
      opacity: 100%;
    }

    38.001% {
      opacity: 0%;
    }

    45% {
      transform: translate(60px, 150px);
      opacity: 0%;
    }

    55% {
      transform: translate(60px, 150px);
      opacity: 100%;
    }

    65% {
      transform: translate(210px, 150px);
    }

    75% {
      transform: translate(380px, 150px);
    }

    88%,
    100% {
      transform: translate(600px, 90px);
    }
  }

  @keyframes flow-gitlab-desktop {
    0%,
    8% {
      transform: translate(600px, 210px);
      opacity: 100%;
    }

    20% {
      transform: translate(760px, 210px);
      opacity: 100%;
