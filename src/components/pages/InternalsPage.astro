---
/**
 * Internals page — how a request is actually routed, end to end.
 *
 * Written because nothing on the site said any of this: not that there are
 * three instances per server, not that each one exits through a different
 * country, and not what changed on 2026-08-22 when the balancer switched
 * from round-robin to consistent-hash affinity. See `internals.ts` for the
 * full content; this component is layout only.
 *
 * Uses `internals` directly, NOT the merged `ui` object: `src/i18n/ui.ts`'s
 * header comment explains why `internals.ts` is kept out of that merge (its
 * `metaTitle`/`title`/`lede` would silently mask `common`'s keys of the same
 * name under a flat spread).
 *
 * REQUEST-PATH DIAGRAM — REPLACED, not tweaked, twice over. Attempt 1 drew a
 * shared trunk forking into a libgen branch and a gitlab branch, as if nginx
 * chose the destination server per request. It does not: a client points
 * its MCP client at mcp.jmrp.io/libgen OR at mcp.jmrp.io/gitlab, and that
 * choice — made on the client, before the request exists on the wire — is
 * what selects the server (two separate `location` blocks in the vhost,
 * each with its own `upstream`; see `docs/nginx-vhost-reference.conf`).
 * Drawing that as a fork taught content-based routing, which is exactly the
 * one thing that is not happening. Attempt 2 fixed that (one chain, played
 * twice in a loop to contrast the IP-keyed and token-keyed passes) but was
 * still, in the author's words, "an animation of dots travelling" rather
 * than an infographic, and did not read well on narrow screens.
 *
 * This build is neither: a compact horizontal strip (client → Cloudflare →
 * nginx → one of N nodes → egress → destination), ALWAYS static — nothing
 * in the strip itself moves or travels. What plays, in a loop, is a set of
 * five numbered annotation bubbles below it, one at a time, each pointing at
 * the strip piece it describes and highlighting that piece for as long as
 * it is shown (see the approved spec at
 * `.superpowers/sdd/internals-diagram-spec.md` for the exact bubble
 * sequence and the non-negotiables). The bubble area reserves a FIXED
 * height (the tallest bubble's) so the page never jumps as they cycle —
 * that fixed reservation is the whole point: it is what "an infographic",
 * not "an animation", means in CSS terms here.
 *
 * The bubbles describe the mechanism in general terms (with a token, or
 * without one) rather than singling out libgen vs gitlab or which specific
 * node a given request lands on — see `topology.ts`'s header comment for
 * why the node pool this diagram draws is `topology.libgen` alone, and the
 * numbered prose timeline right below the figure for the full detail, in
 * real HTML, that the bubbles deliberately keep short.
 */
import type { McpInstance } from "../../data/topology";
import { topology } from "../../data/topology";
import { ui } from "../../i18n/ui";
import { internals } from "../../i18n/ui/internals.ts";
import { getLangFromUrl } from "../../i18n/utils";
import { pageUrl } from "../../lib/seo";
import UpdatedLine from "../UpdatedLine.astro";

const lang = getLangFromUrl(Astro.url);
const t = internals[lang];
// `backToHome` is shared chrome, so it lives in `common` and reaches this
// page through `ui` — `internals` is deliberately outside that merge.
const shared = ui[lang];
// Site-relative, like every other cross-page link on this site: an absolute
// URL here would jump a dev or preview server straight to production.
const homeHref = new URL(pageUrl(lang, "home")).pathname;
const policiesHref = new URL(pageUrl(lang, "policies")).pathname;

// The nginx directive that actually runs in production, quoted whole so a
// visitor can check the claims in the surrounding prose against real code —
// EXCEPT the salt itself, which is not a value this page can show.
//
// SECURITY: `"…"` stands in for the salt (48 hex characters), which lives
// only in `secrets/affinity-salt.env` on the server and is never checked
// into this repo or built into this site. Do not replace this placeholder
// with a real value, here or anywhere else.
const affinitySnippet = `set $mcp_affinity_salt "…";   ${t.affinityCodeComment}

set_by_lua_block $mcp_affinity {
    local token = ngx.var.http_private_token
    if token and token ~= "" then
        return ngx.md5(ngx.var.mcp_affinity_salt .. token)
    end
    return ngx.var.remote_addr or ""
}`;

// ===== Request-path diagram — build-time data, no runtime JS ===============
//
// Everything below runs once, on the server, while Astro renders this page's
// HTML. None of it ships to the browser: the diagram that reaches the client
// is a static strip (plain HTML/CSS, no SVG, nothing draws or travels) plus
// five annotation bubbles cycled by CSS animations alone (see the <style>
// block). This is what "no JavaScript on this page" (Restriction) means in
// practice — the computation happens, just not where a crawler or an
// assistant would have to run it.

// "How many badges fit legibly", not an infrastructure fact — capped so the
// diagram folds anything beyond it into the dim "+" ghost node instead of
// needing a redraw if the real pool grows.
const MAX_DRAWN_NODES = 3;

// The pool of real nodes this diagram draws — see this file's header
// comment and `topology.ts`'s for why reusing one server's real, verified
// pool here is deliberate: the diagram no longer claims to show which
// server, only the mechanism every server uses. `overflowCount` is 0 with
// the pool at its current size (3), so the ghost node renders a bare "+";
// if a future instance count exceeds `MAX_DRAWN_NODES`, it renders "+N"
// instead — see the markup below.
const nodes: McpInstance[] = topology.libgen.slice(0, MAX_DRAWN_NODES);
const overflowCount = topology.libgen.length - nodes.length;

// The node the reduced-motion frozen frame rings as "the chosen one" (see
// the `prefers-reduced-motion` rules in the <style> block). ILLUSTRATIVE,
// not the real affinity outcome for any actual client — computing that
// needs `$mcp_affinity_salt`, the secret this page never has (see
// `affinitySnippet` above). Any index works; the point the ring makes is
// "always this same one", not "specifically this one".
const MATCHED_NODE_INDEX = 0;

/** "GB", the ISO code `topology.ts` stores, is spelled "UK" here — the form
 * the prose above already uses. "ES" reads the same either way. */
function countryTag(country: McpInstance["egressCountry"]): string {
  return country === "ES" ? "ES" : "UK";
}
---

<p class="back-link">
  <a href={homeHref}>{shared.backToHome}</a>
</p>

<h1 class="subpage-title">{t.title}</h1>

<p class="internals-intro">{t.lede}</p>

<section aria-labelledby="path-h">
  <h2 class="eyebrow" id="path-h">{t.pathEyebrow}</h2>
  {t.pathBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
</section>

<section aria-labelledby="instances-h">
  <h2 class="eyebrow" id="instances-h">{t.instancesEyebrow}</h2>
  {t.instancesBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
</section>

<section aria-labelledby="affinity-h">
  <h2 class="eyebrow" id="affinity-h">{t.affinityEyebrow}</h2>
  <p class="prose-text">{t.affinityIntro}</p>
  <p class="prose-text">{t.affinityLibgen}</p>
  <p class="prose-text">{t.affinityGitlab}</p>
  {t.affinityCodeIntro.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
  <pre><code>{affinitySnippet}</code></pre>
  <p class="prose-text">{t.affinityConsequence}</p>

  {/* Request-path figure: a static strip (nothing here moves — the
      "aria-hidden" icons are pure decoration, the stage names and node
      numbers/countries are real HTML, not SVG text) plus five annotation
      bubbles that cycle one at a time via CSS animation alone. The bubble
      area's height is reserved by `.mcp-bubbles`'s fixed `height` (see the
      <style> block) — that is what keeps the page from jumping as they
      cycle. `MATCHED_NODE_INDEX` only matters for the reduced-motion frozen
      frame, defined entirely inside that media query below. */}
  <figure class="mcp-flow-figure">
    <div class="mcp-strip">
      <div class="stage stage--client">
        <span class="stage-icon stage-icon--client" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="stage-label">{t.diagramStageClient}</span>
      </div>

      <div class="stage stage--cloudflare">
        <span class="stage-icon" aria-hidden="true"></span>
        <span class="stage-label">Cloudflare</span>
      </div>

      <div class="stage stage--nginx">
        <span class="stage-icon stage-icon--nginx" aria-hidden="true"></span>
        <span class="stage-label">nginx</span>
      </div>

      <div class="stage stage--nodes">
        <div class="node-cluster">
          {
            nodes.map((node, i) => (
              <span class={`node-badge${i === MATCHED_NODE_INDEX ? " node-badge--matched" : ""}`}>
                <span class="node-badge-num">{i + 1}</span>
                <span class="node-badge-country">{countryTag(node.egressCountry)}</span>
              </span>
            ))
          }
          {/* Dim "+" ghost: however many more the pool grows to. Never the
              reduced-motion match target — see `MATCHED_NODE_INDEX` above,
              always an index into the real `nodes`, never this one. */}
          <span class="node-badge node-badge--ghost">
            <span class="node-badge-num">{overflowCount > 0 ? `+${overflowCount}` : "+"}</span>
          </span>
        </div>
        <span class="stage-label">{t.diagramStageNodes}</span>
      </div>

      <div class="stage stage--egress">
        <span class="stage-icon" aria-hidden="true"></span>
        <span class="stage-label">{t.diagramStageEgress}</span>
      </div>

      <div class="stage stage--destination">
        <span class="stage-icon" aria-hidden="true"></span>
        <span class="stage-label">{t.diagramStageDestination}</span>
      </div>
    </div>

    {/* Fixed-height annotation zone: exactly one bubble opaque at a time,
        via the `phase-N` keyframes shared with each stage's highlight below
        (see the <style> block's "Bubble cycle" section for the timing
        table). `bubble-leader`'s `left` and each stage's highlight both key
        off the same five column positions, defined once as `--pos` per
        `.bubble--N` and reused by its leader/tail — see the <style> block's
        "Shared column positions" comment for why. */}
    <div class="mcp-bubbles">
      <div class="bubble bubble--1">
        <span class="bubble-leader" aria-hidden="true"></span>
        <p class="bubble-box"><span class="bubble-num" aria-hidden="true">1</span>{t.diagramBubble1}</p>
      </div>
      <div class="bubble bubble--2">
        <span class="bubble-leader" aria-hidden="true"></span>
        <p class="bubble-box"><span class="bubble-num" aria-hidden="true">2</span>{t.diagramBubble2}</p>
      </div>
      <div class="bubble bubble--3">
        <span class="bubble-leader" aria-hidden="true"></span>
        <p class="bubble-box"><span class="bubble-num" aria-hidden="true">3</span>{t.diagramBubble3}</p>
      </div>
      <div class="bubble bubble--4">
        <span class="bubble-leader" aria-hidden="true"></span>
        <p class="bubble-box"><span class="bubble-num" aria-hidden="true">4</span>{t.diagramBubble4}</p>
      </div>
      <div class="bubble bubble--5">
        <span class="bubble-leader" aria-hidden="true"></span>
        <p class="bubble-box"><span class="bubble-num" aria-hidden="true">5</span>{t.diagramBubble5}</p>
      </div>
    </div>

    <figcaption class="mcp-flow-caption">{t.diagramCaption}</figcaption>
  </figure>

  {/* Prose timeline: same five numbers as the bubbles above, full detail,
      real HTML — this, not the figure, is what a crawler, an assistant or a
      `prefers-reduced-motion` visitor actually reads. See this file's
      header comment for why the detail lives here and not in the figure. */}
  <p class="prose-text">{t.diagramTimelineIntro}</p>
  <ol class="mcp-timeline">
    <li>
      <span class="mcp-timeline-num" aria-hidden="true">1</span>
      <p>{t.diagramTimelineStep1}</p>
    </li>
    <li>
      <span class="mcp-timeline-num" aria-hidden="true">2</span>
      <p>{t.diagramTimelineStep2}</p>
    </li>
    <li>
      <span class="mcp-timeline-num" aria-hidden="true">3</span>
      <p>{t.diagramTimelineStep3}</p>
    </li>
    <li>
      <span class="mcp-timeline-num" aria-hidden="true">4</span>
      <p>{t.diagramTimelineStep4}</p>
    </li>
    <li>
      <span class="mcp-timeline-num" aria-hidden="true">5</span>
      <p>{t.diagramTimelineStep5}</p>
    </li>
  </ol>
</section>

<section aria-labelledby="egress-h">
  <h2 class="eyebrow" id="egress-h">{t.egressEyebrow}</h2>
  {t.egressBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
</section>

<section aria-labelledby="personal-h">
  <h2 class="eyebrow" id="personal-h">{t.personalEyebrow}</h2>
  {t.personalBody.map((paragraph) => <p class="prose-text">{paragraph}</p>)}
  {/* Points at the full statements (no-SLA, legal position) instead of
      repeating them: this page's job is the mechanism, policies' job is the
      commitment — or lack of one. */}
  <p class="prose-text">
    <a href={policiesHref}>{t.policiesLink}</a>
  </p>
</section>

{/* Visible freshness INSIDE <main>. See `UpdatedLine.astro` for why this
    cannot just live in the footer. */}
<UpdatedLine lang={lang} />

<style>

  /* Heading size lives in base.css's `.subpage-title` now — Inspector and
     Policies already used it; this page had its own hand-copied clamp
     (2.25rem→3.25rem, not 2.125rem→3.25rem) left over from before this page
     could be touched. Dropped in favor of the shared class so all three
     subpages share one rule, per base.css's `.subpage-title` comment. */

  /* Copied from PoliciesPage.astro / InspectorPage.astro's shared rules:
     Astro scopes <style> per component, so a class used on more than one
     page needs its own copy here. */
  .back-link {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .back-link a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-link a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .internals-intro {
    max-width: 62ch;
    margin: 0 0 2.5rem;
    color: var(--color-text);
    font-size: 1.0625rem;
    text-wrap: pretty;
  }

  section {
    padding-block-end: 2.75rem;
  }

  /* Eyebrow with `//`, painted from CSS so it does NOT exist in the DOM —
     `textContent`-based extractors would otherwise read the heading as
     "//The path of a request". See HomePage.astro for the full rationale,
     and for the numbers matched against jmrp.io's `.section-title`: this
     page's `.eyebrow` was the one copy left at the old bare 0.75rem/12px,
     `font-weight: 600` and muted color from before this page could be
     touched — HomePage.astro and PoliciesPage.astro already carry the fixed
     `--text-label` (12.5px) / `--fw-medium` (500) / 0.16em / full accent
     color version. */
  .eyebrow {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 1.25rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    font-weight: var(--fw-medium);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow::before {
    color: var(--color-accent);
    content: "//";
  }


  .prose-text a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .prose-text a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Same treatment as ClientSetup.astro's code blocks: overflow lives INSIDE
     the <pre>, not the page, because main sits in a fixed-width column and a
     long nginx line would otherwise widen it on mobile. */
  pre {
    max-width: 62ch;
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-hair);
    border-radius: 6px;
    background: var(--color-bg-subtle);
  }

  pre code {
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: pre;
  }

  /* ===== Request-path diagram =================================================
     A compact, STATIC horizontal strip (client → Cloudflare → nginx → one of
     N nodes → egress → destination — nothing here moves, ever) plus five
     numbered bubbles that cycle one at a time below it. See this file's
     header comment for why: two earlier versions were rejected, the second
     one specifically for still reading as "an animation of dots travelling"
     instead of an infographic. This one only animates a color highlight
     (never position) on whichever strip piece the current bubble names, and
     reserves a fixed height for the bubble zone so the page never jumps. */
  .mcp-flow-figure {
    max-width: 62ch;
    margin: 1.75rem 0;
    padding: 1rem;
    border: 1px solid var(--color-hair);
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  /* ===== The strip =============================================================
     Six stages on a shared 8-unit grid: client/Cloudflare/nginx/egress/
     destination get 1 column each, nodes gets 3 (it holds a small cluster of
     badges, not one icon). `min-width: 0` on `.stage` is load-bearing — a
     CSS grid track otherwise refuses to shrink a cell below its content's
     natural (unwrapped) width, which for a word like "Cloudflare" or
     "destination" would force the whole strip wider than the viewport at
     360px. With `min-width: 0` plus `overflow-wrap: anywhere` on the label
     below, the grid track wins instead and the word wraps — this is what
     keeps the strip horizontal with zero horizontal scroll at 360px, the
     hard requirement that sank neither, but almost sank, both earlier
     attempts. */
  .mcp-strip {
    position: relative;
    display: grid;
    /* Cloudflare/destination get a bit more than client/nginx/egress: they
       are the longest words on the strip ("Cloudflare", "destination") and
       would otherwise wrap ugly mid-word even with `overflow-wrap: anywhere`
       below. Nodes still gets by far the most room — see this block's
       header comment. */
    grid-template-columns: 1fr 1.3fr 1fr 3fr 1fr 1.3fr;
    align-items: start;
    column-gap: 2px;
  }

  /* The connecting line, painted BEHIND every stage: a `::before` pseudo-
     element is always painted before its element's real children, so the
     opaque icon/badge circles sitting on top of it read as beads on a wire
     with no z-index bookkeeping needed. */
  .mcp-strip::before {
    position: absolute;
    top: 9px; /* half of the 18px icon/badge diameter used throughout */
    left: 4%;
    content: "";
    right: 4%;
    height: 1px;
    background: var(--color-border);
  }

  .stage {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0; /* see this block's header comment */
    gap: 0.2rem;
    padding: 0.2rem;
    border-radius: var(--radius-md);
  }

  /* The highlight overlay — present on every stage, invisible until its own
     `phase-N` animation (see "Bubble cycle" below) makes it opaque for that
     bubble's window. `.stage--destination` never gets a `phase-N` animation
     assigned, so it stays invisible forever — there is no sixth bubble. */
  .stage::after {
    position: absolute;
    inset: -3px;
    content: "";
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--accent-dim);
    opacity: 0%;
    pointer-events: none;
  }

  .stage-icon {
    box-sizing: border-box;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg-secondary);
  }

  /* nginx: where the decision happens, drawn "in focus" even at rest — a
     thicker accent ring and a tinted fill, not just a highlight during its
     own bubble's window. */
  .stage-icon--nginx {
    border-width: 2.5px;
    border-color: var(--color-accent);
    background: var(--accent-dim);
  }

  /* Client: three small dots instead of a ring — "you", not a server. */
  .stage-icon--client {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border: none;
    background: none;
  }

  .stage-icon--client span {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-text-muted);
  }

  .stage-label {
    overflow-wrap: anywhere; /* see this block's header comment */
    hyphens: auto; /* "destination" breaks as "desti-nation", not "destinatio-n", if it still has to wrap at all */
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.15;
    text-align: center;
  }

  .stage--nginx .stage-label {
    color: var(--color-text);
    font-weight: var(--fw-semibold);
  }

  /* ===== Node cluster ==========================================================
     The pool of available nodes, all of them, always visible, never colored
     by which bubble is showing — bubble 4 highlights the whole cluster (via
     `.stage--nodes::after` above), never a single badge. Numbers/countries
     are real HTML text, not SVG: this is real data from `topology.ts`, not
     decoration. */
  .node-cluster {
    display: flex;
    justify-content: center;
    gap: 3px;
  }

  .node-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .node-badge-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border: 1.5px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg-secondary);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: var(--fw-semibold);
  }

  .node-badge-country {
    margin-top: 1px;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.5rem;
  }

  /* The dim "+" ghost badge: however many more the pool grows to. Always
     present, never matched, never highlighted on its own — see
     `overflowCount` above this component's frontmatter. */
  .node-badge--ghost .node-badge-num {
    border-color: var(--color-text-muted);
    border-style: dashed;
    background: none;
    color: var(--color-text-muted);
    opacity: 70%;
  }

  /* ===== Shared column positions ===============================================
     The five bubble targets, as center-of-column percentages of the strip's
     8.6-unit grid above (1fr client, 1.3fr Cloudflare, 1fr nginx, 3fr nodes,
     1fr egress, 1.3fr destination — destination has no bubble, so no 6th
     `--pos`). Column gap is 2px, imperceptible next to the figure's own
     width, so ignoring it here is fine. Each `--pos` positions that bubble's
     leader line and its box's speech-bubble tail below — one shared value
     instead of repeating the same percentage three times per bubble. */
  .bubble--1 {
    --pos: 5.81%;
  }

  .bubble--2 {
    --pos: 19.19%;
  }

  .bubble--3 {
    --pos: 32.56%;
  }

  .bubble--4 {
    --pos: 55.81%;
  }

  .bubble--5 {
    --pos: 79.07%;
  }

  /* ===== The fixed-height bubble zone ==========================================
     `height`, not `min-height`: with every `.bubble` absolutely positioned
     (below), the container has no in-flow content to size itself from, so it
     would collapse to 0 without an explicit height. This value is tuned
     against the longest bubble text in EITHER language at 360px wide, the
     narrowest this site supports — see the SDD report for the rendered
     measurements taken across the animation loop. A FIXED reservation,
     never a per-bubble one, is what actually fixes the defect that sank the
     previous attempt: the page must not move as the bubbles cycle. */
  .mcp-bubbles {
    position: relative;
    height: 5rem;
    margin-top: 0.9rem;
  }

  .bubble {
    position: absolute;
    inset: 0;
    opacity: 0%;
  }

  .bubble--1 {
    animation: phase-1 24s var(--ease-in-out) infinite;
  }

  .bubble--2 {
    animation: phase-2 24s var(--ease-in-out) infinite;
  }

  .bubble--3 {
    animation: phase-3 24s var(--ease-in-out) infinite;
  }

  .bubble--4 {
    animation: phase-4 24s var(--ease-in-out) infinite;
  }

  .bubble--5 {
    animation: phase-5 24s var(--ease-in-out) infinite;
