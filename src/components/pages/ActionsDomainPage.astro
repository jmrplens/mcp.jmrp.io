---
/**
 * Action-domain page body: `/servers/<id>/actions/<domain>/`.
 *
 * The full reference list of ONE manifest domain, one collapsed `<details>`
 * per action — collapsed is what kills the infinite scroll on the big
 * domains (`project` alone is 123 actions) without needing any JavaScript.
 * The filter island on top is progressive enhancement over this SSR list:
 * it reads the DOM the page emitted, never a second copy of the data (see
 * DomainActionsFilter's header for the match/order/open rules).
 *
 * Action ids, titles, domains and descriptions are protocol DATA, rendered
 * verbatim and never translated — the same rule the ficha applies to the
 * card's content. Single line breaks inside a description paragraph render
 * as explicit `<br />` because the post-build minifier collapses raw
 * newlines in text nodes (see ServerPage's `paragraphLines`).
 */
import type { GitlabActionEntry, GitlabActionParam } from "../../data/surface";
import type { Lang } from "../../i18n/ui";
import { serversPage } from "../../i18n/ui/servers-page";
import { serverPagePath } from "../../lib/seo";
import DomainActionsFilter from "../DomainActionsFilter";

interface Props {
  lang: Lang;
  serverId: string;
  domain: string;
  /** This domain's actions, in the snapshot's stable by-id order. */
  actions: GitlabActionEntry[];
  /** The token-scope caveat, shared verbatim with the ficha's catalog. */
  tokenNote: string;
  /**
   * Domain of each `alias_of` target present in `actions`, resolved by the
   * route from the full snapshot — the target may live in ANOTHER domain
   * (issue.list_group → group.issues), so the link cannot derive it here.
   */
  aliasDomains: Record<string, string>;
}

const { lang, serverId, domain, actions, tokenNote, aliasDomains } =
  Astro.props;
const sp = serversPage[lang];

const localePrefix = lang === "es" ? "/es/" : "/";
const fichaHref = `${localePrefix}${serverPagePath(serverId)}`;

const destructiveCount = actions.filter((a) => a.destructive).length;
const readOnlyCount = actions.filter((a) => a.read_only).length;

/** Same split rules as ServerPage: paragraphs on blank lines, `<br />` inside. */
function descriptionParagraphs(text: string): string[] {
  return text
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}
function paragraphLines(paragraph: string): string[] {
  return paragraph.split("\n").map((line) => line.trim());
}

/** `name (type)` — or the bare name for the mixed-type params 2.7.2 leaves untyped. */
function paramLabel(param: GitlabActionParam): string {
  return param.type ? `${param.name} (${param.type})` : param.name;
}

/** Base href of a SIBLING domain page, for cross-domain alias links. */
function domainHref(target: string): string {
  return `../${target}/`;
}
---

<div class="domain-page">
  <p class="eyebrow">{sp.domainPageKicker}</p>
  <h1 class="domain-title"><code>{domain}</code></h1>
  <p class="domain-intro">{sp.domainPageIntro}</p>
  {
    /* Data and LEGEND at once: each figure's dot is the same one the cards
      below carry — on mobile the chips with text did not fit and broke onto
      another line, so each action carries only its dot and the word lives here
      (and in sr-only inside each card: colour is never the only signal). */
  }
  <p class="domain-facts">
    <span class="fact"
      >{actions.length} · {sp.catalogColTotal.toLowerCase()}</span
    >
    <span class="fact fact--destructive">
      <span
        class="action-dot action-dot--destructive"
        aria-hidden="true"
      ></span>
      {destructiveCount} · {sp.catalogColDestructive.toLowerCase()}
    </span>
    <span class="fact fact--readonly">
      <span
        class="action-dot action-dot--readonly"
        aria-hidden="true"
      ></span>
      {readOnlyCount} · {sp.catalogColReadOnly.toLowerCase()}
    </span>
  </p>
  <p class="domain-note">{tokenNote}</p>
  <p class="domain-back"><a href={fichaHref}>{sp.domainBackToCard}</a></p>

  <DomainActionsFilter
    client:idle
    lang={lang}
    listId="actions-list"
    total={actions.length}
  />

  <ol
    class="actions-list"
    id="actions-list"
  >
    {
      actions.map((action) => (
        <li>
          <details
            class="action-item"
            id={action.id}
            data-action-id={action.id}
            data-action-title={action.title}
            data-destructive={String(action.destructive)}
            data-read-only={String(action.read_only)}
          >
            <summary class="action-summary">
              <code class="action-id">{action.id}</code>
              <span class="action-title">{action.title}</span>
              {action.alias_of && (
                <span class="action-alias">
                  {sp.domainAliasOf}{" "}
                  <a
                    href={`${
                      aliasDomains[action.alias_of] === domain
                        ? ""
                        : domainHref(aliasDomains[action.alias_of] ?? domain)
                    }#${action.alias_of}`}
                  >
                    <code>{action.alias_of}</code>
                  </a>
                </span>
              )}
              <span class="action-chips">
                {action.destructive && (
                  <span class="action-dot action-dot--destructive">
                    <span class="sr-only">{sp.domainChipDestructive}</span>
                  </span>
                )}
                {action.read_only && (
                  <span class="action-dot action-dot--readonly">
                    <span class="sr-only">{sp.domainChipReadOnly}</span>
                  </span>
                )}
              </span>
            </summary>
            <div class="action-body">
              <div class="action-desc">
                {descriptionParagraphs(action.description).map((paragraph) => (
                  <p>
                    {paragraphLines(paragraph).map((line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ))}
                  </p>
                ))}
              </div>
              <p class="action-params">
                <strong>{sp.domainParamsLabel}:</strong>{" "}
                {action.required_params?.length ? (
                  action.required_params.map((param, i) => (
                    <>
                      {i > 0 && ", "}
                      <code>{paramLabel(param)}</code>
                    </>
                  ))
                ) : (
                  <span>{sp.domainNoParams}</span>
                )}
              </p>
              {action.required_params_any_of &&
                action.required_params_any_of.length > 0 && (
                  <p class="action-params">
                    <strong>{sp.domainAnyOfLabel}:</strong>{" "}
                    {action.required_params_any_of.map((group, gi) => (
                      <>
                        {gi > 0 && ` ${sp.domainAnyOfJoiner} `}
                        {group.map((param, pi) => (
                          <>
                            {pi > 0 && " + "}
                            <code>{paramLabel(param)}</code>
                          </>
                        ))}
                      </>
                    ))}
                  </p>
                )}
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .domain-page {
    max-width: 52rem;
  }

  .domain-title {
    margin: 0.2rem 0 0.6rem;
  }

  .domain-title code {
    font-size: 1.6rem;
  }

  .domain-intro {
    margin: 0 0 0.6rem;
    color: var(--color-text-muted);
  }

  .domain-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* Each datum is its own inline-flex with a gap: without this the legend's
     dot ended up glued to the number ("●24") — the markup's whitespace does
     not survive the minifier. */
  .fact {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

  /* En estrecho, tres datos no caben en una línea y el wrap partía por
     cualquier sitio (captura del autor): columna limpia, un dato por línea. */
  @media (width <= 480px) {
    .domain-facts {
      flex-direction: column;
      gap: 0.3rem;
      align-items: flex-start;
    }
  }

  .fact--destructive {
    color: var(--color-danger);
  }

  .fact--readonly {
    color: var(--color-text-muted);
  }

  .domain-note {
    margin: 0 0 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .domain-back {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
  }

  /* Contenedor flex en columna A PROPÓSITO: la isla reordena con CSS
     `order` (coincidencias por descripción al final) sin mover el DOM. */
  .actions-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .action-item {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .action-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.7rem;
    align-items: baseline;
    padding: 0.55rem 0.8rem;
    cursor: pointer;
  }

  .action-summary:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .action-id {
    font-size: var(--text-sm);
  }

  .action-title {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .action-alias {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .action-chips {
    display: inline-flex;
    gap: 0.35rem;
    margin-left: auto;
  }

  /* Puntos en lugar de chips con texto: en móvil los chips partían el
     summary en dos líneas. La palabra vive en la leyenda de arriba y en el
     sr-only de cada punto — el color nunca es la única señal. */
  .action-dot {
    display: inline-block;
    flex: none;
    align-self: center;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .action-dot--destructive {
    background: var(--color-danger);
  }

  .action-dot--readonly {
    background: var(--color-text-muted);
  }

  .action-body {
    padding: 0.15rem 0.85rem 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .action-desc p {
    margin: 0.55rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .action-params {
    margin: 0.65rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
