---
/**
 * Inspector route. Delegates to the shared page component; the language comes
 * from the URL.
 */
import InspectorPage from "../components/pages/InspectorPage.astro";
import { ui } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import Base from "../layouts/Base.astro";

const t = ui[getLangFromUrl(Astro.url)];
---

<Base
  title={t.inspectorMetaTitle}
  description={t.inspectorIntro}
  page="inspector"
>
  <InspectorPage />
</Base>
