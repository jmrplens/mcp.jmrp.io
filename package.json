{
  "name": "mcp.jmrp.io",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/sync-server-surface.mjs && DIST_DIR=$(node scripts/deploy-swap.mjs prepare) && astro build --outDir \"$DIST_DIR\" && node scripts/deploy-swap.mjs swap \"$DIST_DIR\" && node scripts/deploy-live-mcp.mjs",
    "build:only": "node scripts/sync-server-surface.mjs && DIST_DIR=$(node scripts/deploy-swap.mjs prepare) && astro build --outDir \"$DIST_DIR\"",
    "preview": "astro preview",
    "lint": "astro sync && eslint .",
    "typecheck": "astro check",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "deploy": "pnpm build",
    "identity:sync": "node scripts/sync-identity.mjs",
    "identity:check": "node scripts/sync-identity.mjs --check",
    "validate:html": "html-validate dist",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test:unit && pnpm validate:html",
    "lint:css": "stylelint \"src/**/*.{astro,css}\"",
    "lint:html": "html-validate \"${DIST_DIR:-dist}\"",
    "spell": "cspell lint --dot --gitignore .",
    "verify": "node scripts/run-verify.mjs",
    "lint:md": "markdownlint-cli2"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@unocss/astro": "^66.10.5",
    "astro": "7.3.5",
    "preact": "^10.29.8",
    "sharp": "0.35.5",
    "unocss": "^66.10.5",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cspell/dict-es-es": "^3.0.8",
    "@gorazdo/eslint-plugin-preact": "^1.0.7",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.98",
    "@playwright/test": "^1.63.0",
    "@types/html-minifier-terser": "^7.0.2",
    "@unocss/eslint-plugin": "^66.10.5",
    "cheerio": "^1.2.0",
    "cspell": "^10.3.6",
    "domhandler": "^6.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^76.0.0",
    "glob": "^13.0.6",
    "html-minifier-terser": "^7.2.0",
    "html-validate": "^11.16.1",
    "lighthouse": "^13.5.0",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sonar-scanner": "^3.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
